/-
# An operator-chain (precedence-style) recognizer, and its group complexity

The recognizer scans an operator chain `term (op term)*`: it alternates between
"expecting a term" and "expecting an operator", and any violation of the
alternation sends it to an absorbing error state.

The alternation *looks* cyclic — reading `term op term op …` cycles the state —
and cyclic behaviour is exactly what a nontrivial Krohn-Rhodes group component
would look like. The finding here is that it is **not**: because a mis-ordered
symbol drops the automaton into the absorbing error state, the two-cycle is never
realized by a *single* state map, the transition monoid (6 elements) is
aperiodic, and the recognizer has group complexity `0`
(`precDFA_groupComplexityZero`, `precedence_dfaGroupCapacity_eq_one`).

Contrast with `RequestProject/Recognizers/Parity.lean`, where the same-looking
alternation *is* a genuine group: there the flip is realized by a single letter
and no error state absorbs it.
-/
import RequestProject.KrohnRhodes.Aperiodic

namespace Recognizers

open KrohnRhodes

/-- Input symbol classes seen by the operator-chain recognizer. -/
inductive PrecSym
  | term
  | op
  deriving DecidableEq, Fintype, Repr

/-- States: `0` expecting a term, `1` expecting an operator (a complete
expression has been read), `2` absorbing error. -/
abbrev PrecState := Fin 3

instance : DecidableEq (Function.End PrecState) :=
  inferInstanceAs (DecidableEq (PrecState → PrecState))

instance : Fintype (Function.End PrecState) :=
  inferInstanceAs (Fintype (PrecState → PrecState))

/-- Reading a term: legal only when a term was expected. -/
def precTerm : Function.End PrecState := ![1, 2, 2]

/-- Reading an operator: legal only after a complete term. -/
def precOp : Function.End PrecState := ![2, 0, 2]

/-- The operator-chain recognizer as a DFA; it accepts when a complete expression
has been read. -/
def precDFA : DFA PrecSym PrecState where
  step q a :=
    match a with
    | .term => precTerm q
    | .op => precOp q
  start := 0
  accept := {1}

@[simp] lemma precDFA_letterMap_term : letterMap precDFA .term = precTerm := rfl
@[simp] lemma precDFA_letterMap_op : letterMap precDFA .op = precOp := rfl

/-- Sanity check: `term op term` is a well-formed operator chain. -/
example : precDFA.eval [.term, .op, .term] = 1 := by decide

/-- Sanity check: two terms in a row are rejected, irrecoverably. -/
example : precDFA.eval [.term, .term, .op, .term] = 2 := by decide

/-! ## The transition monoid is aperiodic -/

/-- The six state maps generated by the recognizer's letters. -/
def precElems : Finset (Function.End PrecState) :=
  { ![0, 1, 2], ![0, 2, 2], ![1, 2, 2], ![2, 0, 2], ![2, 1, 2], ![2, 2, 2] }

set_option maxRecDepth 400000 in
lemma precElems_mul_closed :
    ∀ f ∈ precElems, ∀ g ∈ precElems, f * g ∈ precElems := by decide

set_option maxRecDepth 40000 in
lemma one_mem_precElems : (1 : Function.End PrecState) ∈ precElems := by decide

/-- The explicit 6-element submonoid of state maps containing the recognizer's
transition monoid. -/
def precSubmonoid : Submonoid (Function.End PrecState) where
  carrier := {f | f ∈ precElems}
  mul_mem' hf hg := precElems_mul_closed _ hf _ hg
  one_mem' := one_mem_precElems

set_option maxRecDepth 40000 in
lemma transitionMonoid_precDFA_le : transitionMonoid precDFA ≤ precSubmonoid := by
  refine Submonoid.closure_le.2 ?_
  rintro f ⟨a, rfl⟩
  cases a
  · show precTerm ∈ precElems
    decide
  · show precOp ∈ precElems
    decide

set_option maxRecDepth 400000 in
lemma precElems_aperiodic : ∀ f ∈ precElems, f ^ 4 = f ^ 3 := by decide

/-- **The operator-chain recognizer has Krohn-Rhodes group complexity 0**: the
apparent term/operator cycle is not a group. -/
theorem precDFA_groupComplexityZero : GroupComplexityZero precDFA := by
  intro f hf
  exact ⟨3, precElems_aperiodic f (transitionMonoid_precDFA_le hf)⟩

/-- Consequently its group capacity is `1`. -/
theorem precedence_dfaGroupCapacity_eq_one : dfaGroupCapacity precDFA = 1 :=
  dfaGroupCapacity_eq_one_of_groupComplexityZero precDFA_groupComplexityZero

/-- Every group dividing the recognizer's transition monoid is trivial. -/
theorem precedence_no_nontrivial_group_divisor {G : Type*} [Group G]
    (hG : GroupDivides (transitionMonoid precDFA) G) : Nat.card G = 1 :=
  card_eq_one_of_isAperiodic_of_groupDivides precDFA_groupComplexityZero hG

/-- Again the certificate is exact: group complexity `0` for this recognizer is
equivalent to the absence of nontrivial cyclic divisors. -/
theorem precedence_groupComplexityZero_iff :
    GroupComplexityZero precDFA ↔
      ∀ p : ℕ, 2 ≤ p → ¬ GroupDivides (transitionMonoid precDFA) (Multiplicative (ZMod p)) :=
  groupComplexityZero_iff_no_cyclic_divisor precDFA

end Recognizers
