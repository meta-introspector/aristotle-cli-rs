/-
# A tight lexer, and its Krohn-Rhodes group complexity

A small but realistic tokenizer DFA: it scans a stream of `letter`, `digit`,
`space` symbols, tracking whether it is between tokens, inside an identifier, or
inside a numeric literal, and rejecting (absorbing error state) a digit-started
literal immediately followed by a letter (`12abc`) — the classic "tight lexer"
rule that forbids an identifier gluing itself onto a number.

The result proved here: the transition monoid of this lexer is **aperiodic**,
i.e. the lexer has **Krohn-Rhodes group complexity 0**. Concretely
(`lexer_dfaGroupCapacity_eq_one`) the only group of state permutations realized
by any word is the trivial one: there is no reachable counting, cycling or
permuting behaviour whatsoever for an attacker to chain into a weird machine.

The proof is a finite computation: the transition monoid is contained in an
explicitly listed 12-element submonoid of `Function.End (Fin 4)`, and each of
those twelve state maps satisfies `f ^ 5 = f ^ 4`.
-/
import RequestProject.KrohnRhodes.Aperiodic

namespace Recognizers

open KrohnRhodes

/-! ## The lexer -/

/-- Input symbol classes seen by the lexer. -/
inductive LexSym
  | letter
  | digit
  | space
  deriving DecidableEq, Fintype, Repr

/-- Lexer states: `0` between tokens, `1` inside an identifier, `2` inside a
numeric literal, `3` the absorbing error state. -/
abbrev LexState := Fin 4

instance : DecidableEq (Function.End LexState) :=
  inferInstanceAs (DecidableEq (LexState → LexState))

instance : Fintype (Function.End LexState) :=
  inferInstanceAs (Fintype (LexState → LexState))

/-- One-letter state maps of the lexer. -/
def lexLetter : Function.End LexState := ![1, 1, 3, 3]

/-- Reading a digit: start a literal, stay in an identifier, stay in a literal. -/
def lexDigit : Function.End LexState := ![2, 1, 2, 3]

/-- Reading a space: end the current token. -/
def lexSpace : Function.End LexState := ![0, 0, 0, 3]

/-- The tight lexer as a DFA. Accepting states are all non-error states. -/
def lexDFA : DFA LexSym LexState where
  step q a :=
    match a with
    | .letter => lexLetter q
    | .digit => lexDigit q
    | .space => lexSpace q
  start := 0
  accept := {q | q ≠ 3}

@[simp] lemma lexDFA_letterMap_letter : letterMap lexDFA .letter = lexLetter := rfl
@[simp] lemma lexDFA_letterMap_digit : letterMap lexDFA .digit = lexDigit := rfl
@[simp] lemma lexDFA_letterMap_space : letterMap lexDFA .space = lexSpace := rfl

/-- The error state is absorbing: once the lexer rejects, nothing recovers it. -/
lemma lexDFA_error_absorbing (a : LexSym) : lexDFA.step 3 a = 3 := by
  cases a <;> rfl

/-- Sanity check: `identifier space digit letter` drives the lexer into the error
state (a digit-started literal glued to a letter is rejected). -/
example : lexDFA.eval [.letter, .space, .digit, .letter] = 3 := by decide

/-- Sanity check: `identifier digit space digit` is fine (digits inside an
identifier are allowed). -/
example : lexDFA.eval [.letter, .digit, .space, .digit] = 2 := by decide

/-! ## The transition monoid is aperiodic -/

/-- The twelve state maps generated by the lexer's letters. -/
def lexElems : Finset (Function.End LexState) :=
  { ![0, 1, 2, 3], ![0, 0, 0, 3], ![0, 0, 3, 3], ![1, 1, 1, 3], ![1, 1, 3, 3],
    ![2, 1, 2, 3], ![2, 2, 2, 3], ![2, 2, 3, 3], ![3, 0, 3, 3], ![3, 1, 3, 3],
    ![3, 2, 3, 3], ![3, 3, 3, 3] }

set_option maxRecDepth 4000000 in
lemma lexElems_mul_closed :
    ∀ f ∈ lexElems, ∀ g ∈ lexElems, f * g ∈ lexElems := by decide

set_option maxRecDepth 400000 in
lemma one_mem_lexElems : (1 : Function.End LexState) ∈ lexElems := by decide

/-- The explicit 12-element submonoid of state maps containing the lexer's
transition monoid. -/
def lexSubmonoid : Submonoid (Function.End LexState) where
  carrier := {f | f ∈ lexElems}
  mul_mem' hf hg := lexElems_mul_closed _ hf _ hg
  one_mem' := one_mem_lexElems

set_option maxRecDepth 400000 in
lemma transitionMonoid_lexDFA_le : transitionMonoid lexDFA ≤ lexSubmonoid := by
  refine Submonoid.closure_le.2 ?_
  rintro f ⟨a, rfl⟩
  cases a
  · show lexLetter ∈ lexElems
    decide
  · show lexDigit ∈ lexElems
    decide
  · show lexSpace ∈ lexElems
    decide

set_option maxRecDepth 4000000 in
lemma lexElems_aperiodic : ∀ f ∈ lexElems, f ^ 5 = f ^ 4 := by decide

/-- **The lexer has Krohn-Rhodes group complexity 0**: its transition monoid is
aperiodic. -/
theorem lexDFA_groupComplexityZero : GroupComplexityZero lexDFA := by
  intro f hf
  exact ⟨4, lexElems_aperiodic f (transitionMonoid_lexDFA_le hf)⟩

/-- Consequently the lexer's group capacity is `1`: no nontrivial group of state
permutations is realized, so no node of the complexity lattice above the trivial
group is forced by (or even available to) this recognizer. -/
theorem lexer_dfaGroupCapacity_eq_one : dfaGroupCapacity lexDFA = 1 :=
  dfaGroupCapacity_eq_one_of_groupComplexityZero lexDFA_groupComplexityZero

/-- The strongest form of the "no weird machines" statement for this lexer:
*every* group dividing its transition monoid — not merely every group of state
permutations — is trivial. -/
theorem lexer_no_nontrivial_group_divisor {G : Type*} [Group G]
    (hG : GroupDivides (transitionMonoid lexDFA) G) : Nat.card G = 1 :=
  card_eq_one_of_isAperiodic_of_groupDivides lexDFA_groupComplexityZero hG

/-- The certificate is exact, not merely sufficient: by
`KrohnRhodes.groupComplexityZero_iff_no_cyclic_divisor`, the lexer's group
complexity `0` is *equivalent* to the absence of nontrivial cyclic divisors in
its transition monoid. -/
theorem lexer_groupComplexityZero_iff :
    GroupComplexityZero lexDFA ↔
      ∀ p : ℕ, 2 ≤ p → ¬ GroupDivides (transitionMonoid lexDFA) (Multiplicative (ZMod p)) :=
  groupComplexityZero_iff_no_cyclic_divisor lexDFA

end Recognizers
