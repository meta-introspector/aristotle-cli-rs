/-
# Transition monoids, aperiodicity, and group divisors

This file develops the algebraic machinery needed to state and prove
"group complexity" facts about concrete finite-state recognizers.

## What is formalized here, and what is cited

The Krohn-Rhodes decomposition theorem itself (every finite semigroup divides a
wreath product of simple groups dividing it and copies of the flip-flop monoid
`U₂`) is **not** formalized: it is a classical, external result
(Krohn-Rhodes 1965; see Eilenberg, *Automata, Languages, and Machines* Vol. B).
It is used only as *interpretation* of the definitions below, never as an
assumption inside a proof.

What is formalized is the part that carries the actual content of a
"no weird machines, by group complexity" claim:

* `KrohnRhodes.transitionMonoid` — the transition monoid of a DFA, i.e. the
  submonoid of `Function.End Q` generated by the one-letter state maps.
  (Its quotient by the syntactic congruence is the syntactic monoid of the
  recognized language; every group dividing the syntactic monoid divides the
  transition monoid, so the transition monoid is the conservative object to
  bound.)
* `KrohnRhodes.IsAperiodic` — aperiodicity (`f ^ (n+1) = f ^ n`), which by the
  classical theory is *equivalent* to Krohn-Rhodes group complexity `0`: the
  decomposition uses flip-flops only, no group levels.
* `KrohnRhodes.GroupDivides` — `G` divides the monoid: an injective
  multiplicative map `G → Function.End Q` landing inside the monoid. Note this
  is a `MulHom`, not a `MonoidHom`, so the identity of `G` is *not* required to
  be sent to the identity map; this is the semigroup-theoretic notion, and it
  covers subgroups of the monoid whose identity is a non-trivial idempotent.
* `KrohnRhodes.subsingleton_of_isAperiodic_of_groupDivides` — the theorem that
  makes the bridge work: an aperiodic transition monoid has **no** nontrivial
  group divisors at all. This is the honest, provable core of the informal
  claim "nothing in the recognizer can count, cycle, or permute".
-/
import Mathlib

namespace KrohnRhodes

open Function

variable {A Q : Type*}

/-! ## Words, letters, and the transition monoid -/

/-- The action of the single letter `a` on states, as an element of the monoid
`Function.End Q` of all state maps. -/
def letterMap (D : DFA A Q) (a : A) : Function.End Q := fun q => D.step q a

/-- The action of a whole word `w` on states. -/
def wordMap (D : DFA A Q) (w : List A) : Function.End Q := fun q => D.evalFrom q w

@[simp] lemma wordMap_nil (D : DFA A Q) : wordMap D [] = 1 := rfl

lemma wordMap_cons (D : DFA A Q) (a : A) (w : List A) :
    wordMap D (a :: w) = wordMap D w * letterMap D a := rfl

/-- The **transition monoid** of a DFA: the submonoid of `Function.End Q`
generated by the one-letter state maps. -/
def transitionMonoid (D : DFA A Q) : Submonoid (Function.End Q) :=
  Submonoid.closure (Set.range (letterMap D))

lemma letterMap_mem (D : DFA A Q) (a : A) : letterMap D a ∈ transitionMonoid D :=
  Submonoid.subset_closure ⟨a, rfl⟩

lemma wordMap_mem (D : DFA A Q) (w : List A) : wordMap D w ∈ transitionMonoid D := by
  induction w with
  | nil => simp [(transitionMonoid D).one_mem]
  | cons a w ih =>
      rw [wordMap_cons]
      exact (transitionMonoid D).mul_mem ih (letterMap_mem D a)

/-- Every element of the transition monoid is the action of some word. -/
lemma exists_word_of_mem (D : DFA A Q) {f : Function.End Q} (hf : f ∈ transitionMonoid D) :
    ∃ w : List A, wordMap D w = f := by
  induction hf using Submonoid.closure_induction with
  | mem f hf => obtain ⟨a, rfl⟩ := hf; exact ⟨[a], rfl⟩
  | one => exact ⟨[], rfl⟩
  | mul f g _ _ hf hg =>
      obtain ⟨wf, rfl⟩ := hf
      obtain ⟨wg, rfl⟩ := hg
      refine ⟨wg ++ wf, ?_⟩
      funext q
      simp only [wordMap, DFA.evalFrom, List.foldl_append]
      rfl

/-! ## Aperiodicity = Krohn-Rhodes group complexity 0 -/

/-- A submonoid of state maps is **aperiodic** (combinatorial, group-free) if every
element eventually stabilizes under taking powers.

By the classical Krohn-Rhodes theory, for a finite monoid this is exactly the
condition "Krohn-Rhodes group complexity `0`": the monoid divides an iterated
wreath product of flip-flops `U₂`, with no group levels. -/
def IsAperiodic (M : Submonoid (Function.End Q)) : Prop :=
  ∀ f ∈ M, ∃ n : ℕ, f ^ (n + 1) = f ^ n

/-- A recognizer has **group complexity 0** when its transition monoid is aperiodic.
(The name records the classical equivalence "aperiodic ↔ complexity 0"; the
equivalence itself is cited, not formalized — only aperiodicity is used below.) -/
def GroupComplexityZero (D : DFA A Q) : Prop := IsAperiodic (transitionMonoid D)

/-- `G` **divides** the monoid `M` of state maps: there is an injective
multiplicative map `G → Function.End Q` whose image lies in `M`.

Using a `MulHom` rather than a `MonoidHom` is deliberate: a group sitting inside
a finite monoid need not share the monoid's identity, and this more general
notion is the semigroup-theoretic one used by Krohn-Rhodes theory. -/
def GroupDivides (M : Submonoid (Function.End Q)) (G : Type*) [Group G] : Prop :=
  ∃ φ : G →ₙ* Function.End Q, Injective φ ∧ ∀ g, φ g ∈ M

lemma map_pow_succ {G H : Type*} [Group G] [Monoid H] (φ : G →ₙ* H) (g : G) (k : ℕ) :
    φ (g ^ (k + 1)) = φ g ^ (k + 1) := by
  induction k with
  | zero => simp
  | succ k ih =>
      have hg : g ^ (k + 1 + 1) = g ^ (k + 1) * g := pow_succ g (k + 1)
      rw [hg, map_mul, ih, ← pow_succ]

/-- In a group, `g ^ (n+1) = g ^ n` forces `g = 1`. -/
lemma eq_one_of_pow_succ_eq {G : Type*} [Group G] {g : G} {n : ℕ} (h : g ^ (n + 1) = g ^ n) :
    g = 1 := by
  have h' : g ^ n * g = g ^ n * 1 := by rw [mul_one, ← pow_succ]; exact h
  exact mul_left_cancel h'

/-- **The key structural theorem.** An aperiodic monoid of state maps has no
nontrivial group divisors: any group dividing it is trivial.

This is the defensible content of "a group-complexity-0 recognizer contains no
hidden permutation/counting structure". -/
theorem subsingleton_of_isAperiodic_of_groupDivides {M : Submonoid (Function.End Q)}
    (hM : IsAperiodic M) {G : Type*} [Group G] (hG : GroupDivides M G) : Subsingleton G := by
  obtain ⟨φ, hinj, hmem⟩ := hG
  constructor
  intro g h
  suffices hone : ∀ x : G, x = 1 by rw [hone g, hone h]
  intro x
  obtain ⟨n, hn⟩ := hM (φ x) (hmem x)
  -- push the exponents up by one so that both are positive
  have hn' : φ x ^ (n + 2) = φ x ^ (n + 1) := by
    calc φ x ^ (n + 2) = φ x ^ (n + 1) * φ x := pow_succ (φ x) (n + 1)
    _ = φ x ^ n * φ x := by rw [hn]
    _ = φ x ^ (n + 1) := by rw [← pow_succ]
  have hx : φ (x ^ (n + 2)) = φ (x ^ (n + 1)) := by
    rw [map_pow_succ φ x (n + 1), map_pow_succ φ x n]
    exact hn'
  exact eq_one_of_pow_succ_eq (hinj hx)

theorem card_eq_one_of_isAperiodic_of_groupDivides {M : Submonoid (Function.End Q)}
    (hM : IsAperiodic M) {G : Type*} [Group G] (hG : GroupDivides M G) : Nat.card G = 1 := by
  have h := subsingleton_of_isAperiodic_of_groupDivides hM hG
  exact Nat.card_eq_one_iff_unique.2 ⟨h, ⟨1⟩⟩

/-! ## Permutation subgroups of a transition monoid, and a numeric capacity -/

/-- The monoid map sending a permutation of the states to the corresponding state map. -/
def permEnd : Equiv.Perm Q →* Function.End Q :=
  (Units.coeHom (Function.End Q)).comp (Equiv.Perm.equivUnitsEnd : Equiv.Perm Q ≃* _).toMonoidHom

@[simp] lemma permEnd_apply (g : Equiv.Perm Q) (q : Q) : permEnd g q = g q := rfl

lemma permEnd_injective : Injective (permEnd (Q := Q)) := by
  intro g h hgh
  ext q
  exact congrFun (congrArg (fun f : Function.End Q => (f : Q → Q)) hgh) q

/-- `H` is a group of permutations of the states that is realized inside the
transition monoid of `D`. -/
def PermSubgroupIn (D : DFA A Q) (H : Subgroup (Equiv.Perm Q)) : Prop :=
  ∀ h ∈ H, permEnd h ∈ transitionMonoid D

lemma groupDivides_of_permSubgroupIn {D : DFA A Q} {H : Subgroup (Equiv.Perm Q)}
    (hH : PermSubgroupIn D H) : GroupDivides (transitionMonoid D) H := by
  refine ⟨(permEnd.comp H.subtype).toMulHom, ?_, ?_⟩
  · intro x y hxy
    exact Subtype.ext (permEnd_injective hxy)
  · intro g
    exact hH g g.2

/-- The set of orders of permutation groups realized inside the transition monoid. -/
def capacitySet (D : DFA A Q) : Set ℕ :=
  {n | ∃ H : Subgroup (Equiv.Perm Q), PermSubgroupIn D H ∧ Nat.card H = n}

lemma one_mem_capacitySet (D : DFA A Q) : 1 ∈ capacitySet D := by
  refine ⟨⊥, ?_, ?_⟩
  · intro h hh
    rw [Subgroup.mem_bot.1 hh, map_one]
    exact (transitionMonoid D).one_mem
  · simp

lemma capacitySet_nonempty (D : DFA A Q) : (capacitySet D).Nonempty :=
  ⟨1, one_mem_capacitySet D⟩

lemma capacitySet_bddAbove [Finite Q] [DecidableEq Q] (D : DFA A Q) :
    BddAbove (capacitySet D) := by
  refine ⟨Nat.card (Equiv.Perm Q), ?_⟩
  rintro n ⟨H, -, rfl⟩
  exact Nat.card_le_card_of_injective _ Subtype.val_injective

/-- The **group capacity** of a recognizer: the largest order of a group of state
permutations realized inside its transition monoid.

This is a lower bound for (and, for the examples in this project, an exact
witness of) the group structure a Krohn-Rhodes decomposition of the recognizer
is forced to contain. -/
noncomputable def dfaGroupCapacity (D : DFA A Q) : ℕ := sSup (capacitySet D)

lemma le_dfaGroupCapacity [Finite Q] [DecidableEq Q] {D : DFA A Q} {H : Subgroup (Equiv.Perm Q)}
    (hH : PermSubgroupIn D H) : Nat.card H ≤ dfaGroupCapacity D :=
  le_csSup (capacitySet_bddAbove D) ⟨H, hH, rfl⟩

lemma one_le_dfaGroupCapacity [Finite Q] [DecidableEq Q] (D : DFA A Q) :
    1 ≤ dfaGroupCapacity D :=
  le_csSup (capacitySet_bddAbove D) (one_mem_capacitySet D)

lemma dfaGroupCapacity_le {D : DFA A Q} {b : ℕ} (hb : ∀ n ∈ capacitySet D, n ≤ b) :
    dfaGroupCapacity D ≤ b :=
  csSup_le (capacitySet_nonempty D) hb

/-- A group-complexity-0 recognizer has group capacity exactly `1`: the only group
of state permutations it realizes is the trivial one. -/
theorem dfaGroupCapacity_eq_one_of_groupComplexityZero [Finite Q] [DecidableEq Q] {D : DFA A Q}
    (hD : GroupComplexityZero D) : dfaGroupCapacity D = 1 := by
  refine le_antisymm (dfaGroupCapacity_le ?_) (one_le_dfaGroupCapacity D)
  rintro n ⟨H, hH, rfl⟩
  exact le_of_eq
    (card_eq_one_of_isAperiodic_of_groupDivides hD (groupDivides_of_permSubgroupIn hH))

/-- Contrapositive form: a recognizer realizing a nontrivial group of state
permutations cannot have group complexity `0`. -/
theorem not_groupComplexityZero_of_nontrivial_permSubgroup [Finite Q] [DecidableEq Q]
    {D : DFA A Q} {H : Subgroup (Equiv.Perm Q)} (hH : PermSubgroupIn D H)
    (hcard : 2 ≤ Nat.card H) : ¬ GroupComplexityZero D := by
  intro hD
  have h1 := card_eq_one_of_isAperiodic_of_groupDivides hD (groupDivides_of_permSubgroupIn hH)
  omega

end KrohnRhodes
