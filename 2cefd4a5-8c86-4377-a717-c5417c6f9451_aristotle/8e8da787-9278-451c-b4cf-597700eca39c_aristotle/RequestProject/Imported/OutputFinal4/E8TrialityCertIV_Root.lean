abbrev Mat := List (List Int)
/-- `List.get!` was removed from this Lean core; reintroduce it locally. -/
def List.get! {α : Type _} [Inhabited α] (l : List α) (n : Nat) : α := l.getD n default
def dot (a b : List Int) : Int := (List.zipWith (fun x y => x*y) a b).foldl (fun s x => s+x) 0
def col (A : Mat) (j : Nat) : List Int := A.map (fun r => r.get! j)
def tr (A : Mat) : Mat := (List.range ((A.get! 0).length)).map (col A)
def mul (A B : Mat) : Mat := let Bt := tr B; A.map (fun r => Bt.map (fun c => dot r c))
def idm (n : Nat) : Mat := (List.range n).map (fun i => (List.range n).map (fun j => if i = j then (1:Int) else 0))
def smul (c : Int) (A : Mat) : Mat := A.map (fun r => r.map (fun x => c*x))
def rowMul (r : List Int) (A : Mat) : List Int := (tr A).map (fun c => dot r c)
def addRow (a b : List Int) : List Int := List.zipWith (fun x y => x+y) a b

def redRow (piv row : List Nat) (j : Nat) : List Nat :=
  let inv := if piv.get! j % 3 == 2 then 2 else 1
  let c := (row.get! j * inv) % 3
  List.zipWith (fun a b => (a + 9 - (c * b) % 3) % 3) row piv
def rank3 (rows0 : List (List Nat)) : Nat :=
  (((List.range 16).foldl (fun (st : List (List Nat) × Nat) j =>
      match st.1.find? (fun row => row.get! j % 3 != 0) with
      | none => st
      | some piv =>
        ((st.1.filter (fun r => r != piv)).map (fun r =>
          if r.get! j % 3 == 0 then r else redRow piv r j), st.2+1)) (rows0, 0))).2
def m3 (r : List Int) : List Nat := r.map (fun x => (x % 3 + 3).toNat % 3)
