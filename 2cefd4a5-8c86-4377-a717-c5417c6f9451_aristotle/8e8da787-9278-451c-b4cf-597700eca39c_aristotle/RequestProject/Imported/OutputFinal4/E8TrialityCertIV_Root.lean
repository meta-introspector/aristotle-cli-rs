def sweep : Bool :=
  let hex := Hex
  let hexx := Hex.map (fun h => rowMul h XQ)
  let hexg := Hex.map (fun h => rowMul h GQm)
  let hexxg := hexx.map (fun h => rowMul h GQm)
  let cmp := fun (i j : Nat) =>
    (dot (hexg.get! i) (hex.get! j)) % 2 == 0 &&
    (dot (hexg.get! i) (hexx.get! j)) % 2 == 0 &&
    (dot (hexxg.get! i) (hexx.get! j)) % 2 == 0
  let ms := (List.range 120).map (fun i => (List.range 120).foldl
      (fun m j => if i != j && cmp i j then m ||| (1 <<< j) else m) 0)
  let h3 := hex.map m3
  let hx3 := hexx.map m3
  let sp := fun (i j k l : Nat) => rank3
    [h3.get! i, hx3.get! i, h3.get! j, hx3.get! j,
     h3.get! k, hx3.get! k, h3.get! l, hx3.get! l]
  (List.range 120).all (fun i =>
    (List.range 120).all (fun j =>
      !(Nat.blt i j) || !((ms.get! i).testBit j) ||
      (List.range 120).all (fun k =>
        !(Nat.blt j k) || !((ms.get! i).testBit k) || !((ms.get! j).testBit k) ||
        (List.range 120).all (fun l =>
          !(Nat.blt k l) || !((ms.get! i).testBit l) || !((ms.get! j).testBit l) ||
          !((ms.get! k).testBit l) || sp i j k l == 8))))

/-! ## the omega-structure of Q and the hexagons -/
theorem XQ_order3 : mul (mul XQ XQ) XQ = idm 16 := by native_decide
theorem XQ_fpf :
    (List.zipWith addRow (mul XQ XQ) (List.zipWith addRow XQ (idm 16))).all
      (fun r => r.all (fun x => x == 0)) = true := by native_decide
theorem hexagons_norm4 :
    (Hex.all (fun h => dot (rowMul h GQm) h == 4)) = true := by native_decide
theorem hexagons_trace_zero :
    (Hex.all (fun h => (addRow h (addRow (rowMul h XQ) (rowMul (rowMul h XQ) XQ))).all
      (fun x => x == 0))) = true := by native_decide

/-! ## MAIN SWEEP: every compatible 4-clique has full span rank mod 3 -/
theorem no_index9_saturation : sweep = true := by native_decide

/-! ## Weyl side: each A2^k class fixes a root -/
theorem A1_isometry : mul (mul A1 GE8v) (tr A1) = GE8v := by native_decide
theorem A1_order3 : mul (mul A1 A1) A1 = idm 8 ∧ A1 ≠ idm 8 := by native_decide
theorem A1_fixed_space : mul F1 A1 = F1 := by native_decide
theorem A1_rank_certificate :
    mul Sc1 Tc1 = smul dS1 (idm 8) ∧ dS1 ≠ 0 ∧
    Sc1 = F1 ++ mul Wc1 (List.zipWith (fun r s => List.zipWith (fun x y => x - y) r s) A1 (idm 8)) := by native_decide
theorem A1_root_in_fix :
    rowMul root1 A1 = root1 ∧ dot (rowMul root1 GE8v) root1 = 2 := by native_decide
