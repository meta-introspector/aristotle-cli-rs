/-! ## Section H: the ternary glue Lambda/(Q+R) ≅ F3^8 -/
theorem ternary_relations_dim : rank3 Wgens 24 = 8 := by native_decide
theorem ternary_glue_dim : rank3 (Wgens ++ ternGens) 24 = 16 := by native_decide
theorem ternary_glue_is_graph : rank3 Rparts 8 = 8 := by native_decide
theorem sigma_trivial_on_ternary_glue :
    rank3 (Wgens ++ sigmaDiffs) 24 = 8 := by native_decide

/-! ## Section I: Smith certificate for [Leech : (sqrt2 E8)^3] = 2^12 -/
theorem smith_transforms_unimodular :
    mul Us Usi = idm 24 ∧ mul Usi Us = idm 24 ∧
    mul VsM Vsi = idm 24 ∧ mul Vsi VsM = idm 24 := by native_decide
theorem turyn_index_smith :
    isDiagWith (mul (mul Us Xs) VsM) Dsdiag = true := by native_decide
theorem turyn_elementary_divisors :
    (Dsdiag.filter (fun d => d == 2)).length = 12 ∧
    (Dsdiag.filter (fun d => d == 1)).length = 12 := by native_decide

/-! ## Section J: the distinguished solid = an intermediate E8 -/
theorem NH_even : evenDiag GN = true := by native_decide
theorem NH_unimodular : mul GN GNi = idm 8 ∧ mul GNi GN = idm 8 := by native_decide
theorem sqrt2E8_inside_NH : mul (mul Cmap GN) (tr Cmap) = GM1 := by native_decide
theorem solid_index_transforms :
    mul Uc Uci = idm 8 ∧ mul Uci Uc = idm 8 ∧
    mul Vc Vci = idm 8 ∧ mul Vci Vc = idm 8 := by native_decide
theorem solid_index_sixteen :
    isDiagWith (mul (mul Uc Cmap) Vc) Dcdiag = true ∧
    (Dcdiag.filter (fun d => d == 2)).length = 4 := by native_decide
