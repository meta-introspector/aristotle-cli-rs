/-
  E8TrialityCertII.lean — extensions: (H) the ternary 3^8 glue of
  Lambda/(Q + R) with the sigma-triviality theorem, (I) a Smith-form
  certificate that [Leech : (sqrt2 E8)^3] has elementary divisors 1^12 2^12,
  (J) the intermediate-E8 certificate for the distinguished solid of the
  binary glue: sqrt2E8 = C * N_H with N_H even unimodular and index 16.
  Pure Lean 4 core; all proofs by native_decide; unimodularity via
  explicit integer inverses. Companion to E8TrialityCert.lean.
-/
abbrev Mat := List (List Int)
/-- `List.get!` was removed from this Lean core; reintroduce it locally. -/
def List.get! {α : Type _} [Inhabited α] (l : List α) (n : Nat) : α := l.getD n default
def dot (a b : List Int) : Int := (List.zipWith (fun x y => x*y) a b).foldl (fun s x => s+x) 0
def col (A : Mat) (j : Nat) : List Int := A.map (fun r => r.get! j)
def tr (A : Mat) : Mat := (List.range ((A.get! 0).length)).map (col A)
def mul (A B : Mat) : Mat := let Bt := tr B; A.map (fun r => Bt.map (fun c => dot r c))
def idm (n : Nat) : Mat := (List.range n).map (fun i => (List.range n).map (fun j => if i = j then (1:Int) else 0))
def evenDiag (A : Mat) : Bool := (List.range A.length).all (fun i => ((A.get! i).get! i) % 2 == 0)
def isDiagWith (A : Mat) (d : List Int) : Bool :=
  (List.range A.length).all (fun i => (List.range ((A.get! 0).length)).all (fun j =>
    (A.get! i).get! j == (if i = j then d.get! i else 0)))

/-! mod-3 linear algebra -/
def redRow (piv row : List Nat) (j : Nat) : List Nat :=
  let inv := if piv.get! j % 3 == 2 then 2 else 1
  let c := (row.get! j * inv) % 3
  List.zipWith (fun a b => (a + 3*3 - (c * b) % 3) % 3) row piv
def rank3 (rows0 : List (List Nat)) (ncols : Nat) : Nat :=
  (((List.range ncols).foldl (fun (st : List (List Nat) × Nat) j =>
      match st.1.find? (fun row => row.get! j % 3 != 0) with
      | none => st
      | some piv =>
        ((st.1.filter (fun r => r != piv)).map (fun r =>
          if r.get! j % 3 == 0 then r else redRow piv r j), st.2+1)) (rows0, 0))).2
