def unionOf (s : Nat) : Nat :=
  (List.range 8).foldl (fun a i => if s.testBit i then a ||| (orbMasks.get! i) else a) 0
def sweepAux : Nat → Bool → Bool
  | 0,   acc => acc
  | n+1, acc => sweepAux n (acc && (if pc n == 8 then permMask sigmaP n != n else true))
def noInvariantEightSet : Bool := sweepAux (1 <<< 24) true

/-! ## Section N : the obstruction, 3 does not divide 8 -/
theorem sigma_order3 : cube sigmaP = List.range 24 := by native_decide
theorem sigma_fixed_point_free : ((List.range 24).all (fun i => sigmaP.get! i != i)) = true := by native_decide
theorem sigma_orbits_have_size_three :
    ((List.range 8).all (fun i => pc (orbMasks.get! i) == 3)) = true := by native_decide
theorem sigma_orbits_partition :
    ((List.range 8).foldl (fun a i => a ||| orbMasks.get! i) 0) = (1 <<< 24) - 1 := by native_decide
theorem orbit_unions_never_eight :
    ((List.range 256).all (fun s => pc (unionOf s) != 8)) = true := by native_decide
theorem no_sigma_invariant_octad :
    (golayOctads.all (fun m => permMask sigmaP m != m)) = true := by native_decide
theorem sigma_invariant_octad_count :
    (golayOctads.filter (fun m => permMask sigmaP m == m)).length = 0 := by native_decide
theorem no_sigma_invariant_eight_set : noInvariantEightSet = true := by native_decide

/-! ## Section O : order 4 has no such obstruction (orbit sizes 1,2,4 all divide 8) -/
theorem golay_octads_count : golayOctads.length = 759 ∧ (golayOctads.all (fun m => pc m == 8)) = true := by native_decide
theorem p4A_order_four : quad p4A = List.range 24 ∧ sq p4A ≠ List.range 24 := by native_decide
theorem p4A_fixes_an_octad :
    permMask p4A oct4A = oct4A ∧ golayOctads.contains oct4A = true ∧ pc oct4A = 8 := by native_decide
theorem p4A_invariant_octad_count :
    (golayOctads.filter (fun m => permMask p4A m == m)).length = 11 := by native_decide
theorem p4B_order_four : quad p4B = List.range 24 ∧ sq p4B ≠ List.range 24 := by native_decide
theorem p4B_fixes_an_octad :
    permMask p4B oct4B = oct4B ∧ golayOctads.contains oct4B = true ∧ pc oct4B = 8 := by native_decide
theorem p4B_invariant_octad_count :
    (golayOctads.filter (fun m => permMask p4B m == m)).length = 7 := by native_decide
theorem p4C_order_four : quad p4C = List.range 24 ∧ sq p4C ≠ List.range 24 := by native_decide
theorem p4C_fixes_an_octad :
    permMask p4C oct4C = oct4C ∧ golayOctads.contains oct4C = true ∧ pc oct4C = 8 := by native_decide
theorem p4C_invariant_octad_count :
    (golayOctads.filter (fun m => permMask p4C m == m)).length = 3 := by native_decide

/-! ## Section P : the lattice witness for the 4^6 class -/
theorem g_isometry : mul (mul gmat G24) (tr gmat) = G24 := by native_decide
theorem g_order_four : mul (mul gmat gmat) (mul gmat gmat) = idm 24 ∧ mul gmat gmat ≠ idm 24 := by native_decide
theorem g_has_nontrivial_fixed_lattice :
    rowMul fixv gmat = fixv ∧ fixv ≠ (List.range 24).map (fun _ => (0:Int)) := by native_decide
theorem MO_is_sqrt2E8 :
    mul (mul Cblk G24) (tr Cblk) = smul 2 Gm2 ∧ evenDiag Gm2 = true ∧
    mul Gm2 Gm2i = idm 8 ∧ mul Gm2i Gm2 = idm 8 := by native_decide
theorem g_preserves_MO :
    mul Cblk gmat = mul Xg Cblk ∧ mul Xg Xgi = idm 8 ∧ mul Xgi Xg = idm 8 := by native_decide
theorem eps_is_EE8_involution :
    mul eps eps = idm 24 ∧ trace eps = 8 ∧ mul (mul eps G24) (tr eps) = G24 ∧
    mul Cblk eps = negm Cblk := by native_decide
theorem eps_commutes_with_g : mul eps gmat = mul gmat eps := by native_decide
theorem G24_even_unimodular :
    evenDiag G24 = true ∧ mul G24 G24i = idm 24 ∧ mul G24i G24 = idm 24 := by native_decide
