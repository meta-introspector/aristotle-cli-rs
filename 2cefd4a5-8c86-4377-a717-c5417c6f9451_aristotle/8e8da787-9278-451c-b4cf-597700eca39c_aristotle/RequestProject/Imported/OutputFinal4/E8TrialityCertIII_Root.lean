/-! ## Section K: 2.Sym9-double-cover inside Aut of an even unimodular 16-dim lattice -/
theorem GG_even : evenDiag GG = true := by native_decide
theorem GG_unimodular : mul GG GGi = idm 16 ∧ mul GGi GG = idm 16 := by native_decide
theorem all_gens_isometries :
    Tgens.all (fun A => mul (mul A GG) (tr A) == GG) = true := by native_decide
theorem odd_lift_is_involution : mul T8 T8 = idm 16 := by native_decide
theorem double_cover_witness : mul (mul T1 T2) (mul T1 T2) = negm (idm 16) := by native_decide

/-! ## Section L: the lattice is E8 ⊥ E8, factors swapped by the odd lift -/
theorem factor1_E8 : evenDiag G1 = true ∧ mul G1 G1i = idm 8 ∧ mul G1i G1 = idm 8 := by native_decide
theorem factor2_E8 : evenDiag G2 = true ∧ mul G2 G2i = idm 8 ∧ mul G2i G2 = idm 8 := by native_decide
theorem factors_gram : mul (mul C1 GG) (tr C1) = G1 ∧ mul (mul C2 GG) (tr C2) = G2 := by native_decide
theorem factors_orthogonal : mul (mul C1 GG) (tr C2) = zerom 8 8 := by native_decide
theorem factors_span : mul (C1 ++ C2) CCi = idm 16 ∧ mul CCi (C1 ++ C2) = idm 16 := by native_decide
theorem odd_swaps_factors : mul C1 T8 = mul D12 C2 := by native_decide

/-! ## Section M: not D16+ — the roots already span unimodularly (Milnor pair decided) -/
theorem root_sublattice_unimodular :
    mul RtsH RtsHi = idm 16 ∧ mul RtsHi RtsH = idm 16 := by native_decide
