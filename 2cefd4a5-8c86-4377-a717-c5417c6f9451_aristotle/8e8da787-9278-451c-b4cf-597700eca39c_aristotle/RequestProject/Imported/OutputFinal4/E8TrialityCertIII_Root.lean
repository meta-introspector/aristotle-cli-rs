/-
  E8TrialityCertIII.lean — the double cover of Sym9 inside Aut(E8 ⊕ E8):
  the rational form W = Δ+ ⊕ √2·Δ- of the 16-dim basic spin representation
  preserves an even unimodular rank-16 lattice which splits as two
  orthogonal unimodular E8's; the even generators act block-diagonally
  (the two half-spin 2.A9 copies) and the odd transposition lift swaps the
  factors, squaring to +1, while the (12)(34)-lift squares to -1.
  Root-sublattice unimodularity (rootIdx) excludes D16+ (Milnor pair).
  Pure Lean 4 core; native_decide; inverse certificates throughout.
-/
abbrev Mat := List (List Int)
/-- `List.get!` was removed from this Lean core; reintroduce it locally. -/
def List.get! {α : Type _} [Inhabited α] (l : List α) (n : Nat) : α := l.getD n default
def dot (a b : List Int) : Int := (List.zipWith (fun x y => x*y) a b).foldl (fun s x => s+x) 0
def col (A : Mat) (j : Nat) : List Int := A.map (fun r => r.get! j)
def tr (A : Mat) : Mat := (List.range ((A.get! 0).length)).map (col A)
def mul (A B : Mat) : Mat := let Bt := tr B; A.map (fun r => Bt.map (fun c => dot r c))
def idm (n : Nat) : Mat := (List.range n).map (fun i => (List.range n).map (fun j => if i = j then (1:Int) else 0))
def negm (A : Mat) : Mat := A.map (fun r => r.map (fun x => -x))
def zerom (n m : Nat) : Mat := (List.range n).map (fun _ => (List.range m).map (fun _ => (0:Int)))
def evenDiag (A : Mat) : Bool := (List.range A.length).all (fun i => ((A.get! i).get! i) % 2 == 0)
