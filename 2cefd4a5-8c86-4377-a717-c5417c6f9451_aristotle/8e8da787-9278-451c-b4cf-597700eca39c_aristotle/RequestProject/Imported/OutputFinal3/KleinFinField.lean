import Mathlib
import RequestProject.Imported.OutputFinal3.KleinPGL
import RequestProject.Imported.OutputFinal3.VonDyck235

/-!
# Klein's icosahedral generators over `𝔽₁₁`, and `|⟨a, b⟩| = 60`

The field `𝔽₁₁ = ZMod 11` contains a primitive fifth root of unity, namely `z = 3`
(`3⁵ = 243 = 22·11 + 1`).  Feeding it into the generic construction of
`ArtinA5Even/KleinPGL.lean` gives two explicit elements

  `a = ⎡9 0 ⎤`      `b = ⎡1 4 ⎤`
  `    ⎣0 5 ⎦`          `⎣4 10⎦`

of `PGL₂(𝔽₁₁)` satisfying `a⁵ = b² = (ab)³ = 1` with exact orders `5`, `2`, `3`.

Combining this with the von Dyck theorem of `ArtinA5Even/VonDyck235.lean`
(`ArtinA5Even.VonDyck.card_closure_eq_sixty`: the relations `a⁵ = b² = (ab)³ = 1` together with
`a ≠ 1` force `⟨a, b⟩ ≅ A₅`) yields

* `ArtinA5Even.KleinF11.card_closure_eq_sixty` — the subgroup of `PGL₂(𝔽₁₁)` generated by these
  two matrices has **exactly `60`** elements;
* `ArtinA5Even.KleinF11.closureEquivAlternating` — and it is isomorphic to `A₅`.

The `60` elements are *not* obtained by a `Finset` enumeration inside `PGL₂(𝔽₁₁)` (which is a
quotient group, so its equality is not decidable without extra work): the lower bound comes from
the surjection `Δ(2,3,5) ↠ ⟨a, b⟩` and the simplicity of `A₅`, the upper bound from the twelve
coset representatives of the Todd–Coxeter table.  No `native_decide` is used anywhere.

The identification is with the **abstract** group `A₅`.  Nothing here is composed with the Galois
group of the Doud–Moore quintic, and no lift to `SL₂` of any field is constructed.
-/

namespace ArtinA5Even

namespace KleinF11

open Klein

/-- `11` is prime, so `ZMod 11` is a field. -/
instance fact_prime_eleven : Fact (Nat.Prime 11) := ⟨by norm_num⟩

/-- `3` is a primitive fifth root of unity in `𝔽₁₁`. -/
theorem three_pow_five : (3 : ZMod 11) ^ 5 = 1 := by decide

theorem three_ne_one : (3 : ZMod 11) ≠ 1 := by decide

/-- Klein's order-five generator over `𝔽₁₁`: the class of `diag(9, 5)`. -/
def a11 : PGL2 (ZMod 11) := kleinA (3 : ZMod 11) three_pow_five

/-- Klein's involution over `𝔽₁₁`: the class of `!![1, 4; 4, 10]`. -/
def b11 : PGL2 (ZMod 11) := kleinB (3 : ZMod 11) three_pow_five three_ne_one

/-! ## The two matrices, explicitly -/

theorem genAMat_three : genAMat (3 : ZMod 11) = !![9, 0; 0, 5] := by decide

theorem genBMat_three : genBMat (3 : ZMod 11) = !![1, 4; 4, 10] := by decide

/-! ## The icosahedral relations over `𝔽₁₁` -/

theorem a11_pow_five : a11 ^ 5 = 1 := kleinA_pow_five (3 : ZMod 11) three_pow_five

theorem b11_sq : b11 ^ 2 = 1 := kleinB_sq (3 : ZMod 11) three_pow_five three_ne_one

theorem a11b11_pow_three : (a11 * b11) ^ 3 = 1 :=
  kleinAB_pow_three (3 : ZMod 11) three_pow_five three_ne_one

theorem a11_ne_one : a11 ≠ 1 := kleinA_ne_one (3 : ZMod 11) three_pow_five three_ne_one

theorem orderOf_a11 : orderOf a11 = 5 := orderOf_kleinA (3 : ZMod 11) three_pow_five three_ne_one

theorem orderOf_b11 : orderOf b11 = 2 := orderOf_kleinB (3 : ZMod 11) three_pow_five three_ne_one

theorem orderOf_a11b11 : orderOf (a11 * b11) = 3 :=
  orderOf_kleinAB (3 : ZMod 11) three_pow_five three_ne_one

/-! ## The group they generate -/

/-- **The subgroup of `PGL₂(𝔽₁₁)` generated by Klein's two matrices is isomorphic to `A₅`.** -/
noncomputable def closureEquivAlternating :
    Subgroup.closure ({a11, b11} : Set (PGL2 (ZMod 11))) ≃* alternatingGroup (Fin 5) :=
  VonDyck.closureEquivAlternating a11_pow_five b11_sq a11b11_pow_three a11_ne_one

/-- **`|⟨a, b⟩| = 60` in `PGL₂(𝔽₁₁)`.** -/
theorem card_closure_eq_sixty :
    Nat.card (Subgroup.closure ({a11, b11} : Set (PGL2 (ZMod 11)))) = 60 :=
  VonDyck.card_closure_eq_sixty a11_pow_five b11_sq a11b11_pow_three a11_ne_one

/-- The order of the group generated by the two reductions is at least `60`; stated separately
because this is the direction that the finite field was introduced for. -/
theorem sixty_le_card_closure :
    60 ≤ Nat.card (Subgroup.closure ({a11, b11} : Set (PGL2 (ZMod 11)))) :=
  le_of_eq card_closure_eq_sixty.symm

end KleinF11

/-! ## The same statement over `ℚ(ζ₅)`

Klein's generators were built over any field with a primitive fifth root of unity, so the
identification also applies verbatim to the characteristic-zero case `K = ℚ(ζ₅)`. -/

namespace Klein

/-- **Klein's generators over `ℚ(ζ₅)` generate a copy of `A₅` inside `PGL₂(ℚ(ζ₅))`.** -/
noncomputable def closureEquivAlternating_cyclotomic :
    Subgroup.closure ({kleinA zeta5 zeta5_pow_five,
        kleinB zeta5 zeta5_pow_five zeta5_ne_one} : Set (PGL2 (CyclotomicField 5 ℚ))) ≃*
      alternatingGroup (Fin 5) :=
  VonDyck.closureEquivAlternating (kleinA_pow_five zeta5 zeta5_pow_five)
    (kleinB_sq zeta5 zeta5_pow_five zeta5_ne_one)
    (kleinAB_pow_three zeta5 zeta5_pow_five zeta5_ne_one)
    (kleinA_ne_one zeta5 zeta5_pow_five zeta5_ne_one)

/-- `|⟨a, b⟩| = 60` in `PGL₂(ℚ(ζ₅))`. -/
theorem card_closure_eq_sixty_cyclotomic :
    Nat.card (Subgroup.closure ({kleinA zeta5 zeta5_pow_five,
      kleinB zeta5 zeta5_pow_five zeta5_ne_one} : Set (PGL2 (CyclotomicField 5 ℚ)))) = 60 :=
  VonDyck.card_closure_eq_sixty (kleinA_pow_five zeta5 zeta5_pow_five)
    (kleinB_sq zeta5 zeta5_pow_five zeta5_ne_one)
    (kleinAB_pow_three zeta5 zeta5_pow_five zeta5_ne_one)
    (kleinA_ne_one zeta5 zeta5_pow_five zeta5_ne_one)

end Klein

end ArtinA5Even
