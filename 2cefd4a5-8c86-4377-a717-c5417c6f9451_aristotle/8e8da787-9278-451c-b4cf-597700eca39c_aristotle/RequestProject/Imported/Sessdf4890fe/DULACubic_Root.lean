import Mathlib

/-!
# DULACubic: Cubic residue character modulo 9

This file defines the cubic residue character χ₉ as an arithmetic function `ℕ → Fin 3`,
along with supporting definitions for lane partitions and coprimality predicates.

The cubic character mod 9 is the unique Dirichlet character of order 3 and conductor 9.
Since (ℤ/9ℤ)* ≅ ℤ/6ℤ is generated by 2, the character is determined by χ₉(2) = ζ₃.
-/

noncomputable section

namespace DULACubic

/-! ### Coprimality predicate -/

/-- `isCoprimeThree n` holds when `n` is coprime to 3. -/
def isCoprimeThree (n : ℕ) : Prop := Nat.gcd n 3 = 1

/-! ### Lane definitions -/

/-- Lane 0: residues ≡ 1, 8 mod 9 (cubic residues). -/
def Lane0 : Set ℕ := {n | n % 9 = 1 ∨ n % 9 = 8}

/-- Lane 1: residues ≡ 2, 7 mod 9. -/
def Lane1 : Set ℕ := {n | n % 9 = 2 ∨ n % 9 = 7}

/-- Lane 2: residues ≡ 4, 5 mod 9. -/
def Lane2 : Set ℕ := {n | n % 9 = 4 ∨ n % 9 = 5}

@[simp] theorem mem_Lane0_iff {n : ℕ} : n ∈ Lane0 ↔ (n % 9 = 1 ∨ n % 9 = 8) := Iff.rfl
@[simp] theorem mem_Lane1_iff {n : ℕ} : n ∈ Lane1 ↔ (n % 9 = 2 ∨ n % 9 = 7) := Iff.rfl
@[simp] theorem mem_Lane2_iff {n : ℕ} : n ∈ Lane2 ↔ (n % 9 = 4 ∨ n % 9 = 5) := Iff.rfl

/-! ### The cubic character χ₉ -/

/-- The cubic residue character modulo 9, valued in `Fin 3`.
    - `chi9 n = 0` means the character value is ζ₃⁰ = 1 (or n is not coprime to 3)
    - `chi9 n = 1` means the character value is ζ₃¹ = ζ₃
    - `chi9 n = 2` means the character value is ζ₃² -/
def chi9 (n : ℕ) : Fin 3 :=
  match n % 9 with
  | 1 => 0
  | 2 => 1
  | 4 => 2
  | 5 => 2
  | 7 => 1
  | 8 => 0
  | _ => 0  -- non-coprime residues (0, 3, 6)

/-! ### Value lemmas -/

@[simp] theorem chi9_one : chi9 1 = 0 := by native_decide
@[simp] theorem chi9_two : chi9 2 = 1 := by native_decide
@[simp] theorem chi9_four : chi9 4 = 2 := by native_decide
@[simp] theorem chi9_five : chi9 5 = 2 := by native_decide
@[simp] theorem chi9_seven : chi9 7 = 1 := by native_decide
@[simp] theorem chi9_eight : chi9 8 = 0 := by native_decide

/-! ### Multiplicativity -/

/-
chi9 is additive (in Fin 3) on inputs coprime to 3. This corresponds to
    multiplicativity of the character: ζ₃^(chi9(ab)) = ζ₃^(chi9(a)) · ζ₃^(chi9(b)).
-/
theorem chi9_mul {a b : ℕ} (ha : Nat.gcd a 3 = 1) (hb : Nat.gcd b 3 = 1) :
    chi9 (a * b) = chi9 a + chi9 b := by
  unfold chi9;
  norm_num [ Nat.mul_mod, Nat.gcd_rec 3 ] at *;
  rw [ Nat.gcd_comm ] at *; rw [ Nat.gcd_rec ] at *; ( rw [ ← Nat.mod_mod_of_dvd a ( by decide : 3 ∣ 9 ) ] at *; ( rw [ ← Nat.mod_mod_of_dvd b ( by decide : 3 ∣ 9 ) ] at *; have := Nat.mod_lt a ( by decide : 0 < 9 ) ; ( have := Nat.mod_lt b ( by decide : 0 < 9 ) ; interval_cases a % 9 <;> interval_cases b % 9 <;> trivial; ) ) )

/-! ### Partition theorem -/

/-
Every n coprime to 3 falls into exactly one of the three lanes.
-/
theorem coprimeThree_partition (n : ℕ) (h : isCoprimeThree n) :
    (n ∈ Lane0 ∧ chi9 n = 0 ∧ True) ∨
    (n ∈ Lane1 ∧ chi9 n = 1 ∧ True) ∨
    (n ∈ Lane2 ∧ chi9 n = 2 ∧ True) := by
  unfold isCoprimeThree at h;
  unfold Lane0 Lane1 Lane2 chi9; rw [ ← Nat.mod_add_div n 9 ] at *; have := Nat.mod_lt n ( by decide : 0 < 9 ) ; interval_cases n % 9 <;> simp_all +arith +decide [ Nat.coprime_mul_iff_left ] ;

end DULACubic

end