/-!
# The linear-phase oscillatory threshold

The bands of `RequestProject/PolyaLinBand*.lean` push the large-frequency threshold
for `f(t) = 2θ'(t) + δ̂(t) ≥ 0` from `5.5` down to `1.8`.
-/

set_option maxHeartbeats 1000000

noncomputable section

open MeasureTheory Set Real

namespace ConnesConsani.WeilPositivity

/-- **The Fourier-side inequality for `|t| ≥ 1.8`.**  This lowers the threshold `5.5`
of `fourierSide_nonneg_of_five_and_half_le_abs`; the gain comes from linearising the
phase of `cos(tv)` on each block, which makes the block error quadratic rather than
linear in the block width. -/
theorem fourierSide_nonneg_of_lin_threshold {t : ℝ} (ht : (1.8:ℝ) ≤ |t|) :
    0 ≤ fourierSide t := by
  rcases le_or_gt 5.5 |t| with hb | hb
  · exact fourierSide_nonneg_of_five_and_half_le_abs hb
  rw [← fourierSide_abs t]
  rcases le_or_gt 5.471875 |t| with g0 | g0
  · refine fourierSide_nonneg_band_osc (a := 5.471875) (b := 5.5) (by norm_num) g0 hb.le
      (oscLinBand127 g0 hb.le) ?_
    rw [Finset.range_eq_Ico]
    simp only [thetaSeriesTerm, poleAbscissa]
    norm_num [Finset.sum_Ico_succ_top]
  rcases le_or_gt 5.284375 |t| with g1 | g1
  · refine fourierSide_nonneg_band_osc (a := 5.284375) (b := 5.471875) (by norm_num) g1 g0.le
      (oscLinBand126 g1 g0.le) ?_
    rw [Finset.range_eq_Ico]
    simp only [thetaSeriesTerm, poleAbscissa]
    norm_num [Finset.sum_Ico_succ_top]
  rcases le_or_gt 5.159375 |t| with g2 | g2
  · refine fourierSide_nonneg_band_osc (a := 5.159375) (b := 5.284375) (by norm_num) g2 g1.le
      (oscLinBand125 g2 g1.le) ?_
    rw [Finset.range_eq_Ico]
    simp only [thetaSeriesTerm, poleAbscissa]
    norm_num [Finset.sum_Ico_succ_top]
  rcases le_or_gt 5.034375 |t| with g3 | g3
