The operator form of the description of Sonin's space as the orthogonal complement of the
join of the two cutoff projections, following §1–§2 of arXiv:2006.13771 (Connes–Consani,
*Weil positivity and Trace formula – the archimedean place*).

`RequestProject/Sonin.lean` constructs the two cutoff projections `P₁` (cutoff in space)
and `P̂₁` (cutoff in frequency) on `L²(ℝ)`, Sonin's space, and the orthogonal projection `S`
onto it.  This file records the *lattice* description used in the paper,

  `S = 1 - (P₁ ∨ P̂₁)`,

where `P₁ ∨ P̂₁` is the orthogonal projection onto the closed subspace generated by the
ranges of `P₁` and `P̂₁` (the join in the lattice of closed subspaces, i.e. the projection
onto the closure of the sum of the two ranges), together with the elementary identities
`S* = S = S²  ≥ 0`.
-/
import RequestProject.Imported.OutputFinal.RequestProject.Sonin

set_option maxHeartbeats 1000000
set_option synthInstance.maxHeartbeats 400000

noncomputable section

open MeasureTheory Set

namespace ConnesConsani.WeilPositivity

/-- The join `P₁ ∨ P̂₁` of the two cutoff subspaces: the closed subspace of `L²(ℝ)`
generated by the ranges of `P₁` and `P̂₁`. -/
def cutoffJoin : Submodule ℂ L2R :=
  (LinearMap.range (P1 : L2R →ₗ[ℂ] L2R)
    ⊔ LinearMap.range (P1hat : L2R →ₗ[ℂ] L2R)).topologicalClosure

/-- Equal subspaces have equal orthogonal projections. -/
theorem starProjection_congr {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    {K K' : Submodule ℂ E} [K.HasOrthogonalProjection] [K'.HasOrthogonalProjection]
    (h : K = K') : K.starProjection = K'.starProjection := by
  subst h; rfl

/-- Sonin's space is the orthogonal complement of the join `P₁ ∨ P̂₁`. -/
theorem soninSpace_eq_orthogonal_cutoffJoin : SoninSpace = cutoffJoinᗮ := by
  rw [SoninSpace_eq_orthogonal, cutoffJoin, Submodule.orthogonal_closure]

instance : CompleteSpace cutoffJoin :=
  (Submodule.isClosed_topologicalClosure _).completeSpace_coe

instance : cutoffJoin.HasOrthogonalProjection := inferInstance

/-- Dually, the join `P₁ ∨ P̂₁` is the orthogonal complement of Sonin's space. -/
theorem cutoffJoin_eq_orthogonal_soninSpace : cutoffJoin = SoninSpaceᗮ := by
  rw [soninSpace_eq_orthogonal_cutoffJoin, Submodule.orthogonal_orthogonal]

/-- The orthogonal projection onto the join `P₁ ∨ P̂₁`. -/
def cutoffJoinProjection : L2R →L[ℂ] L2R := cutoffJoin.starProjection

theorem cutoffJoinProjection_isSelfAdjoint : IsSelfAdjoint cutoffJoinProjection :=
  isSelfAdjoint_starProjection cutoffJoin

theorem cutoffJoinProjection_isIdempotent : IsIdempotentElem cutoffJoinProjection :=
  (isStarProjection_starProjection (U := cutoffJoin)).isIdempotentElem

/-- **`S = 1 - (P₁ ∨ P̂₁)`**: the Sonin projection is the complement of the projection onto
the join of the two cutoff subspaces.  This is the identity used in §2 of the paper. -/
theorem soninProjection_eq_one_sub_cutoffJoinProjection :
    SoninProjection = 1 - cutoffJoinProjection := by
  rw [SoninProjection, cutoffJoinProjection,
    starProjection_congr soninSpace_eq_orthogonal_cutoffJoin,
    Submodule.starProjection_orthogonal']

/-- Equivalently, `(P₁ ∨ P̂₁) = 1 - S`. -/
theorem cutoffJoinProjection_eq_one_sub_soninProjection :
    cutoffJoinProjection = 1 - SoninProjection := by
  rw [soninProjection_eq_one_sub_cutoffJoinProjection]
  abel

/-! ## The elementary identities `S* = S = S² ≥ 0` -/

/-- `S² = S`. -/
theorem soninProjection_sq : SoninProjection * SoninProjection = SoninProjection :=
  SoninProjection_isIdempotent

/-- `S* = S`. -/
theorem soninProjection_star : star SoninProjection = SoninProjection :=
  SoninProjection_isSelfAdjoint

/-- `S ≥ 0`. -/
theorem soninProjection_nonneg : (0 : L2R →L[ℂ] L2R) ≤ SoninProjection :=
  (ContinuousLinearMap.nonneg_iff_isPositive _).2 SoninProjection_isPositive

/-- `S` is a norm-one-or-zero projection: `‖S ξ‖ ≤ ‖ξ‖`. -/
theorem norm_soninProjection_apply_le (f : L2R) : ‖SoninProjection f‖ ≤ ‖f‖ :=
  Submodule.norm_starProjection_apply_le _ _

/-- The two cutoff projections are dominated by the join: `P₁ ξ` lies in `P₁ ∨ P̂₁`. -/
theorem mem_cutoffJoin_P1 (f : L2R) : P1 f ∈ cutoffJoin :=
  Submodule.le_topologicalClosure _ (Submodule.mem_sup_left ⟨f, rfl⟩)

theorem mem_cutoffJoin_P1hat (f : L2R) : P1hat f ∈ cutoffJoin :=
  Submodule.le_topologicalClosure _ (Submodule.mem_sup_right ⟨f, rfl⟩)

/-- The projection onto the join fixes the range of `P₁`. -/
theorem cutoffJoinProjection_apply_P1 (f : L2R) : cutoffJoinProjection (P1 f) = P1 f :=
  Submodule.starProjection_eq_self_iff.2 (mem_cutoffJoin_P1 f)

/-- The projection onto the join fixes the range of `P̂₁`. -/
theorem cutoffJoinProjection_apply_P1hat (f : L2R) : cutoffJoinProjection (P1hat f) = P1hat f :=
  Submodule.starProjection_eq_self_iff.2 (mem_cutoffJoin_P1hat f)

/-- `S` annihilates the range of `P₁`: `S P₁ = 0`. -/
theorem soninProjection_comp_P1 : SoninProjection ∘L P1 = 0 := by
  ext f
  simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.zero_apply,
    soninProjection_eq_one_sub_cutoffJoinProjection, ContinuousLinearMap.sub_apply,
    ContinuousLinearMap.one_apply, cutoffJoinProjection_apply_P1, sub_self]
  rfl

/-- `S` annihilates the range of `P̂₁`: `S P̂₁ = 0`. -/
theorem soninProjection_comp_P1hat : SoninProjection ∘L P1hat = 0 := by
  ext f
  simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.zero_apply,
    soninProjection_eq_one_sub_cutoffJoinProjection, ContinuousLinearMap.sub_apply,
    ContinuousLinearMap.one_apply, cutoffJoinProjection_apply_P1hat, sub_self]
  rfl

/-! ## Positivity of the sandwiches `P₁ P̂₁ P₁` and `S A S` -/

/-- `P₁` is a star projection (self-adjoint idempotent). -/
theorem P1_isStarProjection : IsStarProjection P1 := ⟨P1_idempotent, P1_selfAdjoint⟩

/-- `P̂₁` is a star projection (self-adjoint idempotent). -/
theorem P1hat_isStarProjection : IsStarProjection P1hat := ⟨P1hat_idempotent, P1hat_selfAdjoint⟩

theorem adjoint_P1 : ContinuousLinearMap.adjoint P1 = P1 := by
  have h := P1_selfAdjoint
  rwa [IsSelfAdjoint, ContinuousLinearMap.star_eq_adjoint] at h

theorem adjoint_soninProjection :
    ContinuousLinearMap.adjoint SoninProjection = SoninProjection := by
  have h := SoninProjection_isSelfAdjoint
  rwa [IsSelfAdjoint, ContinuousLinearMap.star_eq_adjoint] at h

/-- **`P₁ P̂₁ P₁ ≥ 0`**: the operator appearing in the trace formula `L(f) = Tr(ϑ(f) P P̂ P)`
of the paper is positive, being of the form `(P̂₁ P₁)* (P̂₁ P₁)`. -/
theorem P1_P1hat_P1_isPositive : (P1 ∘L P1hat ∘L P1).IsPositive := by
  have h := (ContinuousLinearMap.IsPositive.of_isStarProjection
    P1hat_isStarProjection).adjoint_conj P1
  rwa [adjoint_P1] at h

/-- The Sonin projection sandwiches positive operators into positive operators. -/
theorem soninProjection_conj_isPositive {A : L2R →L[ℂ] L2R} (hA : A.IsPositive) :
    (SoninProjection ∘L A ∘L SoninProjection).IsPositive := by
  have h := hA.adjoint_conj SoninProjection
  rwa [adjoint_soninProjection] at h

end ConnesConsani.WeilPositivity
