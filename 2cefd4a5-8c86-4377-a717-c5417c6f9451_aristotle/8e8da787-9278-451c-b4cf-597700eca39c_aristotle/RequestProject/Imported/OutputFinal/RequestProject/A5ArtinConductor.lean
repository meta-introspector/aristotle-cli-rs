import RequestProject.Imported.OutputFinal.RequestProject.A5Artin

/-!
# Artin conductor exponents for the even `A₅` representations

Let `N/ℚ` be Galois with `Gal(N/ℚ) ≃ A₅` and let `K` be the quintic subfield
fixed by a point stabiliser.  For a prime `p` the higher ramification groups
in lower numbering `G₀ ⊇ G₁ ⊇ G₂ ⊇ …` (the inertia group and its wild
filtration) determine the Artin conductor exponent of a representation `ρ` by

  `a(ρ) = Σ_{i ≥ 0} (|G_i| / |G₀|) · codim V^{G_i}`.

This file makes that formula into a Lean definition and proves the identities
that the numerical tables of `docs/A5_even_Artin.md` use.

## Contents

* `Subgp` — the isomorphism types of the groups that occur in the filtration of
  an inertia group of an `A₅`-extension: the trivial group, the cyclic groups of
  order `2, 3, 5` and the Klein four group, together with the dihedral group `S₃`
  of order 6 (which occurs as a *tamely-cyclic-by-wild* inertia group at `p = 3`).
  Each is recorded through the number of its elements in each conjugacy class of
  `A₅` (`Subgp.count`), which is all that the conductor formula sees.
* `IRep` — the five irreducible representations `1, ρ₃, ρ₃′, ρ₄, ρ₅` together
  with the three permutation representations on `5, 6, 12` points and the
  regular representation.
* `fixedDim`, `codim` — the dimension of the space of invariants of a subgroup,
  given as an explicit table and *proved* (`fixedDim_mul_card_eq_charSum`) to be
  the character average `(1/|H|) Σ_{h ∈ H} χ(h)`.
* `condExp` (a natural number) and `condExpQ` (its rational avatar) — the local
  conductor exponent of a representation for a given filtration `Filt`.
  `condExp` divides each term of the sum by `|G₀|` separately, so it agrees
  with the true Artin exponent exactly under the hypothesis `IntegralAt`
  (`condExp_cast`); Artin's integrality theorem itself is not formalised, and
  integrality is checked by `decide` for the filtrations that occur.
* `artinConductor` — the global conductor `N(ρ) = ∏_p p^{a(ρ,p)}`,
  `discK = artinConductor perm5` — the discriminant of the quintic field, and
  `discK6 = artinConductor perm6` — the discriminant of the sextic field, which is
  the conductor of the 5-point permutation representation
  (conductor–discriminant formula).

## Main results

* `condExp_perm5_eq_r4` / `discK_eq_artinConductor_r4`: `v_p(d_K) = a(ρ₄, p)` and
  `d_K = N(ρ₄)`.
* `artinConductor_r3_eq_r4`, `artinConductor_r3b_eq_r3`, `artinConductor_three_eq_discK`:
  `N(ρ₃) = N(ρ₃′) = N(ρ₄) = d_K`, provided no inertia group of order 5 occurs
  (the case that is excluded from the tables anyway; see `codim_r3_C5` for the
  fact that the hypothesis is genuinely needed).
* `artinConductor_r5_eq_discK_mul_excess`, `discK_dvd_artinConductor_r5`: `N(ρ₅)` is
  `d_K` times an explicit extra factor, and it equals `d_K` exactly when no
  filtration group is a 3-group or `S₃`.
* `discK6_eq_artinConductor_r5`: `N(ρ₅) = d_{K₆}`, the sextic counterpart of
  `d_K = N(ρ₄)`.
* `discK_eq_artinConductor_r3_mul_deficit`, `artinConductor_r3_dvd_discK`: the
  mirror-image, `C₅`-supported comparison of `N(ρ₃)` with `d_K`, valid with no
  hypothesis on the ramification.
* `artinConductor_perm6_eq_r5`, `artinConductor_perm12_eq`, `artinConductor_reg_eq`: the
  conductor identities matching the factorisations of the Dedekind zeta
  functions proved in `A5Artin.lean` (`permPoly6_eq`, `permPoly12_eq`,
  `regPoly_eq`).
* Section 6 verifies, for the first fifteen fields of the table in
  `docs/A5_even_Artin.md`, that the formally defined conductors reproduce the
  numbers used there.
-/

namespace A5Artin

open Cls

/-! ## 1. Subgroup types occurring in the ramification filtration -/

/-- The isomorphism types of subgroups of `A₅` that occur as a term `G_i` of the
higher ramification filtration of an inertia group in the fields considered:
the trivial group, `C₂`, `C₃`, `C₅`, the Klein four group `V₄`, and the
dihedral group `S₃` of order `6`. -/
inductive Subgp
  | triv | C2 | C3 | C5 | V4 | S3
  deriving DecidableEq, Repr, Fintype

namespace Subgp

/-- The order of the subgroup. -/
def card : Subgp → ℕ
  | triv => 1 | C2 => 2 | C3 => 3 | C5 => 5 | V4 => 4 | S3 => 6

/-- The number of elements of the subgroup lying in each conjugacy class of
`A₅`.  (`C₅` contains two elements of each of the two classes of 5-cycles;
`V₄` consists of the identity and three double transpositions; `S₃` is
generated by a 3-cycle and a double transposition.) -/
def count : Subgp → Cls → ℕ
  | triv, c1 => 1 | triv, c2 => 0 | triv, c3 => 0 | triv, c5A => 0 | triv, c5B => 0
  | C2, c1 => 1 | C2, c2 => 1 | C2, c3 => 0 | C2, c5A => 0 | C2, c5B => 0
  | C3, c1 => 1 | C3, c2 => 0 | C3, c3 => 2 | C3, c5A => 0 | C3, c5B => 0
  | C5, c1 => 1 | C5, c2 => 0 | C5, c3 => 0 | C5, c5A => 2 | C5, c5B => 2
  | V4, c1 => 1 | V4, c2 => 3 | V4, c3 => 0 | V4, c5A => 0 | V4, c5B => 0
  | S3, c1 => 1 | S3, c2 => 3 | S3, c3 => 2 | S3, c5A => 0 | S3, c5B => 0

/-- The class counts add up to the order of the group. -/
theorem sum_count (H : Subgp) :
    count H c1 + count H c2 + count H c3 + count H c5A + count H c5B = card H := by
  cases H <;> rfl

theorem card_pos (H : Subgp) : 0 < card H := by cases H <;> norm_num [card]

theorem card_ne_zero (H : Subgp) : (card H : ℚ) ≠ 0 := by
  exact_mod_cast (card_pos H).ne'

end Subgp

/-! ## 2. The representations -/

/-- The five irreducible representations of `A₅`, together with the three
transitive permutation representations (on `5`, `6` and `12` points) and the
regular representation. -/
inductive IRep
  | r1 | r3 | r3b | r4 | r5 | perm5 | perm6 | perm12 | reg
  deriving DecidableEq, Repr, Fintype

namespace IRep

/-- The dimension of the representation. -/
def dim : IRep → ℕ
  | r1 => 1 | r3 => 3 | r3b => 3 | r4 => 4 | r5 => 5
  | perm5 => 5 | perm6 => 6 | perm12 => 12 | reg => 60

end IRep

open IRep

/-- The character of the 5-point permutation representation (number of fixed
points of a permutation of the given cycle type). -/
noncomputable def chiPerm5 : Cls → ℝ
  | c1 => 5 | c2 => 1 | c3 => 2 | c5A => 0 | c5B => 0

/-- The character of the 6-point permutation representation
(`A₅ ≃ PSL₂(𝔽₅)` acting on `ℙ¹(𝔽₅)`). -/
noncomputable def chiPerm6 : Cls → ℝ
  | c1 => 6 | c2 => 2 | c3 => 0 | c5A => 1 | c5B => 1

/-- The character of the 12-point permutation representation (cosets of a
Sylow 5-subgroup). -/
noncomputable def chiPerm12 : Cls → ℝ
  | c1 => 12 | c2 => 0 | c3 => 0 | c5A => 2 | c5B => 2

/-- The character of the regular representation. -/
noncomputable def chiReg : Cls → ℝ
  | c1 => 60 | c2 => 0 | c3 => 0 | c5A => 0 | c5B => 0

/-- The character of each of our representations. -/
noncomputable def IRep.chi : IRep → Cls → ℝ
  | r1 => chi1 | r3 => chi3 | r3b => chi3b | r4 => chi4 | r5 => chi5
  | perm5 => chiPerm5 | perm6 => chiPerm6 | perm12 => chiPerm12 | reg => chiReg

/-- `π₅ = 1 ⊕ ρ₄` at the level of characters. -/
theorem chiPerm5_eq (c : Cls) : chiPerm5 c = chi1 c + chi4 c := by
  cases c <;> simp [chiPerm5, chi1, chi4] <;> norm_num

/-- `π₆ = 1 ⊕ ρ₅` at the level of characters. -/
theorem chiPerm6_eq (c : Cls) : chiPerm6 c = chi1 c + chi5 c := by
  cases c <;> simp [chiPerm6, chi1, chi5] <;> norm_num

/-- `π₁₂ = 1 ⊕ ρ₃ ⊕ ρ₃′ ⊕ ρ₅` at the level of characters. -/
theorem chiPerm12_eq (c : Cls) : chiPerm12 c = chi1 c + chi3 c + chi3b c + chi5 c := by
  have h := phi_add
  cases c <;> simp only [chiPerm12, chi1, chi3, chi3b, chi5] <;> linarith

/-- `ρ_reg = 1 ⊕ 3ρ₃ ⊕ 3ρ₃′ ⊕ 4ρ₄ ⊕ 5ρ₅` at the level of characters. -/
theorem chiReg_eq (c : Cls) :
    chiReg c = chi1 c + 3 * chi3 c + 3 * chi3b c + 4 * chi4 c + 5 * chi5 c := by
  have h := phi_add
  cases c <;> simp only [chiReg, chi1, chi3, chi3b, chi4, chi5] <;> linarith

/-! ## 3. Invariants and codimensions -/

/-- The dimension of the space `V^H` of `H`-invariants, as an explicit table.
It is proved to be the character average in `fixedDim_mul_card_eq_charSum`. -/
def fixedDim : IRep → Subgp → ℕ
  | r1, _ => 1
  | r3, .triv => 3 | r3, .C2 => 1 | r3, .C3 => 1 | r3, .C5 => 1 | r3, .V4 => 0 | r3, .S3 => 0
  | r3b, .triv => 3 | r3b, .C2 => 1 | r3b, .C3 => 1 | r3b, .C5 => 1 | r3b, .V4 => 0 | r3b, .S3 => 0
  | r4, .triv => 4 | r4, .C2 => 2 | r4, .C3 => 2 | r4, .C5 => 0 | r4, .V4 => 1 | r4, .S3 => 1
  | r5, .triv => 5 | r5, .C2 => 3 | r5, .C3 => 1 | r5, .C5 => 1 | r5, .V4 => 2 | r5, .S3 => 1
  | perm5, .triv => 5 | perm5, .C2 => 3 | perm5, .C3 => 3 | perm5, .C5 => 1
  | perm5, .V4 => 2 | perm5, .S3 => 2
  | perm6, .triv => 6 | perm6, .C2 => 4 | perm6, .C3 => 2 | perm6, .C5 => 2
  | perm6, .V4 => 3 | perm6, .S3 => 2
  | perm12, .triv => 12 | perm12, .C2 => 6 | perm12, .C3 => 4 | perm12, .C5 => 4
  | perm12, .V4 => 3 | perm12, .S3 => 2
  | reg, .triv => 60 | reg, .C2 => 30 | reg, .C3 => 20 | reg, .C5 => 12
  | reg, .V4 => 15 | reg, .S3 => 10

/-- `Σ_{h ∈ H} χ(h)`, computed from the class counts of `H`. -/
noncomputable def charSum (R : IRep) (H : Subgp) : ℝ :=
  H.count c1 * R.chi c1 + H.count c2 * R.chi c2 + H.count c3 * R.chi c3 +
    H.count c5A * R.chi c5A + H.count c5B * R.chi c5B

/-- The table `fixedDim` really is the dimension of the invariants:
`|H| · dim V^H = Σ_{h ∈ H} χ_V(h)`. -/
theorem fixedDim_mul_card_eq_charSum (R : IRep) (H : Subgp) :
    (H.card : ℝ) * fixedDim R H = charSum R H := by
  have h := phi_add
  cases R <;> cases H <;>
    simp only [charSum, Subgp.count, Subgp.card, fixedDim, IRep.chi, chi1, chi3, chi3b,
      chi4, chi5, chiPerm5, chiPerm6, chiPerm12, chiReg, Nat.cast_ofNat, Nat.cast_one,
      Nat.cast_zero] <;> linarith

theorem fixedDim_le_dim (R : IRep) (H : Subgp) : fixedDim R H ≤ R.dim := by
  cases R <;> cases H <;> decide

/-- The codimension of the invariants, `codim V^H = dim V − dim V^H`. -/
def codim (R : IRep) (H : Subgp) : ℕ := R.dim - fixedDim R H

theorem codim_add_fixedDim (R : IRep) (H : Subgp) : codim R H + fixedDim R H = R.dim := by
  cases R <;> cases H <;> decide

@[simp] theorem codim_triv (R : IRep) : codim R .triv = 0 := by cases R <;> rfl

@[simp] theorem codim_r1 (H : Subgp) : codim r1 H = 0 := by cases H <;> rfl

/-- For every subgroup type other than `C₅`, the two three-dimensional
representations and the standard four-dimensional one have invariants of the
same codimension.  This is what makes `N(ρ₃) = N(ρ₃′) = N(ρ₄)`. -/
theorem codim_r3_eq_r4 {H : Subgp} (h : H ≠ .C5) : codim r3 H = codim r4 H := by
  cases H <;> simp_all <;> rfl

theorem codim_r3b_eq_r3 (H : Subgp) : codim r3b H = codim r3 H := by cases H <;> rfl

/-- The hypothesis `H ≠ C₅` above cannot be dropped. -/
theorem codim_r3_C5 : codim r3 .C5 = 2 ∧ codim r4 .C5 = 4 := ⟨rfl, rfl⟩

/-- The 5-point permutation representation and `ρ₄` have the same
codimensions, because `1` has no codimension: this is the local form of the
conductor–discriminant formula `v_p(d_K) = a(ρ₄, p)`. -/
theorem codim_perm5_eq_r4 (H : Subgp) : codim perm5 H = codim r4 H := by cases H <;> rfl

theorem codim_perm6_eq_r5 (H : Subgp) : codim perm6 H = codim r5 H := by cases H <;> rfl

theorem codim_perm12_eq (H : Subgp) :
    codim perm12 H = codim r3 H + codim r3b H + codim r5 H := by cases H <;> rfl

theorem codim_reg_eq (H : Subgp) :
    codim reg H = 3 * codim r3 H + 3 * codim r3b H + 4 * codim r4 H + 5 * codim r5 H := by
  cases H <;> rfl

theorem codim_r4_le_r5 (H : Subgp) : codim r4 H ≤ codim r5 H := by cases H <;> decide

/-- The excess of `ρ₅` over `ρ₄`: it is nonzero exactly at the subgroups of
order divisible by `3`. -/
theorem codim_r5_sub_r4 (H : Subgp) :
    codim r5 H - codim r4 H = (if H = .C3 then 2 else if H = .S3 then 1 else 0) := by
  cases H <;> rfl

/-! ## 4. The local conductor exponent -/

/-- A higher ramification filtration, recorded up to isomorphism type: the
inertia group `G₀` together with the list `G₁, G₂, …` of the nontrivial terms
of its wild filtration (in lower numbering, with repetitions). -/
structure Filt where
  /-- The inertia group `G₀`. -/
  G0 : Subgp
  /-- The list `G₁, G₂, …` of higher ramification groups. -/
  higher : List Subgp
  deriving DecidableEq, Repr

namespace Filt

/-- All the groups of the filtration, `G₀, G₁, G₂, …`. -/
def groups (F : Filt) : List Subgp := F.G0 :: F.higher

end Filt

/-- The rational-valued functional `u ↦ u(G₀) + Σ_{i ≥ 1} (|G_i|/|G₀|) u(G_i)`
of which the conductor exponent is the value at `u = codim`. -/
def condQ (F : Filt) (u : Subgp → ℚ) : ℚ :=
  u F.G0 + ((F.higher.map fun H => (H.card : ℚ) * u H).sum) / (F.G0.card : ℚ)

/-- The Artin conductor exponent `a(ρ) = Σ_{i ≥ 0} (|G_i|/|G₀|) codim V^{G_i}`,
as a rational number. -/
def condExpQ (R : IRep) (F : Filt) : ℚ := condQ F fun H => (codim R H : ℚ)

/-- The Artin conductor exponent as a natural number.

**Caveat (honesty about the definition).**  Each summand `|G_i|·codim V^{G_i}`
is divided by `|G₀|` *separately*, using truncating natural-number division.
So `condExp` agrees with the genuine Artin exponent — the value of the rational
formula `condExpQ` — precisely under the hypothesis `IntegralAt R F`, which is
what `condExp_cast` says.  Artin's integrality theorem (the statement that the
rational number `condExpQ R F` is in fact a non-negative integer for every
genuine ramification filtration) is *not* formalised here: for the filtrations
that actually occur below, integrality is instead checked directly by `decide`
(`integral_of_occurring`, `table_integral`), and every identity that needs it
carries `Integral` as an explicit hypothesis. -/
def condExp (R : IRep) (F : Filt) : ℕ :=
  codim R F.G0 + (F.higher.map fun H => H.card * codim R H / F.G0.card).sum

/-- Each term `(|G_i|/|G₀|)·codim V^{G_i}` of the conductor exponent of `R` is
an integer.  This holds for every genuine filtration; it is checked directly
for the filtrations occurring below. -/
def IntegralAt (R : IRep) (F : Filt) : Prop :=
  ∀ H ∈ F.higher, F.G0.card ∣ H.card * codim R H

/-- `IntegralAt` for every representation. -/
def Integral (F : Filt) : Prop := ∀ R : IRep, IntegralAt R F

instance (R : IRep) (F : Filt) : Decidable (IntegralAt R F) := by
  unfold IntegralAt; infer_instance

instance (F : Filt) : Decidable (Integral F) := by unfold Integral; infer_instance

/-! ### Elementary properties -/

private theorem sum_map_cast_div (n : ℕ) (hn : n ≠ 0) (w : Subgp → ℕ) :
    ∀ l : List Subgp, (∀ H ∈ l, n ∣ w H) →
      (((l.map fun H => w H / n).sum : ℕ) : ℚ)
        = ((l.map fun H => (w H : ℚ)).sum) / (n : ℚ) := by
  intro l
  induction l with
  | nil => simp
  | cons H t ih =>
      intro h
      have hH : n ∣ w H := h H (by simp)
      have ht : ∀ K ∈ t, n ∣ w K := fun K hK => h K (by simp [hK])
      have hn' : (n : ℚ) ≠ 0 := by exact_mod_cast hn
      simp only [List.map_cons, List.sum_cons, Nat.cast_add, ih ht]
      rw [Nat.cast_div hH hn']
      field_simp

private theorem sum_map_mul_add (u v : Subgp → ℚ) :
    ∀ l : List Subgp,
      (l.map fun H => (H.card : ℚ) * (u H + v H)).sum
        = (l.map fun H => (H.card : ℚ) * u H).sum
          + (l.map fun H => (H.card : ℚ) * v H).sum := by
  intro l
  induction l with
  | nil => simp
  | cons H t ih => simp only [List.map_cons, List.sum_cons, ih]; ring

private theorem sum_map_mul_const (c : ℚ) (u : Subgp → ℚ) :
    ∀ l : List Subgp,
      (l.map fun H => (H.card : ℚ) * (c * u H)).sum
        = c * (l.map fun H => (H.card : ℚ) * u H).sum := by
  intro l
  induction l with
  | nil => simp
  | cons H t ih => simp only [List.map_cons, List.sum_cons, ih]; ring

theorem condQ_congr (F : Filt) {u v : Subgp → ℚ} (h : ∀ H, u H = v H) :
    condQ F u = condQ F v := by
  simp only [condQ, h]

theorem condQ_add (F : Filt) (u v : Subgp → ℚ) :
    condQ F (fun H => u H + v H) = condQ F u + condQ F v := by
  simp only [condQ, sum_map_mul_add]
  field_simp
  ring

theorem condQ_const_mul (F : Filt) (c : ℚ) (u : Subgp → ℚ) :
    condQ F (fun H => c * u H) = c * condQ F u := by
  simp only [condQ, sum_map_mul_const]
  field_simp

theorem condQ_zero (F : Filt) : condQ F (fun _ => 0) = 0 := by
  simp [condQ]

/-- The natural-number conductor exponent agrees with the rational formula as
soon as every term is an integer. -/
theorem condExp_cast {R : IRep} {F : Filt} (h : IntegralAt R F) :
    ((condExp R F : ℕ) : ℚ) = condExpQ R F := by
  have hn : F.G0.card ≠ 0 := (Subgp.card_pos _).ne'
  simp only [condExp, condExpQ, condQ, Nat.cast_add]
  rw [sum_map_cast_div F.G0.card hn (fun H => H.card * codim R H) F.higher h]
  simp only [Nat.cast_mul]

/-- The trivial representation has conductor exponent `0`. -/
@[simp] theorem condExpQ_r1 (F : Filt) : condExpQ r1 F = 0 := by
  simp [condExpQ, condQ]

@[simp] theorem condExp_r1 (F : Filt) : condExp r1 F = 0 := by
  simp [condExp]

/-- Two representations with the same invariant codimensions have the same
conductor exponent. -/
theorem condExp_congr {R S : IRep} (F : Filt) (h : ∀ H ∈ F.groups, codim R H = codim S H) :
    condExp R F = condExp S F := by
  have h0 : codim R F.G0 = codim S F.G0 := h _ (by simp [Filt.groups])
  have h1 : ∀ H ∈ F.higher, H.card * codim R H / F.G0.card
      = H.card * codim S H / F.G0.card := by
    intro H hH; rw [h H (by simp [Filt.groups, hH])]
  simp only [condExp, h0, List.map_congr_left h1]

theorem condExp_mono {R S : IRep} (F : Filt) (h : ∀ H, codim R H ≤ codim S H) :
    condExp R F ≤ condExp S F := by
  have hsum : ∀ l : List Subgp,
      (l.map fun H => H.card * codim R H / F.G0.card).sum
        ≤ (l.map fun H => H.card * codim S H / F.G0.card).sum := by
    intro l
    induction l with
    | nil => simp
    | cons H t ih =>
        simp only [List.map_cons, List.sum_cons]
        exact Nat.add_le_add (Nat.div_le_div_right (Nat.mul_le_mul_left _ (h H))) ih
  exact Nat.add_le_add (h _) (hsum _)

/-! ### The four structural identities -/

/-- Conductor–discriminant at a single prime: `v_p(d_K) = a(ρ₄, p)`, since the
5-point permutation representation is `1 ⊕ ρ₄`. -/
theorem condExp_perm5_eq_r4 (F : Filt) : condExp perm5 F = condExp r4 F :=
  condExp_congr F fun H _ => codim_perm5_eq_r4 H

/-- `a(ρ₅, p)` is the conductor exponent of the 6-point permutation
representation, i.e. `v_p(d_{K₆})`. -/
theorem condExp_perm6_eq_r5 (F : Filt) : condExp perm6 F = condExp r5 F :=
  condExp_congr F fun H _ => codim_perm6_eq_r5 H

theorem condExp_r3b_eq_r3 (F : Filt) : condExp r3b F = condExp r3 F :=
  condExp_congr F fun H _ => codim_r3b_eq_r3 H

/-- If no inertia group of order `5` occurs, `ρ₃` and `ρ₄` have the same
conductor exponent. -/
theorem condExp_r3_eq_r4 {F : Filt} (h : Subgp.C5 ∉ F.groups) :
    condExp r3 F = condExp r4 F :=
  condExp_congr F fun H hH => codim_r3_eq_r4 (by rintro rfl; exact h hH)

theorem condExp_r4_le_r5 (F : Filt) : condExp r4 F ≤ condExp r5 F :=
  condExp_mono F codim_r4_le_r5

theorem condExpQ_perm12 (F : Filt) :
    condExpQ perm12 F = condExpQ r3 F + condExpQ r3b F + condExpQ r5 F := by
  have h : ∀ H : Subgp, ((codim perm12 H : ℚ))
      = ((codim r3 H : ℚ) + (codim r3b H : ℚ)) + (codim r5 H : ℚ) := by
    intro H; rw [← Nat.cast_add, ← Nat.cast_add, codim_perm12_eq H]
  simp only [condExpQ]
  rw [condQ_congr F h, condQ_add, condQ_add]

theorem condExpQ_reg (F : Filt) :
    condExpQ reg F = 3 * condExpQ r3 F + 3 * condExpQ r3b F
      + 4 * condExpQ r4 F + 5 * condExpQ r5 F := by
  have h : ∀ H : Subgp, ((codim reg H : ℚ))
      = ((3 * (codim r3 H : ℚ) + 3 * (codim r3b H : ℚ)) + 4 * (codim r4 H : ℚ))
        + 5 * (codim r5 H : ℚ) := by
    intro H
    have := codim_reg_eq H
    push_cast [this]
    ring
  simp only [condExpQ]
  rw [condQ_congr F h, condQ_add, condQ_add, condQ_add,
    condQ_const_mul, condQ_const_mul, condQ_const_mul, condQ_const_mul]

/-- `a(π₁₂) = a(ρ₃) + a(ρ₃′) + a(ρ₅)`: the conductor form of
`ζ_{K₁₂} = ζ · L(ρ₃) L(ρ₃′) L(ρ₅)`. -/
theorem condExp_perm12 {F : Filt} (h : Integral F) :
    condExp perm12 F = condExp r3 F + condExp r3b F + condExp r5 F := by
  have := condExpQ_perm12 F
  rw [← condExp_cast (h perm12), ← condExp_cast (h r3), ← condExp_cast (h r3b),
    ← condExp_cast (h r5)] at this
  exact_mod_cast this

/-- `a(ρ_reg) = 3a(ρ₃) + 3a(ρ₃′) + 4a(ρ₄) + 5a(ρ₅)`: the conductor form of
`ζ_N = ζ · L(ρ₃)³ L(ρ₃′)³ L(ρ₄)⁴ L(ρ₅)⁵`. -/
theorem condExp_reg {F : Filt} (h : Integral F) :
    condExp reg F = 3 * condExp r3 F + 3 * condExp r3b F
      + 4 * condExp r4 F + 5 * condExp r5 F := by
  have := condExpQ_reg F
  rw [← condExp_cast (h reg), ← condExp_cast (h r3), ← condExp_cast (h r3b),
    ← condExp_cast (h r4), ← condExp_cast (h r5)] at this
  exact_mod_cast this

/-! ## 5. The global Artin conductor -/

/-- The ramification datum at one ramified prime: the prime together with the
isomorphism type of its higher ramification filtration. -/
structure LocalRam where
  /-- The ramified prime. -/
  p : ℕ
  /-- Its higher ramification filtration. -/
  fil : Filt
  deriving DecidableEq, Repr

/-- The ramification data of a field: one entry for each ramified prime. -/
abbrev RamData := List LocalRam

/-- The global Artin conductor `N(ρ) = ∏_p p^{a(ρ,p)}`. -/
def artinConductor (R : IRep) (D : RamData) : ℕ :=
  (D.map fun L => L.p ^ condExp R L.fil).prod

/-- The discriminant `d_K` of the quintic field: by the conductor–discriminant
formula it is the conductor of the 5-point permutation representation. -/
def discK (D : RamData) : ℕ := artinConductor perm5 D

theorem artinConductor_congr {R S : IRep} (D : RamData)
    (h : ∀ L ∈ D, condExp R L.fil = condExp S L.fil) :
    artinConductor R D = artinConductor S D := by
  simp only [artinConductor]
  congr 1
  exact List.map_congr_left fun L hL => by rw [h L hL]

/-- **Conductor–discriminant for the quintic field**: `d_K = N(ρ₄)`. -/
theorem discK_eq_artinConductor_r4 (D : RamData) : discK D = artinConductor r4 D :=
  artinConductor_congr D fun L _ => condExp_perm5_eq_r4 L.fil

theorem artinConductor_r3b_eq_r3 (D : RamData) : artinConductor r3b D = artinConductor r3 D :=
  artinConductor_congr D fun L _ => condExp_r3b_eq_r3 L.fil

/-- `N(ρ₃) = N(ρ₄)` whenever no inertia group of order `5` occurs. -/
theorem artinConductor_r3_eq_r4 {D : RamData} (h : ∀ L ∈ D, Subgp.C5 ∉ L.fil.groups) :
    artinConductor r3 D = artinConductor r4 D :=
  artinConductor_congr D fun L hL => condExp_r3_eq_r4 (h L hL)

/-- **The first table identity**: `N(ρ₃) = N(ρ₃′) = N(ρ₄) = d_K`, for any field
in which no inertia group has order `5`. -/
theorem artinConductor_three_eq_discK {D : RamData} (h : ∀ L ∈ D, Subgp.C5 ∉ L.fil.groups) :
    artinConductor r3 D = discK D ∧ artinConductor r3b D = discK D ∧ artinConductor r4 D = discK D := by
  have h4 := discK_eq_artinConductor_r4 D
  have h3 := artinConductor_r3_eq_r4 h
  exact ⟨by rw [h3, h4], by rw [artinConductor_r3b_eq_r3, h3, h4], h4.symm⟩

/-- The conductor of `ρ₅` is the discriminant of the sextic field `K₆`. -/
theorem artinConductor_perm6_eq_r5 (D : RamData) : artinConductor perm6 D = artinConductor r5 D :=
  artinConductor_congr D fun L _ => condExp_perm6_eq_r5 L.fil

/-- The discriminant `d_{K₆}` of the sextic field `K₆` fixed by a point
stabiliser of the action of `A₅` on the six Sylow 5-subgroups: by the
conductor–discriminant formula it is the conductor of the 6-point permutation
representation, exactly as `discK` is that of the 5-point one. -/
def discK6 (D : RamData) : ℕ := artinConductor perm6 D

/-- **Conductor–discriminant for the sextic field**: `N(ρ₅) = d_{K₆}`, the
exact parallel of `discK_eq_artinConductor_r4` (`N(ρ₄) = d_K`). -/
theorem discK6_eq_artinConductor_r5 (D : RamData) : discK6 D = artinConductor r5 D :=
  artinConductor_perm6_eq_r5 D

/-- The conductor form of `ζ_{K₁₂} = ζ · L(ρ₃) L(ρ₃′) L(ρ₅)`. -/
theorem artinConductor_perm12_eq : ∀ D : RamData, (∀ L ∈ D, Integral L.fil) →
    artinConductor perm12 D = artinConductor r3 D * artinConductor r3b D * artinConductor r5 D := by
  intro D
  induction D with
  | nil => intro _; simp [artinConductor]
  | cons L t ih =>
      intro h
      have hL : Integral L.fil := h L (by simp)
      have ht : ∀ K ∈ t, Integral K.fil := fun K hK => h K (by simp [hK])
      simp only [artinConductor, List.map_cons, List.prod_cons] at ih ⊢
      rw [condExp_perm12 hL, ih ht, pow_add, pow_add]
      ring

/-- **The Artin factorisation of `ζ_N` at the level of conductors**:
`d_N = N(ρ₃)³ N(ρ₃′)³ N(ρ₄)⁴ N(ρ₅)⁵`, matching `A5Artin.regPoly_eq`. -/
theorem artinConductor_reg_eq : ∀ D : RamData, (∀ L ∈ D, Integral L.fil) →
    artinConductor reg D = artinConductor r3 D ^ 3 * artinConductor r3b D ^ 3
      * artinConductor r4 D ^ 4 * artinConductor r5 D ^ 5 := by
  intro D
  induction D with
  | nil => intro _; simp [artinConductor]
  | cons L t ih =>
      intro h
      have hL : Integral L.fil := h L (by simp)
      have ht : ∀ K ∈ t, Integral K.fil := fun K hK => h K (by simp [hK])
      simp only [artinConductor, List.map_cons, List.prod_cons] at ih ⊢
      rw [condExp_reg hL, ih ht, pow_add, pow_add, pow_add, pow_mul, pow_mul,
        pow_mul, pow_mul, mul_pow, mul_pow, mul_pow, mul_pow]
      ring

/-! ### The size of `N(ρ₅)` -/

/-- The excess of the conductor exponent of `ρ₅` over that of `ρ₄`; by
`codim_r5_sub_r4` it is supported on the primes whose ramification filtration
involves a group of order divisible by `3`. -/
def excessExp (F : Filt) : ℕ := condExp r5 F - condExp r4 F

/-- The extra factor by which `N(ρ₅)` exceeds `d_K`. -/
def excess (D : RamData) : ℕ := (D.map fun L => L.p ^ excessExp L.fil).prod

/-- **The second table identity**: `N(ρ₅) = d_K · (extra factor)`, the extra
factor being a product over the primes with `3`-divisible ramification. -/
theorem artinConductor_r5_eq_discK_mul_excess (D : RamData) :
    artinConductor r5 D = discK D * excess D := by
  rw [discK_eq_artinConductor_r4]
  induction D with
  | nil => simp [artinConductor, excess]
  | cons L t ih =>
      simp only [artinConductor, excess, List.map_cons, List.prod_cons] at ih ⊢
      have hle : condExp r4 L.fil ≤ condExp r5 L.fil := condExp_r4_le_r5 L.fil
      have : condExp r5 L.fil = condExp r4 L.fil + excessExp L.fil := by
        simp only [excessExp]; omega
      rw [this, ih, pow_add]
      ring

theorem discK_dvd_artinConductor_r5 (D : RamData) : discK D ∣ artinConductor r5 D :=
  ⟨excess D, artinConductor_r5_eq_discK_mul_excess D⟩

/-! ### The `C₅`-deficit: the size of `N(ρ₃)` inside `d_K`

The excess above compares `ρ₅` with `ρ₄` and is supported on the primes whose
filtration involves a group of order divisible by `3`.  The mirror-image
statement compares `ρ₃` with `ρ₄`: they agree away from inertia of order `5`
(`codim_r3_eq_r4`), and at `C₅` the invariants of `ρ₃` are larger, so `N(ρ₃)`
*divides* `d_K` with an explicit `C₅`-supported quotient. -/

theorem codim_r3_le_r4 (H : Subgp) : codim r3 H ≤ codim r4 H := by cases H <;> decide

/-- The deficit of `ρ₃` against `ρ₄` on invariants: it is nonzero exactly at
inertia of order `5`. -/
theorem codim_r4_sub_r3 (H : Subgp) :
    codim r4 H - codim r3 H = (if H = .C5 then 2 else 0) := by cases H <;> rfl

theorem condExp_r3_le_r4 (F : Filt) : condExp r3 F ≤ condExp r4 F :=
  condExp_mono F codim_r3_le_r4

/-- The `C₅`-deficit of the conductor exponent of `ρ₃` against that of `ρ₄`;
by `codim_r4_sub_r3` it is supported on the primes whose ramification
filtration involves a group of order `5`. -/
def deficitExp (F : Filt) : ℕ := condExp r4 F - condExp r3 F

/-- The factor by which `d_K` exceeds `N(ρ₃)`. -/
def deficit (D : RamData) : ℕ := (D.map fun L => L.p ^ deficitExp L.fil).prod

/-- **The unconditional comparison of `N(ρ₃)` and `N(ρ₄) = d_K`**:
`d_K = N(ρ₃) · (C₅-supported factor)`.  No hypothesis on the ramification is
needed; `deficit_eq_one` shows the extra factor is trivial exactly in the
situation of `artinConductor_three_eq_discK`. -/
theorem discK_eq_artinConductor_r3_mul_deficit (D : RamData) :
    discK D = artinConductor r3 D * deficit D := by
  rw [discK_eq_artinConductor_r4]
  induction D with
  | nil => simp [artinConductor, deficit]
  | cons L t ih =>
      simp only [artinConductor, deficit, List.map_cons, List.prod_cons] at ih ⊢
      have hle : condExp r3 L.fil ≤ condExp r4 L.fil := condExp_r3_le_r4 L.fil
      have hsplit : condExp r4 L.fil = condExp r3 L.fil + deficitExp L.fil := by
        simp only [deficitExp]; omega
      rw [hsplit, ih, pow_add]
      ring

theorem artinConductor_r3_dvd_discK (D : RamData) : artinConductor r3 D ∣ discK D :=
  ⟨deficit D, discK_eq_artinConductor_r3_mul_deficit D⟩

/-- The `C₅`-deficit is trivial exactly when no inertia group of order `5`
occurs — the hypothesis under which `N(ρ₃) = N(ρ₃′) = N(ρ₄) = d_K`. -/
theorem deficit_eq_one {D : RamData} (h : ∀ L ∈ D, Subgp.C5 ∉ L.fil.groups) :
    deficit D = 1 := by
  simp only [deficit]
  refine List.prod_eq_one ?_
  intro x hx
  simp only [List.mem_map] at hx
  obtain ⟨L, hL, rfl⟩ := hx
  have : deficitExp L.fil = 0 := by
    simp only [deficitExp, condExp_r3_eq_r4 (h L hL)]
    omega
  simp [this]

theorem codim_r5_eq_r4 {H : Subgp} (h3 : H ≠ .C3) (hs : H ≠ .S3) :
    codim r5 H = codim r4 H := by
  cases H <;> simp_all <;> rfl

/-- `N(ρ₅) = d_K` exactly in the situation described in the report: when no
group of the ramification filtration has order divisible by `3`. -/
theorem artinConductor_r5_eq_discK {D : RamData}
    (h : ∀ L ∈ D, ∀ H ∈ L.fil.groups, H ≠ Subgp.C3 ∧ H ≠ Subgp.S3) :
    artinConductor r5 D = discK D := by
  rw [discK_eq_artinConductor_r4]
  refine artinConductor_congr D fun L hL => condExp_congr L.fil fun H hH => ?_
  exact codim_r5_eq_r4 (h L hL H hH).1 (h L hL H hH).2

/-! ## 6. The filtrations that occur, and the numerical tables

The fifteen smallest totally real `A₅` quintic fields (Section 2 of
`docs/A5_even_Artin.md`) use only the five filtrations below.  The exponents
recorded in `condExp_tameC2` … `condExp_wildV4` are exactly the entries of the
`cond_exp` tables in `data/a5/catalog.json`. -/

/-- Tame inertia of order 2. -/
def tameC2 : Filt := ⟨.C2, []⟩

/-- Tame inertia of order 3. -/
def tameC3 : Filt := ⟨.C3, []⟩

/-- Wild inertia of order 3 at `p = 3` with a single jump (`v₃(d_K) = 4`). -/
def wildC3 : Filt := ⟨.C3, [.C3]⟩

/-- Inertia `S₃` at `p = 3` with wild part `C₃` and a single jump
(`v₃(d_K) = 4`). -/
def wildS3 : Filt := ⟨.S3, [.C3]⟩

/-- Inertia `V₄` at `p = 2` with filtration `V₄ ⊇ V₄ ⊇ C₂ ⊇ C₂ ⊇ 1`
(`v₂(d_K) = 8`). -/
def wildV4 : Filt := ⟨.V4, [.V4, .C2, .C2]⟩

theorem condExp_tameC2 :
    condExp r1 tameC2 = 0 ∧ condExp r3 tameC2 = 2 ∧ condExp r3b tameC2 = 2 ∧
      condExp r4 tameC2 = 2 ∧ condExp r5 tameC2 = 2 := by decide

theorem condExp_tameC3 :
    condExp r1 tameC3 = 0 ∧ condExp r3 tameC3 = 2 ∧ condExp r3b tameC3 = 2 ∧
      condExp r4 tameC3 = 2 ∧ condExp r5 tameC3 = 4 := by decide

theorem condExp_wildC3 :
    condExp r1 wildC3 = 0 ∧ condExp r3 wildC3 = 4 ∧ condExp r3b wildC3 = 4 ∧
      condExp r4 wildC3 = 4 ∧ condExp r5 wildC3 = 8 := by decide

theorem condExp_wildS3 :
    condExp r1 wildS3 = 0 ∧ condExp r3 wildS3 = 4 ∧ condExp r3b wildS3 = 4 ∧
      condExp r4 wildS3 = 4 ∧ condExp r5 wildS3 = 6 := by decide

theorem condExp_wildV4 :
    condExp r1 wildV4 = 0 ∧ condExp r3 wildV4 = 8 ∧ condExp r3b wildV4 = 8 ∧
      condExp r4 wildV4 = 8 ∧ condExp r5 wildV4 = 8 := by decide

/-- All five filtrations satisfy the integrality condition, so the identities
`condExp_perm12` and `condExp_reg` apply to them. -/
theorem integral_of_occurring :
    Integral tameC2 ∧ Integral tameC3 ∧ Integral wildC3 ∧ Integral wildS3
      ∧ Integral wildV4 := by decide

/-- The ramification data of the fifteen smallest totally real `A₅` quintic
fields, together with `d_K` and `N(ρ₅)` as listed in `docs/A5_even_Artin.md`.

**What is and is not asserted.**  The entries below are *input data*, not
theorems: for each field, the list of ramified primes and the isomorphism type
of the higher ramification filtration at each of them is recorded by hand.  The
tame filtrations are determined by the factorisation type of the prime, while
the wild ones (`wildC3`, `wildS3`, `wildV4` at `p = 2, 3`) were *inferred* from
the known valuation `v_p(d_K)` of the discriminant rather than computed from
the field.  Consequently `table_conductors`, `table_integral` and
`table_no_C5` are conditional statements: they say that *if* the filtrations
are the ones listed, *then* the formal conductors take the stated values. -/
def table : List (RamData × ℕ × ℕ) :=
  [ ([⟨2, tameC3⟩, ⟨881, tameC3⟩], 3104644, 9638814366736),
    ([⟨3, wildC3⟩, ⟨11, tameC3⟩, ⟨23, tameC2⟩], 5184729, 50815528929),
    ([⟨2, tameC3⟩, ⟨17, tameC3⟩, ⟨73, tameC3⟩], 6160324, 37949591784976),
    ([⟨2, tameC3⟩, ⟨11, tameC3⟩, ⟨113, tameC3⟩], 6180196, 38194822598416),
    ([⟨3, tameC2⟩, ⟨883, tameC3⟩], 7017201, 5471234430489),
    ([⟨2, tameC3⟩, ⟨1361, tameC3⟩], 7409284, 54897489392656),
    ([⟨2, tameC3⟩, ⟨11, tameC3⟩, ⟨131, tameC3⟩], 8305924, 68988373493776),
    ([⟨3, wildS3⟩, ⟨5, tameC2⟩, ⟨73, tameC3⟩], 10791225, 517557942225),
    ([⟨23, tameC3⟩, ⟨149, tameC3⟩], 11744329, 137929263660241),
    ([⟨7, tameC2⟩, ⟨491, tameC3⟩], 11812969, 2847882379489),
    ([⟨31, tameC2⟩, ⟨113, tameC3⟩], 12271009, 156688513921),
    ([⟨2, tameC3⟩, ⟨13, tameC3⟩, ⟨139, tameC2⟩], 13060996, 8829233296),
    ([⟨3, tameC2⟩, ⟨19, tameC3⟩, ⟨67, tameC3⟩], 14584761, 23635028158569),
    ([⟨29, tameC3⟩, ⟨137, tameC3⟩], 15784729, 249157669603441),
    ([⟨2, wildV4⟩, ⟨11, tameC3⟩, ⟨23, tameC3⟩], 16386304, 1048870932736) ]

/-- **Verification against the numerical tables.**  For each of the fifteen
fields, the formally defined conductors reproduce the numbers used in the
holomorphy tests: `d_K = N(ρ₃) = N(ρ₃′) = N(ρ₄)` is the listed discriminant
and `N(ρ₅)` is the listed (much larger) conductor. -/
theorem table_conductors : ∀ e ∈ table,
    discK e.1 = e.2.1 ∧ artinConductor r3 e.1 = e.2.1 ∧ artinConductor r3b e.1 = e.2.1 ∧
      artinConductor r4 e.1 = e.2.1 ∧ artinConductor r5 e.1 = e.2.2 := by decide

/-- Every filtration occurring in the table is integral, so the identities of
Section 5 apply verbatim to these fields. -/
theorem table_integral : ∀ e ∈ table, ∀ L ∈ e.1, Integral L.fil := by decide

/-- No inertia group of order `5` occurs in the table, so
`artinConductor_three_eq_discK` applies to every one of the fifteen fields. -/
theorem table_no_C5 : ∀ e ∈ table, ∀ L ∈ e.1, Subgp.C5 ∉ L.fil.groups := by decide

end A5Artin
