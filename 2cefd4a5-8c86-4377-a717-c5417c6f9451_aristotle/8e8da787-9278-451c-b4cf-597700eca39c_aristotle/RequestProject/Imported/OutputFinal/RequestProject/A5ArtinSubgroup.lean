import RequestProject.Imported.OutputFinal.RequestProject.A5ArtinConductor
import RequestProject.Imported.OutputFinal.RequestProject.A5ArtinPerm

/-!
# Grounding `Subgp` in genuine subgroups of `A₅`

`RequestProject/A5ArtinConductor.lean` describes the groups occurring in a
higher ramification filtration of an `A₅`-extension only through the data that
the conductor formula sees: their order (`Subgp.card`) and the number of their
elements in each conjugacy class of `A₅` (`Subgp.count`).

This file exhibits, for each constructor of `Subgp`, an explicit subgroup of
`Equiv.Perm (Fin 5)` generated by the conjugacy-class representatives of
`RequestProject/A5ArtinPerm.lean`, and *proves* that hand-written table:

* `Subgp.toSubgroup` — the subgroup, given by its explicit element list
  `Subgp.elems`;
* `Subgp.closure_gens` — it is the subgroup generated by the advertised
  generators (`{1}`, `⟨(0 1)(2 3)⟩`, `⟨(0 1 2)⟩`, `⟨finRotate 5⟩`,
  `⟨(0 1)(2 3), (0 2)(1 3)⟩`, `⟨(0 1 2), (0 1)(3 4)⟩`);
* `Subgp.toSubgroup_le_alternatingGroup` — each of them lies in `A₅`;
* `Subgp.card_toSubgroup` — its order is `Subgp.card`;
* `Subgp.count_eq_card_filter` — `Subgp.count H c` is the number of its
  elements lying in the `A₅`-conjugacy class of `A5Artin.rep c`.

Consequently the count table, and with it the whole codimension/conductor
table, is a theorem about genuine subgroups of a genuine `A₅`.
-/

namespace A5Artin

open Equiv Cls

set_option maxRecDepth 100000

/-! ## 1. The alternating group and its conjugacy classes as `Finset`s -/

/-- `A₅ ⊆ S₅` as a `Finset` of permutations. -/
def A5finset : Finset (Perm (Fin 5)) :=
  Finset.univ.filter fun g => Equiv.Perm.sign g = 1

theorem mem_A5finset {g : Perm (Fin 5)} :
    g ∈ A5finset ↔ g ∈ alternatingGroup (Fin 5) := by
  simp [A5finset, Equiv.Perm.mem_alternatingGroup]

theorem card_A5finset : A5finset.card = 60 := by decide

/-- The `A₅`-conjugacy class of the representative `rep c`, as a `Finset`. -/
def clsFinset (c : Cls) : Finset (Perm (Fin 5)) :=
  A5finset.image fun g => g * rep c * g⁻¹

theorem mem_clsFinset {c : Cls} {x : Perm (Fin 5)} :
    x ∈ clsFinset c ↔ ∃ g ∈ alternatingGroup (Fin 5), g * rep c * g⁻¹ = x := by
  simp [clsFinset, mem_A5finset]

/-- The `Finset` `clsFinset c` really is the conjugacy class of `repA c` inside the
group `A₅` itself. -/
theorem mem_clsFinset_iff_isConj {c : Cls} {x : Perm (Fin 5)}
    (hx : x ∈ alternatingGroup (Fin 5)) :
    x ∈ clsFinset c ↔ IsConj (repA c) (⟨x, hx⟩ : alternatingGroup (Fin 5)) := by
  rw [mem_clsFinset, isConj_iff]
  constructor
  · rintro ⟨g, hg, rfl⟩
    exact ⟨⟨g, hg⟩, by ext; simp [repA]⟩
  · rintro ⟨u, hu⟩
    exact ⟨(u : Perm (Fin 5)), u.2, by simpa [repA] using congrArg Subtype.val hu⟩

/-- The conjugacy classes have the sizes recorded in `A5Artin.classSize`. -/
theorem card_clsFinset (c : Cls) : (clsFinset c).card = classSize c := by
  cases c <;> decide

/-! ## 2. The subgroups -/

/-- The second generator of the Klein four group `V₄ = ⟨(0 1)(2 3), (0 2)(1 3)⟩`. -/
def v4gen : Perm (Fin 5) := Equiv.swap 0 2 * Equiv.swap 1 3

/-- The involution `(0 1)(3 4)`, second generator of `S₃ = ⟨(0 1 2), (0 1)(3 4)⟩`. -/
def s3gen : Perm (Fin 5) := Equiv.swap 0 1 * Equiv.swap 3 4

namespace Subgp

/-- The elements of the subgroup attached to each `Subgp`. -/
def elems : Subgp → Finset (Perm (Fin 5))
  | triv => {1}
  | C2 => {1, rep c2}
  | C3 => {1, rep c3, rep c3 ^ 2}
  | C5 => {1, rep c5A, rep c5A ^ 2, rep c5A ^ 3, rep c5A ^ 4}
  | V4 => {1, rep c2, v4gen, rep c2 * v4gen}
  | S3 => {1, rep c3, rep c3 ^ 2, s3gen, rep c3 * s3gen, rep c3 ^ 2 * s3gen}

/-- The advertised generators. -/
def gens : Subgp → Set (Perm (Fin 5))
  | triv => ∅
  | C2 => {rep c2}
  | C3 => {rep c3}
  | C5 => {rep c5A}
  | V4 => {rep c2, v4gen}
  | S3 => {rep c3, s3gen}

theorem one_mem_elems (H : Subgp) : (1 : Perm (Fin 5)) ∈ H.elems := by
  cases H <;> decide

theorem mul_mem_elems (H : Subgp) : ∀ a ∈ H.elems, ∀ b ∈ H.elems, a * b ∈ H.elems := by
  cases H <;> decide

theorem inv_mem_elems (H : Subgp) : ∀ a ∈ H.elems, a⁻¹ ∈ H.elems := by
  cases H <;> decide

/-- The subgroup of `Equiv.Perm (Fin 5)` attached to each constructor of `Subgp`. -/
def toSubgroup (H : Subgp) : Subgroup (Perm (Fin 5)) where
  carrier := ↑H.elems
  mul_mem' {a b} ha hb := by
    simp only [Finset.mem_coe] at *
    exact H.mul_mem_elems a ha b hb
  one_mem' := by simpa using H.one_mem_elems
  inv_mem' {a} ha := by
    simp only [Finset.mem_coe] at *
    exact H.inv_mem_elems a ha

@[simp] theorem mem_toSubgroup {H : Subgp} {x : Perm (Fin 5)} :
    x ∈ H.toSubgroup ↔ x ∈ H.elems := Iff.rfl

/-- Each of these subgroups consists of even permutations. -/
theorem toSubgroup_le_alternatingGroup (H : Subgp) :
    H.toSubgroup ≤ alternatingGroup (Fin 5) := by
  intro x hx
  rw [mem_toSubgroup] at hx
  rw [← mem_A5finset]
  revert hx
  revert x
  cases H <;> decide

/-- The order of the subgroup is the number `Subgp.card` used by the conductor formula. -/
theorem card_toSubgroup (H : Subgp) : Nat.card H.toSubgroup = H.card := by
  have : Nat.card H.toSubgroup = H.elems.card := by
    simp [toSubgroup, Nat.card_eq_fintype_card]
  rw [this]
  cases H <;> decide

/-- `Subgp.count H c` is the number of elements of the subgroup lying in the
`A₅`-conjugacy class of `rep c`: the hand-written count table is a theorem. -/
theorem count_eq_card_filter (H : Subgp) (c : Cls) :
    H.count c = (H.elems.filter fun x => x ∈ clsFinset c).card := by
  cases H <;> cases c <;> decide

/-- The advertised generators do lie in the subgroup. -/
theorem gens_subset_elems (H : Subgp) : ∀ g ∈ H.gens, g ∈ H.elems := by
  cases H
  · exact fun g hg => hg.elim
  · rintro g (rfl : g = rep c2); decide
  · rintro g (rfl : g = rep c3); decide
  · rintro g (rfl : g = rep c5A); decide
  · rintro g (rfl | rfl) <;> decide
  · rintro g (rfl | rfl) <;> decide

/-- Every element of the subgroup is a word in the advertised generators. -/
theorem elems_subset_closure (H : Subgp) :
    ∀ x ∈ H.elems, x ∈ Subgroup.closure H.gens := by
  have hmem : ∀ (K : Subgp), ∀ g ∈ K.gens, g ∈ Subgroup.closure K.gens :=
    fun _ _ hg => Subgroup.subset_closure hg
  cases H
  · intro x hx
    simp only [elems, Finset.mem_singleton] at hx
    subst hx; exact one_mem _
  · intro x hx
    have h2 : rep c2 ∈ Subgroup.closure (gens C2) := hmem _ _ rfl
    simp only [elems, Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with rfl | rfl
    · exact one_mem _
    · exact h2
  · intro x hx
    have h3 : rep c3 ∈ Subgroup.closure (gens C3) := hmem _ _ rfl
    simp only [elems, Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with rfl | rfl | rfl
    · exact one_mem _
    · exact h3
    · exact pow_mem h3 2
  · intro x hx
    have h5 : rep c5A ∈ Subgroup.closure (gens C5) := hmem _ _ rfl
    simp only [elems, Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with rfl | rfl | rfl | rfl | rfl
    · exact one_mem _
    · exact h5
    · exact pow_mem h5 2
    · exact pow_mem h5 3
    · exact pow_mem h5 4
  · intro x hx
    have ha : rep c2 ∈ Subgroup.closure (gens V4) := hmem _ _ (Or.inl rfl)
    have hb : v4gen ∈ Subgroup.closure (gens V4) := hmem _ _ (Or.inr rfl)
    simp only [elems, Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with rfl | rfl | rfl | rfl
    · exact one_mem _
    · exact ha
    · exact hb
    · exact mul_mem ha hb
  · intro x hx
    have hc : rep c3 ∈ Subgroup.closure (gens S3) := hmem _ _ (Or.inl rfl)
    have ht : s3gen ∈ Subgroup.closure (gens S3) := hmem _ _ (Or.inr rfl)
    simp only [elems, Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with rfl | rfl | rfl | rfl | rfl | rfl
    · exact one_mem _
    · exact hc
    · exact pow_mem hc 2
    · exact ht
    · exact mul_mem hc ht
    · exact mul_mem (pow_mem hc 2) ht

/-- The subgroups are generated by the advertised generators. -/
theorem closure_gens (H : Subgp) : Subgroup.closure H.gens = H.toSubgroup := by
  refine le_antisymm ?_ ?_
  · rw [Subgroup.closure_le]
    intro g hg
    exact H.gens_subset_elems g hg
  · intro x hx
    exact H.elems_subset_closure x hx

end Subgp

end A5Artin
