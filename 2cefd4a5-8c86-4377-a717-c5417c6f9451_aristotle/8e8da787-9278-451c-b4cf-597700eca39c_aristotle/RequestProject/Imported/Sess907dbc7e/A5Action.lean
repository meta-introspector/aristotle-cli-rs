import Mathlib
import RequestProject.Imported.Sess907dbc7e.BaryonOctet

/-!
# Exceptional Transitive A₅ ↪ S₆ via PSL(2, 𝔽₅)

## Overview

This file constructs the **exceptional transitive embedding** of A₅ into S₆
using the isomorphism A₅ ≅ PSL(2, 𝔽₅) acting on the projective line
𝐏¹(𝔽₅) = {0, 1, 2, 3, 4, ∞}.

The six points of 𝐏¹(𝔽₅) are identified with the six baryon-octet phases
(`Phase = Fin 6`) via the bijection

    0 ↔ 0,  1 ↔ 1,  2 ↔ 2,  3 ↔ 3,  4 ↔ 4,  ∞ ↔ 5.

### Generators (Möbius transformations)

| Name | Matrix               | Formula      | Cycle on Phase |
|------|----------------------|--------------|----------------|
| `S`  | `[[0, −1], [1, 0]]`  | `z ↦ −1/z`  | `(0 5)(1 4)`   |
| `T`  | `[[1,  1], [0, 1]]`  | `z ↦ z + 1` | `(0 1 2 3 4)`  |

These satisfy the presentation `⟨s, t ∣ s² = t⁵ = (st)³ = 1⟩` of A₅.
The subgroup they generate in S₆ has order 60, consists entirely of even
permutations, and acts **transitively** and **faithfully** on all six phases.

### Note on fixed points

Individual non-identity elements *may* fix individual phases (e.g. `T` fixes
phase 5 = ∞).  The action is therefore **not** fixed-point-free in the sense
that every non-identity element moves every point.  What distinguishes this
from the standard embedding is that **no phase is globally fixed** by the
whole group — the action is transitive.
-/

instance : Fact (Nat.Prime 5) := ⟨by decide⟩

/-! ## §1  The projective line 𝐏¹(𝔽₅) -/

/-- The projective line over 𝔽₅.  `none` represents the point at infinity (∞). -/
abbrev ProjLine : Type := Option (ZMod 5)

/-! ### Möbius action

For a matrix `[[a, b], [c, d]]` with `ad − bc ≠ 0` over 𝔽₅, the Möbius
(fractional-linear) transformation acts on 𝐏¹(𝔽₅) by:

* `some x ↦ some ((ax + b) / (cx + d))`  when `cx + d ≠ 0`
* `some x ↦ none`                          when `cx + d = 0`
* `none   ↦ some (a / c)`                  when `c ≠ 0`
* `none   ↦ none`                          when `c = 0`
-/

/-- Möbius-transformation data: a 2 × 2 matrix over 𝔽₅ with non-zero determinant. -/
structure MobiusData where
  a : ZMod 5
  b : ZMod 5
  c : ZMod 5
  d : ZMod 5
  det_ne : a * d - b * c ≠ 0

/-- The action of a Möbius transformation on 𝐏¹(𝔽₅). -/
def MobiusData.act (M : MobiusData) : ProjLine → ProjLine
  | some x => if M.c * x + M.d = 0 then none
              else some ((M.a * x + M.b) / (M.c * x + M.d))
  | none   => if M.c = 0 then none else some (M.a / M.c)

/-! ## §2  Bijection  𝐏¹(𝔽₅) ≃ Phase

Since `ZMod 5 = Fin 5`, the projective line `Option (ZMod 5) = Option (Fin 5)`
is in canonical bijection with `Fin 6` via `finSuccEquiv'`.
-/

/-- Canonical bijection `Phase ≃ ProjLine` sending `5 ↦ none` (∞) and
    `k < 5 ↦ some k`. -/
noncomputable def phaseEquivProjLine : Phase ≃ ProjLine :=
  finSuccEquiv' (5 : Fin 6)

/-! ## §3  PSL(2, 𝔽₅) generators as permutations of Phase -/

/-- Generator **S**: the involution `z ↦ −1/z`, acting as `(0 5)(1 4)` on Phase. -/
def pslS : Equiv.Perm Phase :=
  Equiv.swap (0 : Fin 6) 5 * Equiv.swap (1 : Fin 6) 4

/-- Generator **T**: the 5-cycle `z ↦ z + 1`, acting as `(0 1 2 3 4)` on Phase. -/
def pslT : Equiv.Perm Phase :=
  Equiv.swap (0 : Fin 6) 1 *
  Equiv.swap (1 : Fin 6) 2 *
  Equiv.swap (2 : Fin 6) 3 *
  Equiv.swap (3 : Fin 6) 4

/-- The Möbius data for S: matrix `[[0, 4], [1, 0]]` (note: `4 = −1` in 𝔽₅). -/
def mobiusS : MobiusData where
  a := 0; b := 4; c := 1; d := 0
  det_ne := by decide

/-- The Möbius data for T: matrix `[[1, 1], [0, 1]]`. -/
def mobiusT : MobiusData where
  a := 1; b := 1; c := 0; d := 1
  det_ne := by decide

/-! ## §4  The A₅ subgroup of S₆ -/

/-- The image of the exceptional embedding: the subgroup of `Perm Phase`
    generated by the two PSL(2, 𝔽₅) generators `S` and `T`. -/
def A5inS6 : Subgroup (Equiv.Perm Phase) :=
  Subgroup.closure {pslS, pslT}

/-! ## §5  Verification: generator relations -/

/-- S has order 2. -/
lemma pslS_sq : pslS ^ 2 = 1 := by decide

/-- T has order 5. -/
lemma pslT_pow5 : pslT ^ 5 = 1 := by decide

/-- ST has order 3, verifying the triangle-group presentation of A₅. -/
lemma pslST_pow3 : (pslS * pslT) ^ 3 = 1 := by decide

/-- S is an even permutation. -/
lemma pslS_even : Equiv.Perm.sign pslS = 1 := by decide

/-- T is an even permutation. -/
lemma pslT_even : Equiv.Perm.sign pslT = 1 := by decide

/-- S is in the alternating group on Fin 6. -/
lemma pslS_mem_alternating : pslS ∈ alternatingGroup (Fin 6) := by
  rw [Equiv.Perm.mem_alternatingGroup]
  exact pslS_even

/-- T is in the alternating group on Fin 6. -/
lemma pslT_mem_alternating : pslT ∈ alternatingGroup (Fin 6) := by
  rw [Equiv.Perm.mem_alternatingGroup]
  exact pslT_even

/-! ## §6  Transitivity -/

/-
The action of A₅ on Phase is **transitive**: every phase can be sent to
    every other phase by some group element.
-/
lemma A5_transitive (p q : Phase) :
    ∃ g ∈ A5inS6, g p = q := by
  revert p q;
  intro p q
  have h_exists_word : ∃ g : Equiv.Perm Phase, g ∈ Subgroup.closure {pslS, pslT} ∧ g p = q := by
    have h_exists_word : ∀ p : Phase, ∃ g : Equiv.Perm Phase, g ∈ Subgroup.closure {pslS, pslT} ∧ g 0 = p := by
      intro p
      by_cases hp : p = 0 ∨ p = 1 ∨ p = 2 ∨ p = 3 ∨ p = 4;
      · rcases hp with ( rfl | rfl | rfl | rfl | rfl );
        · exact ⟨ 1, Subgroup.one_mem _, rfl ⟩;
        · exact ⟨ pslT, Subgroup.subset_closure ( Set.mem_insert_of_mem _ ( Set.mem_singleton _ ) ), rfl ⟩;
        · exact ⟨ pslT * pslT, Subgroup.mul_mem _ ( Subgroup.subset_closure ( Set.mem_insert_of_mem _ ( Set.mem_singleton _ ) ) ) ( Subgroup.subset_closure ( Set.mem_insert_of_mem _ ( Set.mem_singleton _ ) ) ), by decide ⟩;
        · exact ⟨ pslT ^ 3, Subgroup.pow_mem _ ( Subgroup.subset_closure ( Set.mem_insert_of_mem _ ( Set.mem_singleton _ ) ) ) _, by decide ⟩;
        · exact ⟨ pslT ^ 4, Subgroup.pow_mem _ ( Subgroup.subset_closure ( Set.mem_insert_of_mem _ ( Set.mem_singleton _ ) ) ) _, by decide ⟩;
      · fin_cases p <;> simp_all +decide;
        exact ⟨ pslS, Subgroup.subset_closure ( Set.mem_insert _ _ ), by decide ⟩
    obtain ⟨ g₁, hg₁, hg₁' ⟩ := h_exists_word p
    obtain ⟨ g₂, hg₂, hg₂' ⟩ := h_exists_word q
    use g₂ * g₁⁻¹
    aesop
  exact h_exists_word

/-! ## §7  Faithfulness -/

/-
The action is **faithful**: the only element of `A5inS6` acting as the
    identity on all six phases is the identity permutation itself.
    (This is automatic since elements of `Perm Phase` *are* their action.)
-/
lemma A5_faithful (g : Equiv.Perm Phase) (_hg : g ∈ A5inS6)
    (hfix : ∀ p : Phase, g p = p) : g = 1 := by
  exact Equiv.Perm.ext hfix

/-! ## §8  No globally fixed phase -/

/-
No single phase is fixed by the entire group.
    This is the defining property that distinguishes the exceptional
    embedding from the standard one.
-/
lemma A5_no_global_fixed_point (p : Phase) :
    ∃ g ∈ A5inS6, g p ≠ p := by
  by_contra h;
  fin_cases p <;> simp_all +decide [ A5inS6 ];
  all_goals have := h _ ( Subgroup.subset_closure ( Set.mem_insert _ _ ) ) ; simp +decide at this;
  · exact absurd ( h ( pslT ) ( Subgroup.subset_closure ( Set.mem_insert_of_mem _ ( Set.mem_singleton _ ) ) ) ) ( by decide );
  · exact absurd ( h _ ( Subgroup.subset_closure ( Set.mem_insert_of_mem _ ( Set.mem_singleton _ ) ) ) ) ( by decide )

/-! ## §9  Corrected fixed-point statement

The original `A5_has_no_fixed_points` claimed that *every* non-identity
element moves *every* phase.  This is **false**: for example, `T = (0 1 2 3 4)`
fixes phase 5 = ∞.  39 of the 59 non-identity elements have at least one
fixed point.

The correct statements are:
* **Transitivity** (`A5_transitive`): the group orbit of every phase is all
  of `Phase`.
* **No global fixed point** (`A5_no_global_fixed_point`): no phase is fixed
  by the entire group.
-/

