/-! ## §10  The drop condition is intrinsic -/

/-- The drop condition depends only on `n`, not on any group element,
    so it is trivially preserved by every symmetry. -/
lemma A5_preserves_drop_condition (_g : Equiv.Perm Phase) (n : Nat) :
    dropTrigger n = dropTrigger n :=
  rfl