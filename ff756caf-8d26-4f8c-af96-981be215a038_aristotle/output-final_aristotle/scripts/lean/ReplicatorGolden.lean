/-
Generate `tests/data/replicator-golden.json`: worlds, the machine states a run
passes through, the tape after each generation of a colony — all computed by
the **Lean definitions** of `RequestProject/Anim/Replicator.lean`.

    bash scripts/gen-replicator-golden.sh

Everything printed here comes from `Hesper.Replicator.step`, `run`, `seed`,
`offspring` and `gen`: the very definitions the theorems in that file are about
(`copy_lt`, `untouched`, `child_is_organism`, `offspring_replicates`,
`gen_copies`).  `tests/node/test_replicator.mjs` replays the corpus through
`web/js/replicator.js` and requires exact agreement.

There is no floating point here: a tape is a function into `ℕ`, sampled over a
finite window, so the comparison is exact.
-/
import RequestProject.Anim.Replicator

open Hesper.Replicator

namespace ReplicatorGolden

def quoted (s : String) : String := "\"" ++ s ++ "\""

def joinWith (sep : String) (xs : List String) : String := String.intercalate sep xs

def jsonNats (xs : List Nat) : String := "[" ++ joinWith "," (xs.map toString) ++ "]"

/-- A tape read over a window `[0, w)`, which is what the runtime's array is. -/
def window (t : Tape) (w : Nat) : List Nat := (List.range w).map t

/-- An organism written into an empty world: its length in its first cell. -/
def place (at_ : Nat) (body : List Nat) : Tape :=
  fun i =>
    if i = at_ then body.length + 1
    else if at_ < i ∧ i - at_ - 1 < body.length then body.getD (i - at_ - 1) 0
    else 0

structure Case where
  name : String
  at_ : Nat
  body : List Nat
  width : Nat
  generations : Nat

def cases : List Case :=
  [ { name := "minimal", at_ := 0, body := [2], width := 12, generations := 3 },
    { name := "three", at_ := 1, body := [7, 3], width := 16, generations := 4 },
    { name := "offset", at_ := 4, body := [9, 1, 5], width := 24, generations := 3 },
    { name := "wide", at_ := 0, body := [4, 4, 2, 8, 1], width := 40, generations := 5 } ]

/-- The states a run passes through, as the window each one holds. -/
def runStates (t : Tape) (a w : Nat) : List (List Nat) :=
  let m := seed t a
  (List.range (m.left + 1)).map (fun k => window (run m k).tape w)

def caseJson (c : Case) : String :=
  let t := place c.at_ c.body
  let m := seed t c.at_
  let after := offspring t c.at_
  let gens := (List.range (c.generations + 1)).map
    (fun g => window (gen t c.at_ (t c.at_) g) c.width)
  "{" ++ joinWith "," [
    quoted "name" ++ ":" ++ quoted c.name,
    quoted "at" ++ ":" ++ toString c.at_,
    quoted "body" ++ ":" ++ jsonNats c.body,
    quoted "width" ++ ":" ++ toString c.width,
    quoted "length" ++ ":" ++ toString (t c.at_),
    quoted "left" ++ ":" ++ toString m.left,
    quoted "src" ++ ":" ++ toString m.src,
    quoted "dst" ++ ":" ++ toString m.dst,
    quoted "tape" ++ ":" ++ jsonNats (window t c.width),
    quoted "states" ++ ":[" ++ joinWith "," ((runStates t c.at_ c.width).map jsonNats) ++ "]",
    quoted "offspring" ++ ":" ++ jsonNats (window after c.width),
    quoted "childLength" ++ ":" ++ toString (after (c.at_ + t c.at_)),
    quoted "generations" ++ ":[" ++ joinWith "," (gens.map jsonNats) ++ "]"
  ] ++ "}"

def document : String :=
  "{\n" ++
  "  \"note\": \"generated by scripts/lean/ReplicatorGolden.lean from Hesper.Replicator\",\n" ++
  "  \"cases\": [" ++ joinWith ",\n    " (cases.map caseJson) ++ "]\n" ++
  "}\n"

def write : IO Unit := do
  IO.FS.createDirAll "tests/data"
  IO.FS.writeFile "tests/data/replicator-golden.json" document
  IO.println s!"wrote tests/data/replicator-golden.json ({cases.length} cases)"

end ReplicatorGolden

#eval ReplicatorGolden.write
