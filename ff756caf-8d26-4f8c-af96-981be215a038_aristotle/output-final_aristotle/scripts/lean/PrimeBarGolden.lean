/-
Generate `tests/data/primebar-golden.json`: the first bars of the prime bar
score, as the **Lean definitions** of `RequestProject/Anim/PrimeBar.lean` give
them.

    bash scripts/gen-primebar-golden.sh

Every chord, degree and pitch printed here is the value of `Hesper.PrimeBar.chord`,
`noteCount`, `degree`, `voice` and `bar` — the very definitions the theorems in
that file are about (`chord_mul`, `chord_injective`, `voice_injective_on_primes`,
`bar_injective`).  `tests/node/test_primebar.mjs` replays the corpus through
`web/js/primebar.js` and requires exact agreement.

There is no floating point in this corpus: a chord is a list of naturals and a
pitch is a MIDI number, so the comparison is exact rather than up to a
tolerance.  (The tuning that turns a MIDI number into a frequency is the only
real-valued step, and it lives in the runtime alone.)
-/
import RequestProject.Anim.PrimeBar

open Hesper.PrimeBar

namespace PrimeBarGolden

def quoted (s : String) : String := "\"" ++ s ++ "\""
def joinWith (sep : String) (xs : List String) : String := String.intercalate sep xs
def jsonNats (xs : List Nat) : String := "[" ++ joinWith "," (xs.map toString) ++ "]"

/-- The chord as a sorted list, the order the runtime produces. -/
def chordList (n : Nat) : List Nat := (chord n).sort (· ≤ ·)

def root : Nat := 48

def barJson (n : Nat) : String :=
  let c := chordList n
  "{" ++ joinWith "," [
    quoted "n" ++ ":" ++ toString n,
    quoted "chord" ++ ":" ++ jsonNats c,
    quoted "noteCount" ++ ":" ++ toString (noteCount n),
    quoted "notes" ++ ":" ++ jsonNats (c.map (voice root)),
    quoted "prime" ++ ":" ++ (if noteCount n == 1 then "true" else "false")
  ] ++ "}"

def primeJson (p : Nat) : String :=
  "{" ++ joinWith "," [
    quoted "p" ++ ":" ++ toString p,
    quoted "degree" ++ ":" ++ toString (degree p),
    quoted "voice" ++ ":" ++ toString (voice root p)
  ] ++ "}"

/-- The multiplicative law, checked on concrete pairs: the corpus records both
sides so the runtime has to agree with `chord_mul` on the nose. -/
def mulJson (m n : Nat) : String :=
  "{" ++ joinWith "," [
    quoted "m" ++ ":" ++ toString m,
    quoted "n" ++ ":" ++ toString n,
    quoted "product" ++ ":" ++ jsonNats (chordList (m * n)),
    quoted "union" ++ ":" ++ jsonNats ((chord m + chord n).sort (· ≤ ·))
  ] ++ "}"

def bars : List Nat := (List.range 96).map (fun i => i + 1)
def primes : List Nat := (List.range 60).filter Nat.Prime
def mulPairs : List (Nat × Nat) :=
  [(2, 3), (4, 9), (6, 35), (12, 12), (1, 17), (30, 77), (64, 81), (13, 13)]

def document : String :=
  "{\n" ++
  "  \"note\": \"generated by scripts/lean/PrimeBarGolden.lean from Hesper.PrimeBar\",\n" ++
  "  \"root\": " ++ toString root ++ ",\n" ++
  "  \"scale\": " ++ jsonNats ((List.range 7).map scaleStep) ++ ",\n" ++
  "  \"bars\": [" ++ joinWith ",\n    " (bars.map barJson) ++ "],\n" ++
  "  \"primes\": [" ++ joinWith ",\n    " (primes.map primeJson) ++ "],\n" ++
  "  \"mul\": [" ++ joinWith ",\n    " (mulPairs.map (fun p => mulJson p.1 p.2)) ++ "]\n" ++
  "}\n"

def write : IO Unit := do
  IO.FS.createDirAll "tests/data"
  IO.FS.writeFile "tests/data/primebar-golden.json" document
  IO.println s!"wrote tests/data/primebar-golden.json ({bars.length} bars, {primes.length} primes)"

end PrimeBarGolden

#eval PrimeBarGolden.write
