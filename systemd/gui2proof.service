[Unit]
Description=GUI2Proof Playwright proof capture service
Wants=network-online.target aristotle-manager.service
After=network-online.target aristotle-manager.service

[Service]
Type=simple
User=mdupont
Group=mdupont
WorkingDirectory=/mnt/data1/time-2026/05-may/07/arist
Environment=HOME=/home/mdupont
Environment=PATH=/home/mdupont/.elan/bin:/home/mdupont/.nix-profile/bin:/usr/local/bin:/usr/bin:/bin
Environment=GUI2LEAN4_PORT=9890
Environment=GUI2LEAN4_BASE_URL=https://aristotle-manager.pages.dev
Environment=GUI2LEAN4_PROOF_URL=http://127.0.0.1:9876/api/v3/project
EnvironmentFile=-/home/mdupont/.config/gui2proof/cloudflare.env
ExecStart=/home/mdupont/.nix-profile/bin/node gui2lean4/server.mjs
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
