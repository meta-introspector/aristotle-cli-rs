[Unit]
Description=GUI2Proof Playwright proof capture service
Wants=network-online.target aristotle-manager.service
After=network-online.target aristotle-manager.service

[Service]
Type=simple
User=mdupont
Group=mdupont
WorkingDirectory=/mnt/data1/time-2026/05-may/07/arist
Environment=HOME=/home/mdupont
Environment=PATH=/home/mdupont/.elan/bin:/home/mdupont/.nix-profile/bin:/usr/local/bin:/usr/bin:/bin
Environment=TRACKER_VAULT_DIR=/etc/tracker-vault
Environment=GUI2PROOF_CLOUDFLARE_SECRET=cloudflare-pages-token
Environment=GUI2PROOF_RUNTIME_ENV=/run/gui2proof/cloudflare.env
Environment=GUI2LEAN4_PORT=9890
Environment=GUI2LEAN4_BASE_URL=https://aristotle-manager.pages.dev
Environment=GUI2LEAN4_PROOF_URL=http://127.0.0.1:9876/api/v3/project
ExecStartPre=+/home/mdupont/.nix-profile/bin/node /mnt/data1/time-2026/05-may/07/arist/scripts/load-sops-cloudflare-env.mjs
ExecStart=/home/mdupont/.nix-profile/bin/node scripts/start-gui2proof.mjs
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
