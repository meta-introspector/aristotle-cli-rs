[Unit]
Description=Aristo local Lean proof evaluation server
Documentation=file:///mnt/data1/time-2026/05-may/07/arist/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mdupont
Group=mdupont
WorkingDirectory=/mnt/data1/time-2026/05-may/07/arist
Environment=HOME=/home/mdupont
Environment=PATH=/home/mdupont/.elan/bin:/home/mdupont/.nix-profile/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/mnt/data1/time-2026/05-may/07/arist/target/release/aristotle-manager serve --port 9876 --forward
Restart=on-failure
RestartSec=5s
KillSignal=SIGINT
TimeoutStopSec=15s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
