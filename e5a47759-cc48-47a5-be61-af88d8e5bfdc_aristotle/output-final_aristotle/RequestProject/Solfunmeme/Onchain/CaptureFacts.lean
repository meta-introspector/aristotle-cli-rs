import RequestProject.Solfunmeme.Onchain.Data.Captures
import RequestProject.Solfunmeme.Onchain.Proofs.Holders
import RequestProject.Solfunmeme.Onchain.Report
import RequestProject.Solfunmeme.Onchain.Rpc

/-!
# What the ingested captures actually say

`RequestProject.Onchain.Data.Captures` is a transcription of the JSON-RPC
captures shipped in `dataset/` (real) and `fixtures/` (synthetic), generated by
`scripts/onchain_facts.py`; `python3 scripts/onchain_facts.py --check` fails if
the transcription drifts from those files.  Everything below is therefore a
machine-checked statement about the bytes in the repository.

Two honesty notes carried over from the captures themselves:

* the `getSignaturesForAddress` capture is a **5-record excerpt** of a page of
  roughly a thousand records, so the activity numbers describe the excerpt;
* `fixtures/` is **synthetic**.  The holder distribution proved about below is a
  property of hand-written test data, not of the chain — its only purpose is to
  pin down what the ingestion pipeline does.

The one thing the real captures do *not* contain is a `getTokenLargestAccounts`
response (`dataset_has_no_largest_accounts`), which is exactly why no holder
report can be produced from the real data offline.

Statements that mention `String` machinery (the base-58 decoder, decimal
rendering, filename matching) or the sort are checked with `native_decide`,
because those definitions use well-founded recursion the kernel will not unfold;
the arithmetic that follows the sort is checked by the kernel.
`RequestProject.Onchain.AxiomAudit` records which is which.
-/

namespace Solana.CaptureFacts

open Solana.Captures
open Solana.Dataset
open Solana.Holders

/-! ## The real mint capture -/

/-- The two real captures are named as captures of `getAccountInfo` and
`getSignaturesForAddress` on the mint, per the dataset naming convention. -/
theorem dataset_files_are_captures_of_the_mint :
    isCaptureOf (accountInfo mint) datasetFiles[0]! = true ∧
      isCaptureOf (signaturesForAddress mint) datasetFiles[1]! = true := by
  native_decide

/-- No capture in `dataset/` is a `getTokenLargestAccounts` response, so the real
corpus cannot yield a holder distribution on its own. -/
theorem dataset_has_no_largest_accounts :
    ∀ n ∈ datasetFiles, isCaptureOf (tokenLargestAccounts mint) n = false := by
  native_decide

/-- The mint address the corpus is about is a syntactically valid Solana public
key: base-58 text decoding to exactly 32 bytes. -/
theorem mint_isValidPubkey : Solana.Base58.isValidPubkey mint = true := by
  native_decide

/-- The mint has no mint authority and no freeze authority: by the real capture,
the supply is fixed and no account can be frozen. -/
theorem mint_authorities_are_null :
    realMintAuthority = none ∧ realFreezeAuthority = none := ⟨rfl, rfl⟩

/-- The real capture's supply, rendered at the mint's own scale, is
`999906030.213118` tokens. -/
theorem realSupply_render :
    Solana.Decimal.render realSupply realDecimals = "999906030.213118" := by
  native_decide

/-- Rendering the real supply loses nothing: parsing the two digit groups back
recovers the raw amount exactly. -/
theorem realSupply_render_roundtrip :
    Solana.Decimal.parse
        ((Solana.Decimal.renderParts realSupply realDecimals).1
          ++ (Solana.Decimal.renderParts realSupply realDecimals).2)
      = some realSupply := by
  native_decide

/-! ## The real signature excerpt -/

/-- The excerpt has five records, three of which failed and two of which carry a
memo. -/
theorem realActivity_counts :
    (summarize realSignatures).total = 5 ∧
      (summarize realSignatures).failed = 3 ∧
      (summarize realSignatures).memoed = 2 := ⟨rfl, rfl, rfl⟩

/-- The excerpt spans four consecutive slots and two consecutive seconds. -/
theorem realActivity_ranges :
    (summarize realSignatures).slotRange = some (314266534, 314266537) ∧
      (summarize realSignatures).timeRange = some (1736991371, 1736991372) := ⟨rfl, rfl⟩

/-- Every record in the excerpt reports a block time, so the time range really
does cover all five. -/
theorem realSignatures_all_timed :
    ∀ r ∈ realSignatures, r.blockTime.isSome = true := by
  decide

/-! ## The synthetic fixtures pipeline

`fixtureSnapshot` is exactly what `Solana.Rpc.snapshotOfResults` builds from the
three synthetic captures: token accounts attributed to their owning wallets,
merged by wallet, sorted by balance. -/

/-- The snapshot the pipeline produces from `fixtures/`. -/
def fixtureSnapshot : Snapshot :=
  { mint := mint
    decimals := fixtureDecimals
    supply := fixtureSupply
    holders := sortedDesc (aggregate (fixtureAccounts.map Solana.Rpc.toHolder)) }

/-- The pipeline's output on the synthetic captures is the transcribed wallet
list: this is the one place the sort is evaluated, and every fact below is
kernel arithmetic over the result. -/
theorem fixtureSnapshot_holders : fixtureSnapshot.holders = fixtureHolders := by
  native_decide

/-- The transcribed wallet list is already in the pipeline's order. -/
theorem fixtureHolders_sortedDesc : sortedDesc fixtureHolders = fixtureHolders := by
  native_decide

/-- Six token accounts collapse to five wallets: two of the accounts share an
owner, so owner merging is genuinely exercised. -/
theorem fixture_merges_two_accounts :
    fixtureAccounts.length = 6 ∧ fixtureHolders.length = 5 := by
  decide

/-- Merging conserves the total: the five wallets hold exactly what the six
token accounts held, namely 385 000 000 tokens' worth of raw units. -/
theorem fixture_total_conserved :
    totalAmount fixtureHolders = (fixtureAccounts.map TokenAccountBalance.amount).sum ∧
      totalAmount fixtureHolders = 385000000000000 := by
  decide

/-- The wallet holding two accounts really is credited with the sum of both. -/
theorem fixture_shared_wallet_balance :
    ⟨"5Q544fKrFoe6tsEbD7S8EmxGTJYAKtTVhAW5Q5pge4j1", 135000000000000⟩ ∈ fixtureHolders := by
  decide

/-- The wallet list comes out sorted, largest first. -/
theorem fixture_holders_amounts :
    (fixtureHolders.map Holder.amount)
      = [150000000000000, 135000000000000, 60000000000000, 30000000000000, 10000000000000] := by
  decide

/-- The ingested share of the synthetic supply, exactly. -/
theorem fixture_ingested_share_eq :
    share (totalAmount fixtureHolders) fixtureSupply
      = (385000000000000 : Rat) / 999805262437066 := by
  have h : totalAmount fixtureHolders = 385000000000000 := by decide
  rw [share, if_neg (by decide : ¬ fixtureSupply = 0), h]
  norm_num [fixtureSupply]

/-- The ingested accounts cover a little over 38.5% of the synthetic supply —
between 38% and 39%. -/
theorem fixture_ingested_share_bounds :
    (19 : Rat) / 50 < share (totalAmount fixtureHolders) fixtureSupply ∧
      share (totalAmount fixtureHolders) fixtureSupply < (39 : Rat) / 100 := by
  rw [fixture_ingested_share_eq]
  constructor <;> norm_num

/-- The largest wallet's share of the synthetic supply, exactly. -/
theorem fixture_top1_share_eq :
    topKShare 1 fixtureHolders fixtureSupply = (150000000000000 : Rat) / 999805262437066 := by
  have h : topKAmount 1 fixtureHolders = 150000000000000 := by
    rw [topKAmount, fixtureHolders_sortedDesc]; decide
  rw [topKShare, h, share, if_neg (by decide : ¬ fixtureSupply = 0)]
  norm_num [fixtureSupply]

/-- The largest wallet holds a little over 15%. -/
theorem fixture_top1_share_bounds :
    (3 : Rat) / 20 < topKShare 1 fixtureHolders fixtureSupply ∧
      topKShare 1 fixtureHolders fixtureSupply < (151 : Rat) / 1000 := by
  rw [fixture_top1_share_eq]
  constructor <;> norm_num

/-- Beyond the five ingested wallets there is nothing more to add, so the
top-5, top-10 and top-20 shares coincide with the ingested share. -/
theorem fixture_topK_saturates :
    topKShare 5 fixtureHolders fixtureSupply = topKShare 10 fixtureHolders fixtureSupply ∧
      topKShare 10 fixtureHolders fixtureSupply = topKShare 20 fixtureHolders fixtureSupply ∧
      topKShare 20 fixtureHolders fixtureSupply
        = share (totalAmount fixtureHolders) fixtureSupply := by
  have h5 : topKAmount 5 fixtureHolders = totalAmount fixtureHolders := by
    rw [topKAmount, fixtureHolders_sortedDesc]; decide
  have h10 : topKAmount 10 fixtureHolders = totalAmount fixtureHolders := by
    rw [topKAmount, fixtureHolders_sortedDesc]; decide
  have h20 : topKAmount 20 fixtureHolders = totalAmount fixtureHolders := by
    rw [topKAmount, fixtureHolders_sortedDesc]; decide
  refine ⟨?_, ?_, ?_⟩ <;> simp only [topKShare, h5, h10, h20]

/-- The Herfindahl–Hirschman index of the ingested wallets is under 0.05. -/
theorem fixture_herfindahl_bound :
    herfindahl fixtureHolders fixtureSupply < (1 : Rat) / 20 := by
  norm_num [herfindahl, share, fixtureHolders, fixtureSupply]

/-- The ingested set never reaches half the supply, so it has no Nakamoto
coefficient — a fact about how little of the supply the top accounts cover, not
a defect of the metric. -/
theorem fixture_no_nakamoto : nakamoto fixtureHolders fixtureSupply = none := by
  refine nakamoto_eq_none_of_le_half ?_
  rw [fixture_ingested_share_eq]
  norm_num

/-- The synthetic supply renders as `999805262.437066`. -/
theorem fixtureSupply_render :
    Solana.Decimal.render fixtureSupply fixtureDecimals = "999805262.437066" := by
  native_decide

end Solana.CaptureFacts
