/-
  HyphaCategory.lean — hyphae as arrows, lineages as paths, certificates as
  dependent products.

  The signal formalised in `MycelialContinuum.lean` speaks of hyphae attaching
  strand to strand.  This module makes precise the reading asked for: a hypha
  is an *arrow*, a lineage is a *path* (a morphism of the free category on the
  web, exactly the composite of arrows one writes in category theory), and the
  certificate a hypha carries is a *dependent product* — UniMath's `∏`, the
  `mprod`-style former whose elements are functions taking a witness for each
  premise to a witness for the conclusion.

  The HoTT vocabulary is not decoration here.  A hypha `checks` precisely when
  its certificate's conclusion *equals* the strand attached; that equality is an
  identification, and the action of the hypha on witnesses is literally
  `transport` along it.  Composition of these transports along a lineage is
  functorial, so a family of witnesses over the strands (again a dependent
  product, `∀ x, Fib x`) that is invariant under every arrow is transported
  along every path — the lemma that the conformal solving in
  `ConformalEmbedding.lean` runs on.

  Contents.

  * `Arrow w a b` — a hypha of `w` presented as an arrow from `a` to `b`.
  * `Lineage w a b` — a path of arrows; `comp`, with identity and associativity.
  * `Category (Weave w)` — the free category on the web, so "hyphae are arrows"
    holds in the literal, Mathlib sense.
  * `Lineage.toList` / `chain_lineage` — paths agree with the `Web.Chain`
    predicate of the signal module, in both directions.
  * `Lineage.transport`, `transport_comp`, `transport_nil` — functoriality.
  * `Realizer` — the dependent-product reading of a certificate, and
    `Hypha.act`, which turns a realizer into an arrow action by transporting
    along the identification supplied by `Hypha.Checks`.
-/
import Mathlib.CategoryTheory.Category.Basic
import Mathlib.Tactic
import RequestProject.Solfunmeme.Signal.MycelialContinuum

universe u

namespace Mycelium

variable {S : Type}

/-! ## Arrows -/

/-- A hypha of `w`, presented as an arrow from `a` to `b`: the data of a hypha
    in the web together with the identifications of its endpoints. -/
structure Arrow (w : Web S) (a b : S) where
  /-- The underlying hypha. -/
  hypha : Hypha S
  /-- It is one of the web's hyphae. -/
  mem : hypha ∈ w.hyphae
  /-- Its source is the domain of the arrow. -/
  src : hypha.source = a
  /-- Its target is the codomain of the arrow. -/
  tgt : hypha.target = b

/-- Every arrow of a sound web checks. -/
theorem Arrow.checks {w : Web S} (hw : w.Sound) {a b : S} (e : Arrow w a b) : e.hypha.Checks :=
  (hw _ e.mem).1

/-- The arrow determined by a hypha of the web. -/
def Hypha.toArrow {w : Web S} {h : Hypha S} (hh : h ∈ w.hyphae) : Arrow w h.source h.target :=
  ⟨h, hh, rfl, rfl⟩

/-! ## Lineages: the free category on the web -/

/-- A lineage from `a` to `b`: a finite path of arrows.  This is the morphism
    type of the free category generated by the web's hyphae. -/
inductive Lineage (w : Web S) : S → S → Type where
  /-- The empty lineage: a strand is trivially continuous with itself. -/
  | nil {a : S} : Lineage w a a
  /-- Prefix an arrow to a lineage. -/
  | cons {a b c : S} : Arrow w a b → Lineage w b c → Lineage w a c

namespace Lineage

variable {w : Web S}

/-- The one-arrow lineage. -/
def single {a b : S} (e : Arrow w a b) : Lineage w a b := .cons e .nil

/-- Composition of lineages: continuity is transitive. -/
def comp : ∀ {a b c : S}, Lineage w a b → Lineage w b c → Lineage w a c
  | _, _, _, .nil, q => q
  | _, _, _, .cons e p, q => .cons e (comp p q)

@[simp] theorem nil_comp {a b : S} (p : Lineage w a b) : Lineage.nil.comp p = p := rfl

@[simp] theorem comp_nil {a b : S} (p : Lineage w a b) : p.comp .nil = p := by
  induction p with
  | nil => rfl
  | cons e p ih => simp [comp, ih]

theorem comp_assoc {a b c d : S} (p : Lineage w a b) (q : Lineage w b c) (r : Lineage w c d) :
    (p.comp q).comp r = p.comp (q.comp r) := by
  induction p with
  | nil => rfl
  | cons e p ih => simp [comp, ih]

/-- The number of arrows in a lineage. -/
def length : ∀ {a b : S}, Lineage w a b → Nat
  | _, _, .nil => 0
  | _, _, .cons _ p => p.length + 1

@[simp] theorem length_comp {a b c : S} (p : Lineage w a b) (q : Lineage w b c) :
    (p.comp q).length = p.length + q.length := by
  induction p with
  | nil => simp [comp, length]
  | cons e p ih => simp [comp, length, ih]; omega

/-- The underlying list of hyphae. -/
def toList : ∀ {a b : S}, Lineage w a b → List (Hypha S)
  | _, _, .nil => []
  | _, _, .cons e p => e.hypha :: p.toList

@[simp] theorem length_toList {a b : S} (p : Lineage w a b) : p.toList.length = p.length := by
  induction p with
  | nil => rfl
  | cons e p ih => simp [toList, length, ih]

end Lineage

/-- The strands of `w`, viewed as the objects of the free category on `w`. -/
def Weave (_w : Web S) : Type := S

/-- Hyphae really are arrows: the web generates a category whose objects are
    strands and whose morphisms are lineages. -/
instance weaveCategory (w : Web S) : CategoryTheory.Category (Weave w) where
  Hom a b := Lineage w a b
  id _ := Lineage.nil
  comp f g := Lineage.comp f g
  id_comp _ := rfl
  comp_id f := Lineage.comp_nil f
  assoc f g h := Lineage.comp_assoc f g h

@[simp] theorem weave_id (w : Web S) (a : Weave w) :
    CategoryTheory.CategoryStruct.id a = (Lineage.nil : Lineage w a a) := rfl

@[simp] theorem weave_comp {w : Web S} {a b c : Weave w} (p : Lineage w a b) (q : Lineage w b c) :
    CategoryTheory.CategoryStruct.comp (Z := c) p q = p.comp q := rfl

/-! ## Lineages agree with the signal's chains -/

variable {w : Web S}

/-- An arrow is a Σ-type (UniMath's `total2`): a hypha together with proofs that
    it lies in the web and has the prescribed endpoints. -/
def arrowEquivSigma (a b : S) :
    Arrow w a b ≃ {h : Hypha S // h ∈ w.hyphae ∧ h.source = a ∧ h.target = b} where
  toFun e := ⟨e.hypha, e.mem, e.src, e.tgt⟩
  invFun p := ⟨p.1, p.2.1, p.2.2.1, p.2.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

/-- A path of arrows is a chain of hyphae. -/
theorem lineage_chain {a b : S} (p : Lineage w a b) : w.Chain a p.toList b := by
  induction p with
  | nil => rfl
  | cons e p ih =>
    refine ⟨e.mem, e.src, ?_⟩
    rw [e.tgt]
    exact ih

/-- Conversely, a chain of hyphae assembles into a path of arrows. -/
theorem chain_lineage : ∀ {a b : S} {hs : List (Hypha S)}, w.Chain a hs b →
    Nonempty (Lineage w a b) := by
  intro a b hs
  induction hs generalizing a with
  | nil => rintro rfl; exact ⟨.nil⟩
  | cons g t ih =>
    rintro ⟨hg, hsrc, hrest⟩
    obtain ⟨p⟩ := ih hrest
    exact ⟨.cons ⟨g, hg, hsrc, rfl⟩ p⟩

/-- Every arrow of a lineage in a sound web carries its own proof. -/
theorem lineage_all_check (hw : w.Sound) {a b : S} (p : Lineage w a b) :
    ∀ h ∈ p.toList, h.Checks :=
  chain_all_check hw (lineage_chain p)

/-! ## Transport along arrows and along paths

A type family `Fib : S → Type` over the strands, together with an action of the
arrows on its fibres, is transported along every lineage; the transport is
functorial (`transport_nil`, `transport_comp`), which is precisely the statement
that a lineage is a morphism of the category above. -/

section Transport

variable {Fib : S → Type u}

/-- Transport of a fibre element along a lineage, given an action of the arrows. -/
def Lineage.transport (act : ∀ a b : S, Arrow w a b → Fib a → Fib b) :
    ∀ {a b : S}, Lineage w a b → Fib a → Fib b
  | _, _, .nil => id
  | _, _, .cons e p => fun x => Lineage.transport act p (act _ _ e x)

@[simp] theorem Lineage.transport_nil (act : ∀ a b : S, Arrow w a b → Fib a → Fib b) {a : S}
    (x : Fib a) : Lineage.transport act (Lineage.nil : Lineage w a a) x = x := rfl

/-- Functoriality: transport along a composite is the composite of transports. -/
theorem Lineage.transport_comp (act : ∀ a b : S, Arrow w a b → Fib a → Fib b)
    {a b c : S} (p : Lineage w a b) (q : Lineage w b c) (x : Fib a) :
    Lineage.transport act (p.comp q) x =
      Lineage.transport act q (Lineage.transport act p x) := by
  induction p with
  | nil => rfl
  | cons e p ih => simp [Lineage.comp, Lineage.transport, ih]

/-- The web's type family, packaged as a functor out of the free category: an
    object goes to its fibre and a lineage to transport along it.  This is the
    bundled form of "hyphae are arrows": functoriality *is* `transport_nil` and
    `transport_comp`. -/
def transportFunctor (Fib : S → Type u) (act : ∀ a b : S, Arrow w a b → Fib a → Fib b) :
    CategoryTheory.Functor (Weave w) (Type u) where
  obj x := Fib x
  map p := Lineage.transport act p
  map_id _ := by funext y; rfl
  map_comp p q := by funext y; exact Lineage.transport_comp act p q y

/-- A *section* of the family: an element of the dependent product `∏ x, Fib x`
    — UniMath's `∏`, the `mprod`-style former. -/
def Sections (Fib : S → Type u) : Type u := ∀ x : S, Fib x

/-- A section is *invariant* when every arrow carries its value at the source to
    its value at the target: a fixed point of the whole web of arrows. -/
def Invariant (act : ∀ a b : S, Arrow w a b → Fib a → Fib b) (s : Sections Fib) : Prop :=
  ∀ (a b : S) (e : Arrow w a b), act a b e (s a) = s b

/-- An invariant section is transported along every lineage: its value anywhere
    in the web is determined by its value at any strand a lineage starts from. -/
theorem invariant_transport {act : ∀ a b : S, Arrow w a b → Fib a → Fib b} {s : Sections Fib}
    (hs : Invariant act s) {a b : S} (p : Lineage w a b) :
    Lineage.transport act p (s a) = s b := by
  induction p with
  | nil => rfl
  | cons e p ih =>
    show Lineage.transport act p (act _ _ e (s _)) = s _
    rw [hs _ _ e]
    exact ih

end Transport

/-! ## Certificates as dependent products

A certificate names premises and a conclusion.  Its *realizer* is a dependent
function: given a witness for each premise, it produces a witness for the
conclusion.  This is the `∏` reading of a hypha, and it is where the arrow
comes from: `Hypha.Checks` supplies an identification `conclusion = target`,
and the arrow's action is the realizer followed by `transport` along that
identification (and preceded by transport along `p = source`, which `Checks`
guarantees is one of the premises). -/

section Realizers

variable {Fib : S → Type u}

/-- A realizer of a certificate: an element of the dependent product taking a
    witness for each premise to a witness for the conclusion. -/
def Realizer (Fib : S → Type u) (c : Certificate S) : Type u :=
  (∀ p ∈ c.premises, Fib p) → Fib c.conclusion

/-- The action of a checking hypha on witnesses: substitute the given witness at
    the premise that is the hypha's source, take the remaining premises from the
    ambient environment, run the realizer, and transport the result along the
    identification `conclusion = target` that checking provides. -/
def Hypha.act [DecidableEq S] {h : Hypha S} (hc : h.Checks) (R : Realizer Fib h.cert)
    (env : ∀ x, Fib x) : Fib h.source → Fib h.target := fun x =>
  cast (congrArg Fib hc.1)
    (R (fun p _ => if hp : p = h.source then cast (congrArg Fib hp.symm) x else env p))

/-- The environment is recovered at the source: feeding the ambient witness in
    is the same as not substituting at all. -/
theorem Hypha.act_env [DecidableEq S] {h : Hypha S} (hc : h.Checks) (R : Realizer Fib h.cert)
    (env : ∀ x, Fib x) :
    Hypha.act hc R env (env h.source) = cast (congrArg Fib hc.1) (R (fun p _ => env p)) := by
  unfold Hypha.act
  have hfun : (fun p (_ : p ∈ h.cert.premises) =>
      if hp : p = h.source then cast (congrArg Fib hp.symm) (env h.source) else env p)
      = (fun p (_ : p ∈ h.cert.premises) => env p) := by
    funext p hp
    by_cases hps : p = h.source
    · subst hps; simp
    · simp [hps]
  rw [hfun]

/-- Realizers for every hypha of the web, plus an ambient environment: the data
    that turns the web into a family of dependent products. -/
structure Interpretation (w : Web S) (Fib : S → Type u) where
  /-- A witness for every strand. -/
  env : ∀ x, Fib x
  /-- A realizer for every hypha's certificate. -/
  realize : ∀ h ∈ w.hyphae, Realizer Fib h.cert

/-- The arrow action induced by an interpretation of a sound web. -/
def Interpretation.act [DecidableEq S] {w : Web S} (hw : w.Sound)
    (I : Interpretation w Fib) : ∀ a b : S, Arrow w a b → Fib a → Fib b :=
  fun _ _ e x =>
    cast (congrArg Fib e.tgt)
      (Hypha.act (e.checks hw) (I.realize _ e.mem) I.env (cast (congrArg Fib e.src.symm) x))

/-- Interpretations transport along lineages, functorially: this is the
    dependent-product reading of the signal's claim that continuity composes. -/
theorem Interpretation.transport_comp [DecidableEq S] {w : Web S} (hw : w.Sound)
    (I : Interpretation w Fib) {a b c : S} (p : Lineage w a b) (q : Lineage w b c) (x : Fib a) :
    Lineage.transport (I.act hw) (p.comp q) x =
      Lineage.transport (I.act hw) q (Lineage.transport (I.act hw) p x) :=
  Lineage.transport_comp _ p q x

end Realizers

end Mycelium
