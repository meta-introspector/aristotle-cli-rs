import RequestProject.Relay.Bootstrap

/-!
# The seed of the bootstrap

The seed is the relay of length one: a single program, in a single language,
whose successor around the cycle is itself.  It is the smallest thing this
repository has that reads its own payload and reproduces itself byte for byte,
and it is the only program the bootstrap of `bootstrap.sh` starts from.

Everything here is a corollary of the general relay theorems in
`RequestProject.Relay.Core` and `RequestProject.Relay.Bootstrap`, specialised to
a one-stage relay: `seed_quine` is the quine property, `seed_step` is one relay
step (which for one stage is the same thing), `seed_cycle` closes the cycle, and
`seed_fixed_point` says the builder recovered from the seed's own payload,
applied to that payload, is the seed again.

This file is generated by `relay/mkseed.py`, which also writes the seed program
`relay/seed.py`; `lake exe quine-relay` writes the same bytes out of the blocks
below.
-/

namespace RequestProject.Relay

set_option maxRecDepth 1000000

/-- The seed — Python — `seed.py`: the code before the payload. -/
def seedPre : List Char := [
    'S', '=', '"']

/-- The seed — `seed.py`: the code after the payload. -/
def seedPost : List Char := [
    '"', '\n', 'D', '=', '"', '"', '.', 'j', 'o', 'i', 'n', '(', 'f', 'i', 'l', 't', 'e', 'r', '(', 
    's', 't', 'r', '.', 'i', 's', 'd', 'i', 'g', 'i', 't', ',', 'S', ')', ')', '\n', 'g', '=', '"', 
    '"', '.', 'j', 'o', 'i', 'n', '(', 'c', 'h', 'r', '(', 'i', 'n', 't', '(', 'D', '[', 'k', ':', 
    'k', '+', '3', ']', ')', ')', 'f', 'o', 'r', ' ', 'k', ' ', 'i', 'n', ' ', 'r', 'a', 'n', 'g', 
    'e', '(', '0', ',', 'l', 'e', 'n', '(', 'D', ')', ',', '3', ')', ')', '.', 's', 'p', 'l', 'i', 
    't', '(', 'c', 'h', 'r', '(', '1', ')', ')', '\n', 'p', 'r', 'i', 'n', 't', '(', 'g', '[', '0', 
    ']', '+', '"', '@', '"', '+', 'g', '[', '2', ']', '+', 'g', '[', '3', ']', '.', 'j', 'o', 'i', 
    'n', '(', '[', 'D', '[', 'k', ':', 'k', '+', '4', '0', '0', '0', ']', 'f', 'o', 'r', ' ', 'k', 
    ' ', 'i', 'n', ' ', 'r', 'a', 'n', 'g', 'e', '(', '0', ',', 'l', 'e', 'n', '(', 'D', ')', ',', 
    '4', '0', '0', '0', ')', ']', ')', '+', 'g', '[', '4', ']', '+', '"', '@', '"', '+', 'g', '[', 
    '1', ']', ',', 'e', 'n', 'd', '=', '"', '"', ')']

/-- The seed — `seed.py`: the notation it writes the payload in (a bare Python string literal: no decoration at all). -/
def seedShape : Shape where
  head := []
  glue := []
  tail := []

/-- The one stage of the seed. -/
def seedStage : StageSpec := ⟨seedPre, seedPost, seedShape⟩

/-- **The seed relay**: one stage, whose successor is itself. -/
def seed : Relay where
  stages := [seedStage]
  ne := by simp

/-- The seed relay has one stage. -/
theorem seed_size : seed.size = 1 := by decide

/-- The seed is a well-formed relay.  Checked by kernel computation. -/
theorem seed_wf : seed.WF :=
  Relay.wf_of_check (by decide)

/-- The text of the seed program. -/
def seedProgram : String := String.ofList (seed.prog 0)

/-- **The seed is a quine.** It prints itself, byte for byte. -/
theorem seed_quine : host 0 (seed.prog 0) = some (seed.prog 0) :=
  Relay.host_self seed_wf 0 (by decide)

/-- **One step of the seed relay** returns the seed program: with one stage, the
successor around the cycle is the program itself. -/
theorem seed_step : run seed.size 0 (seed.prog 0) = some (seed.prog 0) := by
  have h := Relay.run_prog seed_wf (R := seed) 0
  have e : (0 + 1) % seed.size = 0 := by decide
  rwa [e] at h

/-- **The seed cycle closes** after its one step. -/
theorem seed_cycle : runN seed.size seed.size 0 (seed.prog 0) = some (seed.prog 0) :=
  Relay.runN_size seed_wf 0 (by decide)

/-- **The seed is a bootstrap fixed point.** The builder read out of the seed's
own payload, applied to that payload, is the seed program again. -/
theorem seed_fixed_point : rebuild 0 (seed.prog 0) = some (seed.prog 0) :=
  Relay.rebuild_prog seed_wf 0 0 (by decide)

/-- The seed is 826 bytes long. -/
theorem seed_bytes : (seed.prog 0).length = 826 := by decide

end RequestProject.Relay
