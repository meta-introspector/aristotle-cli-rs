/-- Stage 21 — `stage23.wat`: the notation it writes the payload in. -/
def shape21 : Shape where
  head := []
  glue := [
    '"', '\n', ' ', ' ', ' ', ' ', '"']
  tail := []

/-- Stage 21 of the relay: RequestProject.Edge in WebAssembly (wat2wasm + node WASI). -/
def stage21 : StageSpec := ⟨pre21, post21, shape21⟩

/-- The stages of the relay, in the order it visits them. -/
def stageList : List StageSpec :=
  [stage0, stage1, stage2, stage3, stage4, stage5, stage6, stage7, stage8, stage9, stage10, stage11, stage12, stage13, stage14, stage15, stage16, stage17, stage18, stage19, stage20, stage21]

/-- The relay of all 22 stages. -/
def stages : Relay where
  stages := stageList
  ne := by simp [stageList]

set_option maxRecDepth 1000000 in
/-- The relay is well formed: every block is encodable, none contains the
separator, no code before a payload contains the marker, and every shape is
digit-free and marker-free.  Checked by kernel computation. -/
theorem stages_wf : stages.WF :=
  Relay.wf_of_check (by decide)

/-- The source text of the program of stage `i`. -/
def program (i : Nat) : String := String.ofList (stages.prog i)

/-- The number of stages. -/
theorem stages_size : stages.size = 22 := by decide

/-- **Hosting.** Every program of the relay prints the program of any stage. -/
theorem program_host (i j : Nat) (hj : j < stages.size) :
    host j (stages.prog i) = some (stages.prog j) :=
  Relay.host_prog stages_wf i j hj

/-- **The quine property.** Every program of the relay prints itself. -/
theorem program_self (i : Nat) (hi : i < stages.size) :
    host i (stages.prog i) = some (stages.prog i) :=
  Relay.host_self stages_wf i hi

/-- **One step.** Running a stage prints the next program of the cycle. -/
theorem program_step (i : Nat) :
    run stages.size i (stages.prog i) = some (stages.prog ((i + 1) % stages.size)) :=
  Relay.run_prog stages_wf i

/-- **The relay closes.** As many runs as there are stages return the program
you started from. -/
theorem relay_cycle (i : Nat) (hi : i < stages.size) :
    runN stages.size stages.size i (stages.prog i) = some (stages.prog i) :=
  Relay.runN_size stages_wf i hi

/-- Every program carries the source of every program: its payload decodes to
all the blocks of all the stages. -/
theorem program_carries_sources (i : Nat) :
    ((extract (stages.prog i)).map parseDigits |>.bind decode).map (splitOnChar sep)
      = some stages.blocks := by
  rw [Relay.extract_prog stages_wf i]
  simp [Relay.parse_prog stages_wf i, Relay.decode_digits stages_wf,
    Relay.split_data stages_wf]

/-- The file each stage is written to. -/
def fileName (i : Nat) : String :=
  ["stage00.js", "stage01.py", "stage03.pl", "stage04.awk", "stage05.rb", "stage06.lua", "stage07.php", "stage08.tcl", "stage09.scm", "stage10.c", "stage11.c", "stage12.ml", "stage13.el", "stage14.lisp", "stage15.rs", "stage16.hs", "stage17.go", "Stage18.java", "stage19.pl.pro", "stage20.R", "stage22.lean", "stage23.wat"].getD i "stage.txt"

/-- The command that runs each stage. -/
def command (i : Nat) : String :=
  ["node stage00.js", "python3 stage01.py", "perl stage03.pl", "awk -f stage04.awk", "ruby stage05.rb", "lua5.4 stage06.lua", "php stage07.php", "tclsh stage08.tcl", "guile-3.0 stage09.scm", "gcc -w -o s10 stage10.c && ./s10", "tcc -o s11 stage11.c && ./s11", "ocaml stage12.ml", "emacs --script stage13.el", "sbcl --script stage14.lisp", "rustc -A warnings -o s15 stage15.rs && ./s15", "runghc stage16.hs", "go run stage17.go", "java Stage18.java", "swipl --stack-limit=32g -q -g main -t halt stage19.pl.pro", "Rscript stage20.R", "lean --run stage22.lean", "wat2wasm stage23.wat -o s23.wasm && node run-wasm.js"].getD i "true"

