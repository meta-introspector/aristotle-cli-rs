/-- The WASI host that runs the WebAssembly stage. -/
def wasmHost : String :=
  "// WASI host for the WebAssembly stage of the quine relay.\n// Runs s23.wasm, whose only import is wasi_snapshot_preview1.fd_write.\nconst { WASI } = require(\"node:wasi\");\nconst { readFileSync } = require(\"node:fs\");\nconst wasi = new WASI({ version: \"preview1\", args: [], env: {}, returnOnExit: true });\nconst mod = new WebAssembly.Module(readFileSync(\"s23.wasm\"));\nconst inst = new WebAssembly.Instance(mod, wasi.getImportObject());\nwasi.start(inst);\n"

