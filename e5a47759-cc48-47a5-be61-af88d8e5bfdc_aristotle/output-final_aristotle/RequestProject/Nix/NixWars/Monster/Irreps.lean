/-! ## What the table says about itself, checked -/

/-- Pointwise `≤` on two exponent vectors, as a boolean. -/
def leAll (a b : List Nat) : Bool := (a.zip b).all (fun pe => decide (pe.1 ≤ pe.2))

/-- The natural number `∏ p ^ e` whose `p`-adic valuations are the row. -/
def rowValue (r : IrrepRow) : Nat :=
  ((monsterPrimes.zip r.exps).map (fun pe => pe.1 ^ pe.2)).prod

/-- The table has one row per irreducible character of the Monster. -/
theorem irrepRows_length : irrepRows.length = 194 := by decide

/-- Every row carries fifteen exponents, one per prime dividing `|M|`. -/
theorem exps_length : ∀ r ∈ irrepRows, r.exps.length = 15 := by decide

/-- The `row_exponent_sum` column really is the sum of the fifteen exponents. -/
theorem rowSum_correct : ∀ r ∈ irrepRows, r.exps.sum = r.rowSum := by decide

/-- The A001379 indices are pairwise distinct … -/
theorem idx_nodup : (irrepRows.map IrrepRow.idx).Nodup := by decide

/-- … and every index below `194` occurs, so the indices are exactly `0 … 193`. -/
theorem idx_covers :
    (List.range 194).all (fun n => irrepRows.any (fun r => decide (r.idx = n))) = true := by
  decide

/-- Every row is dominated by the exponent vector of `|M|`: the table is a set of
lattice points of the box `∏ p [0, e_p]`. -/
theorem exps_le_monsterExps : ∀ r ∈ irrepRows, leAll r.exps monsterExps = true := by decide

/-- Each of the fifteen bounds is attained by some row, so the box is the
smallest one containing the table. -/
theorem monsterExps_attained :
    (List.range 15).all
      (fun i => irrepRows.any (fun r => decide (r.exps.getD i 0 = monsterExps.getD i 0)))
      = true := by
  decide

/-- `monsterExps` is the exponent vector of the factorisation of `monsterOrder`
recorded in `Shards.lean`. -/
theorem monsterExps_prod :
    ((monsterPrimes.zip monsterExps).map (fun pe => pe.1 ^ pe.2)).prod = monsterOrder := by
  decide

/-- Equivalently: each row of the table names a divisor of `|M|`. -/
theorem rowValue_dvd_monsterOrder : ∀ r ∈ irrepRows, rowValue r ∣ monsterOrder := by decide

end Monster

