import RequestProject.Nix.Foundry.Challenge
import RequestProject.Nix.Foundry.Comms
import RequestProject.Nix.Foundry.Ingest

/-!
# The foundry's Nix modules

The half of the foundry emission that writes NixOS/system-manager modules: the
flake, the agents, the ingest service, the network, SELinux, telemetry, the
PBX, UUCP, radio, the secrets and the pipelines.  `Emit.lean` has the Rust
tool, the model as data, the writeup and the checks, and writes everything
out; the two files are split only so that neither is unmanageably long.
-/

set_option autoImplicit false
set_option maxRecDepth 40000

namespace NixWars
namespace Foundry
namespace Emit

/-! ## Small helpers -/

/-- A quoted string. -/
def q (s : String) : String := "\"" ++ s ++ "\""

/-- How many times a needle occurs in a haystack. -/
def occurrences (needle hay : String) : Nat := (hay.splitOn needle).length - 1

/-- A JSON string field. -/
def jf (k v : String) : String := q k ++ ": " ++ q v

/-- A JSON numeric field. -/
def jn (k : String) (v : Nat) : String := q k ++ ": " ++ toString v

/-- A JSON array of strings. -/
def jstrs (l : List String) : String := "[" ++ String.intercalate ", " (l.map q) ++ "]"

/-- A JSON array of numbers. -/
def jnats (l : List Nat) : String := "[" ++ String.intercalate ", " (l.map toString) ++ "]"

/-- Eight hexadecimal digits. -/
def hex8 (n : Nat) : String :=
  let d := fun (k : Nat) => "0123456789abcdef".toList.getD ((n / 16 ^ k) % 16) '0'
  String.ofList [d 7, d 6, d 5, d 4, d 3, d 2, d 1, d 0]

/-- The header every emitted file carries. -/
def header (comment : String) : String :=
  comment ++ " Generated by RequestProject/Foundry/Emit.lean from the Lean model.\n" ++
  comment ++ " Do not edit: edit the Lean and rebuild.\n"

/-! ## The flake -/

/-- `system/flake.nix`. -/
def flakeNix : String :=
  header "#" ++ r#"{
  description = "NIXWARS shard foundry: ingest more shards, run the agents, keep them apart";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    system-manager = {
      url = "github:numtide/system-manager";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    nora.url = "github:getnora/nora";
    sops-nix = {
      url = "github:Mic92/sops-nix";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    pipelight.url = "github:pipelight/pipelight";
    fenix = {
      url = "github:nix-community/fenix";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs = { self, nixpkgs, system-manager, nora, sops-nix, pipelight, fenix }:
    let
      system = "x86_64-linux";
      pkgs = nixpkgs.legacyPackages.system;
      toolchain = fenix.packages.system.stable;
    in {
      # The Ubuntu host is managed by system-manager, not by NixOS: the kernel,
      # apt and SELinux stay where they are, and everything below is a Nix
      # closure dropped beside them.
      systemConfigs.default = system-manager.lib.makeSystemConfig {
        modules = [
          sops-nix.nixosModules.sops
          ./modules/agents.nix
          ./modules/ingest.nix
          ./modules/network.nix
          ./modules/selinux.nix
          ./modules/telemetry.nix
          ./modules/voip.nix
          ./modules/uucp.nix
          ./modules/radio.nix
        ];
      };

      packages.system = {
        default = self.packages.system.shard-ingest;

        # The ingest tool. It has no dependencies at all: the SHA-256 in it was
        # emitted from the same Lean definition the board hashes with.
        shard-ingest = pkgs.rustPlatform.buildRustPackage {
          pname = "shard-ingest";
          version = "0.1.0";
          src = ./ingest;
          cargoLock.lockFile = ./ingest/Cargo.lock;
          doCheck = true;
          meta.description = "Walk a disk, hash every game, place it on the 71-shard ring";
        };
      };

      checks.system = {
        # cargo test, plus the tool's own self-test against the SHA-256 vectors
        ingest = self.packages.system.shard-ingest;
      };

      devShells.system.default = pkgs.mkShell {
        packages = [
          toolchain.toolchain
          pkgs.sops
          pkgs.age
          pkgs.wireguard-tools
          pkgs.asterisk
          pkgs.uucp
          pkgs.minimodem
          pkgs.direwolf
          pkgs.opentelemetry-collector-contrib
          pipelight.packages.system.default
          nora.packages.system.default
          system-manager.packages.system.system-manager
        ];
      };
    };
}
"#

/-! ## The agents module -/

/-- One agent's Unix account. -/
def userBlock (a : Agent) : String :=
  "    " ++ a.unixName ++ " = {\n" ++
  "      isNormalUser = true;\n" ++
  "      uid = " ++ toString a.uid ++ ";\n" ++
  "      group = \"nixwars\";\n" ++
  "      home = " ++ q a.home ++ ";\n" ++
  "      createHome = true;\n" ++
  "      shell = \"/usr/sbin/nologin\";\n" ++
  "      description = " ++ q a.role ++ ";\n" ++
  "    };\n"

/-- One agent's OpenTelemetry resource attributes, as one environment value. -/
def otelAttrs (a : Agent) : String :=
  String.intercalate "," (a.otelResource.map (fun p => p.1 ++ "=" ++ p.2))

/-- One agent's systemd service. -/
def agentService (a : Agent) : String :=
  "    \"nixwars-agent-" ++ a.handle ++ "\" = {\n" ++
  "      description = " ++ q ("NIXWARS agent " ++ a.handle ++ " — " ++ a.role) ++ ";\n" ++
  "      wantedBy = [ \"multi-user.target\" ];\n" ++
  "      serviceConfig = {\n" ++
  "        User = " ++ q a.unixName ++ ";\n" ++
  "        Group = \"nixwars\";\n" ++
  "        WorkingDirectory = " ++ q a.home ++ ";\n" ++
  "        StateDirectory = " ++ q ("nixwars/" ++ a.handle) ++ ";\n" ++
  "        ExecStart = \"/run/current-system/sw/bin/nixwars-agent --handle " ++ a.handle ++
      " --shard " ++ toString a.shard ++ " --zone " ++ a.zone.name ++ "\";\n" ++
  "        Environment = [ " ++ q ("OTEL_RESOURCE_ATTRIBUTES=" ++ otelAttrs a) ++ " " ++
      q ("OTEL_EXPORTER_OTLP_ENDPOINT=" ++ otelEndpoint) ++ " ];\n" ++
  "        SELinuxContext = " ++ q ("system_u:system_r:" ++ a.zone.selinuxType ++ ":s0") ++ ";\n" ++
  "        NoNewPrivileges = true;\n" ++
  "        PrivateTmp = true;\n" ++
  "        ProtectSystem = \"strict\";\n" ++
  "        ProtectHome = true;\n" ++
  "        RestrictAddressFamilies = [ \"AF_INET6\" \"AF_UNIX\" ];\n" ++
  "        Restart = \"on-failure\";\n" ++
  "      };\n" ++
  "    };\n"

/-- `system/modules/agents.nix`. -/
def agentsNix : String :=
  header "#" ++
  "# One account, one home, one unit per agent. Nothing is shared: the user ids\n" ++
  "# are 10000 + shard, and the shards are distinct (Fleet.uid_nodup).\n" ++
  "{ ... }:\n{\n" ++
  "  users.groups.nixwars = { gid = 10000; };\n\n" ++
  "  users.users = {\n" ++
  String.intercalate "\n" (fleet.map userBlock) ++
  "  };\n\n" ++
  "  systemd.services = {\n" ++
  String.intercalate "\n" (fleet.map agentService) ++
  "  };\n}\n"

/-! ## The ingest module -/

/-- `system/modules/ingest.nix`. -/
def ingestNix : String :=
  header "#" ++ r#"{ ... }:
{
  # The shelf of games, and the catalogue of record. The tool is idempotent
  # (Ingest.ingest_idem), so the timer can run as often as it likes.
  systemd.tmpfiles.rules = [
    "d /srv/nixwars/shelf 0750 nw-ingestor nixwars -"
    "d /srv/nixwars/catalog 0750 nw-curator nixwars -"
    "d /srv/nixwars/dropbox 0770 nw-courier nixwars -"
  ];

  systemd.services."nixwars-ingest" = {
    description = "Walk the shelf and file every game as a cartridge";
    serviceConfig = {
      Type = "oneshot";
      User = "nw-ingestor";
      Group = "nixwars";
      ExecStart = "/run/current-system/sw/bin/shard-ingest /srv/nixwars/shelf --catalog /srv/nixwars/catalog/catalog.json";
      SELinuxContext = "system_u:system_r:nixwars_lab_t:s0";
      ReadWritePaths = [ "/srv/nixwars/catalog" ];
      ReadOnlyPaths = [ "/srv/nixwars/shelf" ];
      NoNewPrivileges = true;
      PrivateNetwork = true;
    };
  };

  systemd.timers."nixwars-ingest" = {
    description = "Re-walk the shelf every fifteen minutes";
    wantedBy = [ "timers.target" ];
    timerConfig = {
      OnBootSec = "2min";
      OnUnitActiveSec = "15min";
      Unit = "nixwars-ingest.service";
    };
  };

  # A stick handed to the courier shows up here; ingest runs immediately.
  systemd.paths."nixwars-ingest" = {
    wantedBy = [ "paths.target" ];
    pathConfig = {
      DirectoryNotEmpty = "/srv/nixwars/dropbox";
      Unit = "nixwars-ingest.service";
    };
  };
}
"#

/-! ## The network module -/

/-- One WireGuard peer. -/
def wgPeer (a : Agent) : String :=
  "      { # " ++ a.handle ++ "\n" ++
  "        publicKey = " ++ q ("@WG_PUBKEY_" ++ a.handle ++ "@") ++ ";\n" ++
  "        allowedIPs = [ " ++ q (a.addr.toString ++ "/128") ++ " ];\n" ++
  "        persistentKeepalive = 25;\n" ++
  "      }\n"

/-- One address assignment. -/
def addrLine (a : Agent) : String :=
  "    \"" ++ a.unixName ++ " " ++ a.addr.toString ++ "/64 (" ++ a.zone.name ++ ")\""

/-- One nftables rule, from one flow of the policy. -/
def nftRule (p : Zone × Zone) : String :=
  "      ip6 saddr " ++ p.1.cidr ++ " ip6 daddr " ++ p.2.cidr ++ " accept comment " ++
    q (p.1.name ++ " -> " ++ p.2.name)

/-- `system/modules/network.nix`. -/
def networkNix : String :=
  header "#" ++
  "# IPv6 only, inside the site ULA. Each agent has one /128 of its zone's /64\n" ++
  "# (Fleet.addr_nodup), and the firewall is exactly the zone policy\n" ++
  "# (Zones.flowRules): four rules, and nothing at all to or from the air gap.\n" ++
  "{ ... }:\n{\n" ++
  "  networking.enableIPv6 = true;\n" ++
  "  networking.wireguard.interfaces.nixwars0 = {\n" ++
  "    ips = [ " ++ q ((zoneAddr .dmz 1).toString ++ "/48") ++ " ];\n" ++
  "    listenPort = 51820;\n" ++
  "    privateKeyFile = \"/run/secrets/wg/nixwars0.key\";\n" ++
  "    peers = [\n" ++
  String.intercalate "" (fleet.map wgPeer) ++
  "    ];\n" ++
  "  };\n\n" ++
  "  # the addresses, for the record\n" ++
  "  environment.etc.\"nixwars/addresses\".text = builtins.concatStringsSep \"\\n\" [\n" ++
  String.intercalate "\n" (fleet.map addrLine) ++ "\n  ];\n\n" ++
  "  networking.nftables.enable = true;\n" ++
  "  networking.nftables.ruleset = ''\n" ++
  "    table ip6 nixwars {\n" ++
  "      chain forward {\n" ++
  "        type filter hook forward priority 0; policy drop;\n" ++
  "        ct state established,related accept\n" ++
  String.intercalate "\n" (flowRules.map nftRule) ++ "\n" ++
  "      }\n" ++
  "    }\n" ++
  "  '';\n}\n"

/-! ## SELinux -/

/-- One SELinux allow rule. -/
def selinuxAllow (p : Zone × Zone) : String :=
  "    allow " ++ p.1.selinuxType ++ " " ++ p.2.selinuxType ++
    ":tcp_socket { name_connect connectto };"

/-- One SELinux type declaration. -/
def selinuxType (z : Zone) : String :=
  "    type " ++ z.selinuxType ++ "; # " ++ z.cidr

/-- `system/modules/selinux.nix`. -/
def selinuxNix : String :=
  header "#" ++
  "# The five zones as SELinux types, and the four allowed flows. The air gap\n" ++
  "# has no rule in either direction (Zones.airgap_isolated_in/out), which is\n" ++
  "# why the courier exists.\n" ++
  "{ ... }:\n{\n" ++
  "  environment.etc.\"selinux/nixwars.te\".text = ''\n" ++
  "    policy_module(nixwars, 1.0)\n\n" ++
  String.intercalate "\n" (zones.map selinuxType) ++ "\n\n" ++
  String.intercalate "\n" (flowRules.map selinuxAllow) ++ "\n" ++
  "  '';\n\n" ++
  "  # the file contexts of the shelf, the catalogue and the drop box\n" ++
  "  environment.etc.\"selinux/nixwars.fc\".text = ''\n" ++
  "    /srv/nixwars/shelf(/.*)?    gen_context(system_u:object_r:nixwars_lab_t,s0)\n" ++
  "    /srv/nixwars/catalog(/.*)?  gen_context(system_u:object_r:nixwars_vault_t,s0)\n" ++
  "    /srv/nixwars/dropbox(/.*)?  gen_context(system_u:object_r:nixwars_airgap_t,s0)\n" ++
  "  '';\n}\n"

/-! ## Telemetry -/

/-- `system/modules/telemetry.nix`. -/
def telemetryNix : String :=
  header "#" ++
  "# One collector in the lab. Every zone but the air gap can reach it\n" ++
  "# (Fleet.otel_reachable); the courier's spans travel on the stick.\n" ++
  "{ ... }:\n{\n" ++
  "  services.opentelemetry-collector.enable = true;\n" ++
  "  services.opentelemetry-collector.settings = {\n" ++
  "    receivers.otlp.protocols.grpc.endpoint = " ++
    q ("[" ++ (zoneAddr .lab 1).toString ++ "]:4317") ++ ";\n" ++
  "    receivers.otlp.protocols.http.endpoint = " ++
    q ("[" ++ (zoneAddr .lab 1).toString ++ "]:4318") ++ ";\n" ++
  "    processors.batch = { };\n" ++
  "    exporters.file.path = \"/var/log/nixwars/otel.jsonl\";\n" ++
  "    service.pipelines.traces = { receivers = [ \"otlp\" ]; processors = [ \"batch\" ];" ++
    " exporters = [ \"file\" ]; };\n" ++
  "    service.pipelines.metrics = { receivers = [ \"otlp\" ]; processors = [ \"batch\" ];" ++
    " exporters = [ \"file\" ]; };\n" ++
  "  };\n\n" ++
  "  environment.etc.\"nixwars/otel-resources\".text = ''\n" ++
  String.intercalate "\n" (fleet.map (fun a => "    " ++ a.serviceName ++ ": " ++ otelAttrs a)) ++
  "\n  '';\n}\n"

/-! ## The PBX -/

/-- One SIP endpoint. -/
def pjsipEndpoint (a : Agent) : String :=
  "    [" ++ a.handle ++ "]\n" ++
  "    type = endpoint\n" ++
  "    context = nixwars\n" ++
  "    callerid = " ++ a.handle ++ " <" ++ toString a.ext ++ ">\n" ++
  "    disallow = all\n" ++
  "    allow = ulaw,g722,t38\n" ++
  "    aors = " ++ a.handle ++ "\n"

/-- The two dial-plan lines of one agent: the voice extension and the fax. -/
def dialplanLines (a : Agent) : String :=
  "    exten => " ++ toString a.ext ++ ",1,Dial(PJSIP/" ++ a.handle ++ ",30) ; " ++
    a.handle ++ " " ++ a.did ++ "\n" ++
  "    exten => " ++ toString a.fax ++ ",1,ReceiveFAX(/srv/nixwars/fax/" ++ a.handle ++ ".tif)"

/-- `system/modules/voip.nix`. -/
def voipNix : String :=
  header "#" ++
  "# Every agent has a voice extension 70xx, a fax extension 71xx and a DID.\n" ++
  "# A voice extension is never a fax extension (Fleet.ext_ne_fax), and each\n" ++
  "# number rings exactly its own agent (Fleet.dial_ext, Fleet.dial_fax).\n" ++
  "{ ... }:\n{\n" ++
  "  services.asterisk.enable = true;\n" ++
  "  services.asterisk.confFiles.\"pjsip.conf\" = ''\n" ++
  String.intercalate "\n" (fleet.map pjsipEndpoint) ++
  "  '';\n\n" ++
  "  services.asterisk.confFiles.\"extensions.conf\" = ''\n" ++
  "    [nixwars]\n" ++
  String.intercalate "\n" (fleet.map dialplanLines) ++ "\n" ++
  "    exten => _X.,1,Hangup(1) ; nothing else rings\n" ++
  "  '';\n\n" ++
  "  environment.etc.\"nixwars/dids\".text = ''\n" ++
  String.intercalate "\n"
    (fleet.map (fun a => "    " ++ a.did ++ "  " ++ a.handle ++ "  ext " ++ toString a.ext ++
      "  fax " ++ toString a.fax ++ "  " ++ a.sip)) ++
  "\n  '';\n}\n"

/-! ## UUCP -/

/-- One UUCP `sys` stanza. -/
def uucpSys (i : Nat) : String :=
  let a := node i
  let nxt := node (uucpHop i)
  "    system " ++ a.uucp ++ "\n" ++
  "    call-login *\n" ++
  "    time any\n" ++
  "    forward-to " ++ nxt.uucp ++ "\n" ++
  "    address " ++ a.addr.toString ++ "\n"

/-- `system/modules/uucp.nix`. -/
def uucpNix : String :=
  header "#" ++
  "# The eight nodes are a ring; a job is forwarded until it arrives\n" ++
  "# (Comms.uucpRoute_arrives), never in more than seven hops.\n" ++
  "{ ... }:\n{\n" ++
  "  environment.etc.\"uucp/sys\".text = ''\n" ++
  String.intercalate "\n" ((List.range 8).map uucpSys) ++
  "  '';\n\n" ++
  "  environment.etc.\"uucp/routes\".text = ''\n" ++
  String.intercalate "\n"
    ((List.range 8).map (fun i => "    " ++ bangPath i ((i + 4) % 8) "spool")) ++
  "\n  '';\n}\n"

/-! ## Radio, morse and the dead drops -/

/-- One line of the band plan. -/
def bandLine (a : Agent) : String :=
  "    " ++ a.callsign ++ "  " ++ toString a.freqKHz ++ " kHz  " ++ a.handle ++
    "  (shard " ++ toString a.shard ++ ")"

/-- `system/modules/radio.nix`. -/
def radioNix : String :=
  header "#" ++
  "# Callsigns and CW frequencies, one per agent, all inside the 40-metre band\n" ++
  "# (Comms.freq_in_band, Comms.freq_nodup). The beacon keys the board's own\n" ++
  "# morse transport; the drops are one-time padded numbers-station traffic.\n" ++
  "{ ... }:\n{\n" ++
  "  environment.etc.\"nixwars/bandplan\".text = ''\n" ++
  String.intercalate "\n" (fleet.map bandLine) ++
  "\n  '';\n\n" ++
  "  systemd.services.\"nixwars-beacon\" = {\n" ++
  "    description = \"Key the board state as international morse\";\n" ++
  "    serviceConfig = {\n" ++
  "      Type = \"simple\";\n" ++
  "      User = \"nw-herald\";\n" ++
  "      ExecStart = \"/run/current-system/sw/bin/nixwars-beacon --wpm 18 --callsign W5HRL\";\n" ++
  "      SELinuxContext = \"system_u:system_r:nixwars_public_t:s0\";\n" ++
  "    };\n" ++
  "  };\n\n" ++
  "  systemd.services.\"nixwars-deaddrop\" = {\n" ++
  "    description = \"Collect the dead drops left on the shards\";\n" ++
  "    serviceConfig = {\n" ++
  "      Type = \"oneshot\";\n" ++
  "      User = \"nw-courier\";\n" ++
  "      ExecStart = \"/run/current-system/sw/bin/nixwars-drop --collect /srv/nixwars/dropbox\";\n" ++
  "      SELinuxContext = \"system_u:system_r:nixwars_airgap_t:s0\";\n" ++
  "      PrivateNetwork = true; # the air gap is an air gap\n" ++
  "    };\n" ++
  "  };\n}\n"

/-! ## Secrets -/

/-- One sops creation rule. -/
def sopsRule (a : Agent) : String :=
  "  - path_regex: " ++ a.secret ++ "\n" ++
  "    key_groups:\n" ++
  "      - age:\n" ++
  "          - *warden-master\n" ++
  "          - *agent-" ++ a.handle ++ "\n"

/-- One anchored age key. -/
def sopsKey (a : Agent) : String :=
  "  - &agent-" ++ a.handle ++ " age1" ++ hex8 (a.uid * 2654435761) ++
    "placeholderkeyfortheagent" ++ a.handle

/-- `system/secrets/.sops.yaml`. -/
def sopsYaml : String :=
  header "#" ++
  "# One secret per agent, readable by that agent and by the warden — who is\n" ++
  "# the agent on the crown shard, in the vault zone (Fleet.warden_on_crown).\n" ++
  "keys:\n" ++
  "  - &warden-master age1wardenplaceholderkeyreplacedatinstalltime\n" ++
  String.intercalate "\n" (fleet.map sopsKey) ++ "\n\n" ++
  "creation_rules:\n" ++
  String.intercalate "\n" (fleet.map sopsRule)

/-! ## Pipelight -/

/-- `system/pipelight.toml`. -/
def pipelightToml : String :=
  header "#" ++ r#"# Four pipelines. `pipelight run ingest` is the one that is pointed at a
# new pile of games; the others build, check and deploy the closure.

[[pipelines]]
name = "ingest"
[[pipelines.steps]]
name = "build the tool"
commands = ["nix build .#shard-ingest"]
[[pipelines.steps]]
name = "self-test the hash"
commands = ["./result/bin/shard-ingest --selftest"]
[[pipelines.steps]]
name = "walk the shelf"
commands = ["./result/bin/shard-ingest /srv/nixwars/shelf --catalog /srv/nixwars/catalog/catalog.json"]
[[pipelines.steps]]
name = "walk it again — nothing may change"
commands = [
  "cp /srv/nixwars/catalog/catalog.json /tmp/catalog.first.json",
  "./result/bin/shard-ingest /srv/nixwars/shelf --catalog /srv/nixwars/catalog/catalog.json",
  "diff /tmp/catalog.first.json /srv/nixwars/catalog/catalog.json",
]
[[pipelines.steps]]
name = "the toolchain-free fallback must agree"
commands = [
  "node ingest.mjs /srv/nixwars/shelf --catalog /tmp/catalog.node.json",
  "diff /tmp/catalog.node.json /srv/nixwars/catalog/catalog.json",
]

[[pipelines]]
name = "verify"
[[pipelines.steps]]
name = "the Lean development"
commands = ["lake build"]
[[pipelines.steps]]
name = "the emitted system"
commands = ["node system/selftest.mjs"]
[[pipelines.steps]]
name = "the agent cards, on the shipped wasm"
commands = ["node www/agent-play.mjs"]

[[pipelines]]
name = "deploy"
[[pipelines.steps]]
name = "decrypt the secrets"
commands = ["sops --decrypt --in-place secrets/agents"]
[[pipelines.steps]]
name = "switch the Ubuntu host"
commands = ["nix run github:numtide/system-manager -- switch --flake ."]

[[pipelines]]
name = "challenge"
[[pipelines.steps]]
name = "publish the board"
commands = ["cp challenges.json /srv/nixwars/catalog/challenges.json"]
[[pipelines.steps]]
name = "score the submissions"
commands = ["nixwars-referee --board /srv/nixwars/catalog/challenges.json --score"]
"#

end Emit
end Foundry
end NixWars
