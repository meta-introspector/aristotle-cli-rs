import RequestProject.Nix.Foundry.EmitModules

/-!
# Emitting the foundry: the flake, the units, the secrets, the tool

Everything under `system/` in this repository is written by this file. Nothing
there is hand-maintained: the users come from `fleet`, the addresses and the
firewall from `Zones`, the dial plan and the fax extensions from the agents'
shards, the SELinux allow rules from `flowRules`, the sops creation rules from
the agents' secret paths, the challenge board from `challenges`, and the Rust
ingest tool — round constants included — from `Ingest.lean` and the board's own
SHA-256.

What is emitted:

| file | what it is |
| --- | --- |
| `system/flake.nix` | the flake: nixpkgs, system-manager, nora, sops-nix, pipelight, a Rust toolchain, and the `shard-ingest` package |
| `system/modules/agents.nix` | one Unix user, one home, one systemd service per agent |
| `system/modules/ingest.nix` | the ingest service, its timer and its path unit |
| `system/modules/network.nix` | the IPv6 plan, the WireGuard VPN and the nftables rules |
| `system/modules/selinux.nix` | the zone types and the allow rules |
| `system/modules/telemetry.nix` | the OpenTelemetry collector and each agent's resource attributes |
| `system/modules/voip.nix` | the PBX: SIP endpoints, the dial plan, the fax extensions and the DIDs |
| `system/modules/uucp.nix` | the UUCP ring, one `sys` stanza per node |
| `system/modules/radio.nix` | callsigns, CW frequencies, the morse beacon and the dead drops |
| `system/secrets/.sops.yaml` | one creation rule per agent |
| `system/pipelight.toml` | the pipelines: ingest, verify, deploy, challenge |
| `system/ingest/` | the Rust tool: `Cargo.toml`, `Cargo.lock`, `src/main.rs` |
| `system/fleet.json`, `system/challenges.json`, `system/catalog.example.json` | the model, as data |
| `system/README.md` | how it fits together |

The flake and the Nix modules are printed in `EmitModules.lean`; this file has
the Rust tool, the model as data, the writeup, and the code that writes it all
out.

The `#guard`s at the bottom are the check that the emission really is derived:
one user block per agent, two extensions per agent, one allow rule per flow of
the policy, one sops rule per agent, and every engine the Lean model knows
named in the Rust source.
-/

set_option autoImplicit false
set_option maxRecDepth 40000

namespace NixWars
namespace Foundry
namespace Emit

/-! ## The Rust tool

The tool is dependency-free on purpose: its SHA-256 is emitted here, round
constants and all, from the same `Sha256.K` the board hashes with. -/

/-- The round constants, as a Rust array body. -/
def rustK : String :=
  String.intercalate ", " (Sha256.K.toList.map (fun w => "0x" ++ hex8 w.toNat))

/-- The initial state, as a Rust array body. -/
def rustH0 : String :=
  String.intercalate ", " (Sha256.initState.toList.map (fun w => "0x" ++ hex8 w.toNat))

/-- The engine table, as Rust match arms. -/
def rustEngines : String :=
  String.intercalate "\n"
    [ "        \"z80\" | \"sna\" | \"tap\" | \"tzx\" => \"zx\",",
      "        \"nes\" => \"nes\",",
      "        \"d64\" | \"prg\" | \"t64\" => \"c64\",",
      "        \"wasm\" => \"wasm\",",
      "        \"z5\" | \"z8\" => \"zmachine\",",
      "        \"bbs\" | \"ans\" | \"door\" => \"door\",",
      "        \"rom\" | \"bin\" => \"rom\",",
      "        _ => \"unknown\"," ]

/-- `system/ingest/Cargo.toml`. -/
def cargoToml : String :=
  header "#" ++ r#"[package]
name = "shard-ingest"
version = "0.1.0"
edition = "2021"
description = "Walk a disk, hash every game, place it on the 71-shard ring"

[dependencies]
# none: the hash and the JSON writer are emitted from Lean

[profile.release]
lto = true
"#

/-- `system/ingest/Cargo.lock`. -/
def cargoLock : String :=
  "# Generated by RequestProject/Foundry/Emit.lean; the crate has no dependencies.\n" ++
  "version = 3\n\n[[package]]\nname = \"shard-ingest\"\nversion = \"0.1.0\"\n"

/-- `system/ingest/src/main.rs`. -/
def mainRs : String :=
  header "//" ++
  "// The model this implements is RequestProject/Foundry/Ingest.lean:\n" ++
  "//   * the walk visits every file exactly once (Tree.scan_paths_nodup)\n" ++
  "//   * a cartridge is named and placed by its digest (cartOf)\n" ++
  "//   * a second run over the same shelf changes nothing (ingest_idem)\n\n" ++
  "use std::collections::BTreeSet;\nuse std::env;\nuse std::fs;\nuse std::path::{Path, PathBuf};\n\n" ++
  "/// The world is cut into 71 shards; 71 is the largest Monster prime.\n" ++
  "const NUM_SHARDS: u32 = " ++ toString numShards ++ ";\n\n" ++
  "const K: [u32; 64] = [" ++ rustK ++ "];\n\n" ++
  "const H0: [u32; 8] = [" ++ rustH0 ++ "];\n\n" ++
  r#"fn sha256(msg: &[u8]) -> [u8; 32] {
    let mut data = msg.to_vec();
    let bitlen = (msg.len() as u64).wrapping_mul(8);
    data.push(0x80);
    while data.len() % 64 != 56 {
        data.push(0);
    }
    data.extend_from_slice(&bitlen.to_be_bytes());

    let mut h = H0;
    for block in data.chunks(64) {
        let mut w = [0u32; 64];
        for i in 0..16 {
            w[i] = u32::from_be_bytes([block[4 * i], block[4 * i + 1], block[4 * i + 2], block[4 * i + 3]]);
        }
        for i in 16..64 {
            let s0 = w[i - 15].rotate_right(7) ^ w[i - 15].rotate_right(18) ^ (w[i - 15] >> 3);
            let s1 = w[i - 2].rotate_right(17) ^ w[i - 2].rotate_right(19) ^ (w[i - 2] >> 10);
            w[i] = w[i - 16]
                .wrapping_add(s0)
                .wrapping_add(w[i - 7])
                .wrapping_add(s1);
        }
        let (mut a, mut b, mut c, mut d, mut e, mut f, mut g, mut hh) =
            (h[0], h[1], h[2], h[3], h[4], h[5], h[6], h[7]);
        for i in 0..64 {
            let s1 = e.rotate_right(6) ^ e.rotate_right(11) ^ e.rotate_right(25);
            let ch = (e & f) ^ ((!e) & g);
            let t1 = hh
                .wrapping_add(s1)
                .wrapping_add(ch)
                .wrapping_add(K[i])
                .wrapping_add(w[i]);
            let s0 = a.rotate_right(2) ^ a.rotate_right(13) ^ a.rotate_right(22);
            let maj = (a & b) ^ (a & c) ^ (b & c);
            let t2 = s0.wrapping_add(maj);
            hh = g;
            g = f;
            f = e;
            e = d.wrapping_add(t1);
            d = c;
            c = b;
            b = a;
            a = t1.wrapping_add(t2);
        }
        h[0] = h[0].wrapping_add(a);
        h[1] = h[1].wrapping_add(b);
        h[2] = h[2].wrapping_add(c);
        h[3] = h[3].wrapping_add(d);
        h[4] = h[4].wrapping_add(e);
        h[5] = h[5].wrapping_add(f);
        h[6] = h[6].wrapping_add(g);
        h[7] = h[7].wrapping_add(hh);
    }

    let mut out = [0u8; 32];
    for i in 0..8 {
        out[4 * i..4 * i + 4].copy_from_slice(&h[i].to_be_bytes());
    }
    out
}

fn hex(bytes: &[u8]) -> String {
    let digits = b"0123456789abcdef";
    let mut s = String::with_capacity(bytes.len() * 2);
    for b in bytes {
        s.push(digits[(b >> 4) as usize] as char);
        s.push(digits[(b & 0x0f) as usize] as char);
    }
    s
}

/// The first thirty-two bits of the digest, as a number.
fn digest_key(hexdigest: &str) -> u32 {
    let mut n: u32 = 0;
    for c in hexdigest.chars().take(8) {
        n = n.wrapping_mul(16).wrapping_add(c.to_digit(16).unwrap_or(0));
    }
    n
}

/// Where an artefact with that digest lives.
fn shard_of(key: u32) -> u32 {
    key % NUM_SHARDS
}

fn engine_of(name: &str) -> &'static str {
    let ext = name.rsplit('.').next().unwrap_or("").to_ascii_lowercase();
    match ext.as_str() {
"# ++ rustEngines ++ r#"
    }
}

#[derive(Clone)]
struct Cart {
    path: String,
    digest: String,
    size: u64,
    engine: &'static str,
    shard: u32,
}

/// The walk: depth first, children in name order, one entry per file.
fn walk(root: &Path, out: &mut Vec<PathBuf>) {
    let mut entries: Vec<PathBuf> = match fs::read_dir(root) {
        Ok(rd) => rd.filter_map(|e| e.ok().map(|e| e.path())).collect(),
        Err(_) => return,
    };
    entries.sort();
    for p in entries {
        if p.is_dir() {
            walk(&p, out);
        } else if p.is_file() {
            out.push(p);
        }
    }
}

/// The digests a catalogue already holds. The catalogue is JSON, but only the
/// digests are needed to decide what is new.
fn known_digests(text: &str) -> BTreeSet<String> {
    let mut set = BTreeSet::new();
    let needle = "\"digest\": \"";
    let mut rest = text;
    while let Some(i) = rest.find(needle) {
        let after = &rest[i + needle.len()..];
        if let Some(j) = after.find('"') {
            set.insert(after[..j].to_string());
            rest = &after[j..];
        } else {
            break;
        }
    }
    set
}

fn escape(s: &str) -> String {
    s.replace('\\', "\\\\").replace('"', "\\\"")
}

fn render(carts: &[Cart]) -> String {
    let mut out = String::from("{\n  \"cartridges\": [\n");
    for (i, c) in carts.iter().enumerate() {
        out.push_str("    {");
        out.push_str(&format!("\"path\": \"{}\", ", escape(&c.path)));
        out.push_str(&format!("\"digest\": \"{}\", ", c.digest));
        out.push_str(&format!("\"size\": {}, ", c.size));
        out.push_str(&format!("\"engine\": \"{}\", ", c.engine));
        out.push_str(&format!("\"shard\": {}", c.shard));
        out.push('}');
        if i + 1 < carts.len() {
            out.push(',');
        }
        out.push('\n');
    }
    out.push_str("  ]\n}\n");
    out
}

fn selftest() -> i32 {
    let vectors: [(&str, &str); 3] = [
        ("", "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"),
        ("abc", "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"),
        (
            "The quick brown fox jumps over the lazy dog",
            "d7a8fbb307d7809469ca9abcb0082e4f8d5651e46d3cdb762d02d0bf37c9e592",
        ),
    ];
    let mut bad = 0;
    for (input, want) in vectors {
        let got = hex(&sha256(input.as_bytes()));
        if got == want {
            println!("ok   sha256({:?})", input);
        } else {
            println!("FAIL sha256({:?}) = {} want {}", input, got, want);
            bad += 1;
        }
    }
    let key = digest_key("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    println!("ok   shard of sha256(\"abc\") = {}", shard_of(key));
    if shard_of(key) >= NUM_SHARDS {
        bad += 1;
    }
    bad
}

fn main() {
    let args: Vec<String> = env::args().collect();
    if args.iter().any(|a| a == "--selftest") {
        std::process::exit(selftest());
    }
    let root = match args.get(1) {
        Some(r) if !r.starts_with("--") => PathBuf::from(r),
        _ => {
            eprintln!("usage: shard-ingest <shelf> [--catalog <file>] [--selftest]");
            std::process::exit(2);
        }
    };
    let catalog_path = match args.iter().position(|a| a == "--catalog") {
        Some(i) => args.get(i + 1).cloned().unwrap_or_else(|| "catalog.json".to_string()),
        None => "catalog.json".to_string(),
    };

    let existing_text = fs::read_to_string(&catalog_path).unwrap_or_default();
    let mut seen = known_digests(&existing_text);
    let mut carts: Vec<Cart> = Vec::new();

    let mut files = Vec::new();
    walk(&root, &mut files);
    let mut added = 0usize;
    for path in files {
        let bytes = match fs::read(&path) {
            Ok(b) => b,
            Err(e) => {
                eprintln!("skip {}: {}", path.display(), e);
                continue;
            }
        };
        let digest = hex(&sha256(&bytes));
        if seen.contains(&digest) {
            continue; // the same game under another name is the same cartridge
        }
        seen.insert(digest.clone());
        let name = path
            .file_name()
            .and_then(|s| s.to_str())
            .unwrap_or("")
            .to_string();
        carts.push(Cart {
            path: path.display().to_string(),
            digest: digest.clone(),
            size: bytes.len() as u64,
            engine: engine_of(&name),
            shard: shard_of(digest_key(&digest)),
        });
        added += 1;
    }

    // merge: the old catalogue first, then what is new
    let mut all: Vec<Cart> = Vec::new();
    if !existing_text.is_empty() {
        for line in existing_text.lines() {
            if let (Some(_), Some(_)) = (line.find("\"digest\""), line.find("\"shard\"")) {
                // keep the old entry verbatim by re-parsing its fields
                let field = |key: &str| -> Option<String> {
                    let needle = format!("\"{}\": ", key);
                    let i = line.find(&needle)? + needle.len();
                    let rest = &line[i..];
                    if rest.starts_with('"') {
                        let j = rest[1..].find('"')? + 1;
                        Some(rest[1..j].to_string())
                    } else {
                        let j = rest.find(|c: char| c == ',' || c == '}')?;
                        Some(rest[..j].to_string())
                    }
                };
                if let (Some(p), Some(d), Some(s), Some(e), Some(sh)) = (
                    field("path"),
                    field("digest"),
                    field("size"),
                    field("engine"),
                    field("shard"),
                ) {
                    let engine: &'static str = match e.as_str() {
"# ++ String.intercalate "\n"
      ((engines.filter (fun e => e != "unknown")).map
        (fun e => "                        \"" ++ e ++ "\" => \"" ++ e ++ "\",")) ++
r#"
                        _ => "unknown",
                    };
                    all.push(Cart {
                        path: p,
                        digest: d,
                        size: s.parse().unwrap_or(0),
                        engine,
                        shard: sh.parse().unwrap_or(0),
                    });
                }
            }
        }
    }
    all.extend(carts);

    let text = render(&all);
    if let Some(parent) = Path::new(&catalog_path).parent() {
        if !parent.as_os_str().is_empty() {
            let _ = fs::create_dir_all(parent);
        }
    }
    fs::write(&catalog_path, &text).expect("write catalogue");
    println!(
        "{} cartridges in the catalogue, {} new, on {} shards",
        all.len(),
        added,
        NUM_SHARDS
    );
}
"#

/-! ## The model, as data -/

/-- One agent, as JSON. -/
def agentJson (a : Agent) : String :=
  "    {" ++ jf "handle" a.handle ++ ", " ++ jf "role" a.role ++ ", " ++
  jf "zone" a.zone.name ++ ", " ++ jn "shard" a.shard ++ ", " ++
  jf "user" a.unixName ++ ", " ++ jn "uid" a.uid ++ ", " ++ jf "home" a.home ++ ", " ++
  jf "addr" a.addr.toString ++ ", " ++ jn "wgPort" a.wgPort ++ ", " ++
  jn "ext" a.ext ++ ", " ++ jn "fax" a.fax ++ ", " ++ jf "did" a.did ++ ", " ++
  jf "sip" a.sip ++ ", " ++ jf "callsign" a.callsign ++ ", " ++
  jn "freqKHz" a.freqKHz ++ ", " ++ jf "uucp" a.uucp ++ ", " ++
  jf "unit" a.unit ++ ", " ++ jf "secret" a.secret ++ ", " ++
  jf "serviceName" a.serviceName ++ "}"

/-- One zone, as JSON. -/
def zoneJson (z : Zone) : String :=
  "    {" ++ jf "name" z.name ++ ", " ++ jf "selinux" z.selinuxType ++ ", " ++
  jf "cidr" z.cidr ++ ", " ++
  q "reaches" ++ ": " ++ jstrs ((zones.filter (fun w => reachIn 5 z w)).map Zone.name) ++ "}"

/-- `system/fleet.json`. -/
def fleetJson : String :=
  "{\n  \"generatedBy\": \"RequestProject/Foundry/Emit.lean\",\n" ++
  "  \"numShards\": " ++ toString numShards ++ ",\n" ++
  "  \"zones\": [\n" ++ String.intercalate ",\n" (zones.map zoneJson) ++ "\n  ],\n" ++
  "  \"flows\": [" ++
    String.intercalate ", " (flowRules.map (fun p => q (p.1.name ++ "->" ++ p.2.name))) ++ "],\n" ++
  "  \"agents\": [\n" ++ String.intercalate ",\n" (fleet.map agentJson) ++ "\n  ]\n}\n"

/-- One challenge, as JSON. -/
def challengeJson (ch : Challenge) : String :=
  "    {" ++ jn "id" ch.id ++ ", " ++ jf "door" ch.door ++ ", " ++
  jf "marquee" ch.marquee ++ ", " ++ q "fields" ++ ": " ++ jstrs ch.fields ++ ", " ++
  q "start" ++ ": " ++ jnats ch.start ++ ", " ++
  q "goalVector" ++ ": " ++ jnats ch.goalVector ++ ", " ++
  jf "goal" ch.goal ++ ", " ++ jn "shard" ch.shard ++ ", " ++ jn "bounty" ch.bounty ++ "}"

/-- `system/challenges.json`. -/
def challengesJson : String :=
  "{\n  \"generatedBy\": \"RequestProject/Foundry/Emit.lean\",\n" ++
  "  \"module\": \"www/nixwars.wasm\",\n" ++
  "  \"protocol\": \"newState = X[door + '_' + tag](arg, ...state)\",\n" ++
  "  \"challenges\": [\n" ++
  String.intercalate ",\n" (challenges.map challengeJson) ++ "\n  ]\n}\n"

/-- One catalogue entry, as JSON, in the format the Rust tool writes. -/
def cartJson (c : Cart) : String :=
  "    {" ++ jf "path" ("/srv/nixwars/shelf/" ++ String.intercalate "/" c.path.tail) ++ ", " ++
  jf "digest" c.digest ++ ", " ++ jn "size" c.size ++ ", " ++
  jf "engine" c.engine ++ ", " ++ jn "shard" c.shard ++ "}"

/-- `system/catalog.example.json`: the worked example of `Ingest.lean`, in the
format the tool writes — four files on the shelf, three cartridges. -/
def catalogExampleJson : String :=
  "{\n  \"cartridges\": [\n" ++
  String.intercalate ",\n" (exampleCatalog.map cartJson) ++ "\n  ]\n}\n"

/-! ## The writeup -/

/-- `system/README.md`. -/
def systemReadme : String :=
  r#"# The shard foundry

Everything in this directory is generated from
`RequestProject/Foundry/*.lean` by `RequestProject/Foundry/Emit.lean`, and
regenerated on every `lake build`. Edit the Lean, not the files here.

## What it is

An Ubuntu host, managed by [system-manager](https://github.com/numtide/system-manager)
rather than converted to NixOS, running eight agents that ingest games from
disk, file them as shards, and play the fifteen doors of the board.

```
flake.nix ──► system-manager ──► systemd units on Ubuntu
   │                              users, zones, VPN, PBX, UUCP, radio
   ├── sops-nix ──► secrets/agents/<agent>.yaml, one per agent
   ├── pipelight ──► pipelight.toml: ingest │ verify │ deploy │ challenge
   └── rust ──► ingest/: shard-ingest, dependency-free, SHA-256 from Lean
```

## The tool

```
shard-ingest /path/to/games --catalog /srv/nixwars/catalog/catalog.json
shard-ingest --selftest
```

It walks the shelf depth first, hashes every file, names each game by its
digest, places it on shard `digest[0..8] % 71`, and appends it to the
catalogue unless that digest is already there. The Lean model proves the three
properties that matter:

| property | theorem |
| --- | --- |
| the walk visits every file exactly once | `Tree.scan_paths_nodup` |
| the catalogue only grows, never reorders | `isPrefix_ingest` |
| a second run over the same shelf changes nothing | `ingest_idem` |
| the same game under two names is one cartridge | `cartOf_shard_congr` |

There is a second implementation of the same walk, `ingest.mjs`, which needs
nothing but `node`:

```
node system/ingest.mjs /path/to/games --catalog /srv/nixwars/catalog/catalog.json
```

The two are held to the same catalogue by the last step of `pipelight run
ingest`, which runs the fallback over the same shelf and diffs the result.

## The agents

Eight of them, one Unix user each, nothing shared. Each agent's user id,
address, WireGuard port, voice extension, fax extension, direct-dial number,
CW frequency and UUCP node are all derived from its shard, and the shards are
distinct, so the separation is a theorem rather than a convention
(`Fleet.uid_nodup`, `addr_nodup`, `ext_nodup`, `fax_nodup`, `ext_ne_fax`,
`callsigns_nodup`, `uucp_names_nodup`).

## The zones

Five SELinux types, five /64s of `fd47:5152:1c47::/48`, four allowed flows.
The interesting facts are proved over the transitive closure of the policy,
not over the one-hop table:

* `vault_unreachable_from_public` — nothing that starts at the edge reaches
  the vault, by any route;
* `airgap_isolated_in` / `airgap_isolated_out` — the air-gapped shelf is
  reachable from nothing and reaches nothing, which is why there is a courier.

## Out of band

Every channel is a codec with a round-trip proof, reusing the board's own
wires: UUCP bang paths around a ring of eight (`uucpRoute_arrives`), one-time
padded dead drops read out as a numbers station (`collect_leave`), SLIP frames
carried by hand (`sneakernet_roundtrip`), Group 3 fax with run-length coded
scanlines (`faxTransport_roundtrip`), and international morse on the 40-metre
band (`qso_roundtrip`, `freq_in_band`).

## The challenges

`challenges.json` is one challenge per door, generated from the agent cards.
A submission is verified by replaying it through the shipped WebAssembly
module: `verify_sound` says an accepted submission really drove the module
from the challenge's start vector to its goal, and `reference_verifies` says
the board can always answer its own challenge. Scoring counts distinct
challenges (`score_duplicate`, `score_mono`).

## Checking it

```
lake build          # the Lean, and the regeneration of this directory
node system/selftest.mjs
pipelight run verify
```
"#

/-! ## Writing it out -/

/-- Write the whole of `system/`. -/
def writeSystem : IO Unit := do
  IO.FS.createDirAll "system"
  IO.FS.createDirAll "system/modules"
  IO.FS.createDirAll "system/secrets"
  IO.FS.createDirAll "system/ingest/src"
  IO.FS.writeFile "system/flake.nix" flakeNix
  IO.FS.writeFile "system/modules/agents.nix" agentsNix
  IO.FS.writeFile "system/modules/ingest.nix" ingestNix
  IO.FS.writeFile "system/modules/network.nix" networkNix
  IO.FS.writeFile "system/modules/selinux.nix" selinuxNix
  IO.FS.writeFile "system/modules/telemetry.nix" telemetryNix
  IO.FS.writeFile "system/modules/voip.nix" voipNix
  IO.FS.writeFile "system/modules/uucp.nix" uucpNix
  IO.FS.writeFile "system/modules/radio.nix" radioNix
  IO.FS.writeFile "system/secrets/.sops.yaml" sopsYaml
  IO.FS.writeFile "system/pipelight.toml" pipelightToml
  IO.FS.writeFile "system/ingest/Cargo.toml" cargoToml
  IO.FS.writeFile "system/ingest/Cargo.lock" cargoLock
  IO.FS.writeFile "system/ingest/src/main.rs" mainRs
  IO.FS.writeFile "system/fleet.json" fleetJson
  IO.FS.writeFile "system/challenges.json" challengesJson
  IO.FS.writeFile "system/catalog.example.json" catalogExampleJson
  IO.FS.writeFile "system/README.md" systemReadme

#eval writeSystem

/-! ## The emission is derived, not written

Each of these counts a marker in an emitted file against the model it came
from. -/

-- One Unix account per agent.
#guard occurrences "isNormalUser = true;" agentsNix = fleet.length

-- One systemd service per agent.
#guard occurrences "SELinuxContext" agentsNix = fleet.length

-- One WireGuard peer per agent.
#guard occurrences "publicKey" networkNix = fleet.length

-- One nftables rule per allowed flow, and no more.
#guard occurrences "accept comment" networkNix = flowRules.length

-- One SELinux type per zone, one allow rule per flow.
#guard occurrences "    type nixwars_" selinuxNix = zones.length
#guard occurrences "    allow " selinuxNix = flowRules.length

-- Nothing in the policy mentions the air gap.
#guard occurrences "nixwars_airgap_t:tcp_socket" selinuxNix = 0

-- A voice extension and a fax extension per agent, plus the catch-all.
#guard occurrences "exten => " voipNix = 2 * fleet.length + 1

-- One sops creation rule and one key per agent.
#guard occurrences "path_regex" sopsYaml = fleet.length

-- One UUCP stanza per node.
#guard occurrences "    system " uucpNix = uucpNodes

-- One line of band plan per agent.
#guard occurrences " kHz  " radioNix = fleet.length

-- The Rust tool knows every engine the Lean model knows.
#guard engines.all (fun e => occurrences ("\"" ++ e ++ "\"") mainRs ≥ 1)

-- The Rust tool shards by the same 71.
#guard occurrences "NUM_SHARDS: u32 = 71" mainRs = 1

-- The Rust tool's round constants are the board's own.
#guard occurrences "0x428a2f98" mainRs = 1
#guard occurrences "0xc67178f2" mainRs = 1

-- Fifteen challenges on the board.
#guard occurrences "\"door\": " challengesJson = challenges.length

-- Eight agents in the fleet file.
#guard occurrences "\"handle\": " fleetJson = fleet.length

end Emit
end Foundry
end NixWars
