import RequestProject.Gvcs.VoxelGame.View

/-!
# The link writer

`lake exe voxelview [dir]` writes the share links that open the machine and the game world
in the voxel viewer `web/voxel.html`:

* `voxel-lifetrac.md` — the codes themselves, one per keyframe of the lift, plus the
  campaign's closing scene;
* `voxel-lifetrac.html` — the same as a small page of links, so they can be clicked.

Every code is produced by `RequestProject/Voxel/View.lean` and
`RequestProject/VoxelGame/View.lean` from the occupancy functions the proofs are about, and
`view_faithful` says the viewer shows exactly those functions.  The default directory is
`web`, next to the page the links point at.
-/

open LifeTrac Voxel Voxel.View VoxelGame VoxelGame.View

/-- The name a keyframe's design carries in the viewer. -/
def liftName (l : Int) : String := "LIFETRAC LIFT " ++ toString l

/-- The share code of the machine at one lift command. -/
def liftCode (l : Int) : String :=
  machineShare (Codec.asciiName (liftName l)) ⟨l, 0⟩

/-- How many cells of each block type a grid holds. -/
def gridCounts (grid : List Nat) : List Nat :=
  (List.range 10).map (fun b => (grid.filter (fun v => v == b)).length)

/-- A checksum of a grid: position-sensitive, so a code that decoded to the right blocks in
the wrong order would not pass. -/
def gridChecksum (grid : List Nat) : Nat :=
  (grid.zipIdx.foldl (fun a p => (a + (p.2 + 1) * p.1) % 2147483647) 0)

/-- What `tools/check_voxel_links.mjs` compares the shipped decoder against: for every
link, the code, the census of its grid and its checksum, straight from Lean. -/
def linksJson : String :=
  let entry := fun (name : String) (code : String) (grid : List Nat) =>
    "  {\"name\": \"" ++ name ++ "\", \"code\": \"" ++ code ++ "\",\n" ++
    "   \"counts\": [" ++ String.intercalate ", " ((gridCounts grid).map toString) ++ "],\n" ++
    "   \"checksum\": " ++ toString (gridChecksum grid) ++ "}"
  "{\"frames\": [\n" ++
  String.intercalate ",\n"
    (keyLifts.map (fun l => entry (liftName l) (liftCode l) (machineCells ⟨l, 0⟩)) ++
      [entry "LIFETRAC YARD" demoShare (worldCells sceneFrame 4 demoWorld)]) ++
  "\n]}\n"

/-- The codes, as a note. -/
def linksMarkdown : String :=
  let row := fun (l : Int) =>
    "* **lift " ++ toString l ++ "** — `voxel.html#v=" ++ liftCode l ++ "`\n"
  "# LifeTrac in the voxel viewer\n\n" ++
  "Generated by `lake exe voxelview` from the Lean development.  Do not edit by hand.\n\n" ++
  "Open `voxel.html` and paste a code into LOAD, or open the link directly.  Each code is\n" ++
  "the run-length code of a 24 x 16 x 24 grid, produced by\n" ++
  "`RequestProject/Voxel/View.lean` from the occupancy functions of\n" ++
  "`RequestProject/Voxel/Parts.lean`: one block of the viewer is four voxels of the\n" ++
  "lattice, so 20 cm.  Paint is LAVA, rubber is BOUNCE, chrome is GLASS, steel is STONE.\n\n" ++
  "## The machine, at the keyframes of the lift\n\n" ++
  String.join (keyLifts.map row) ++
  "\n## The campaign scene\n\n" ++
  "The closing scene of `RequestProject/VoxelGame/Editor.lean` — the machine as built, the\n" ++
  "stock in the yard, the subassemblies in the shed, the fuel and cash gauges, the field\n" ++
  "and the ground the player dug:\n\n" ++
  "* **yard** — `voxel.html#v=" ++ demoShare ++ "`\n"

/-- A page of the same links, so they can be clicked. -/
def linksPage : String :=
  let row := fun (l : Int) =>
    "<li><a href=\"voxel.html#v=" ++ liftCode l ++ "\">the machine at lift " ++
      toString l ++ "</a></li>\n"
  "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">\n" ++
  "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n" ++
  "<title>LifeTrac &middot; in the voxel viewer</title>\n" ++
  "<style>body{background:#0e1512;color:#e7f0e9;font-family:system-ui,sans-serif;" ++
  "margin:0 auto;max-width:900px;padding:24px;line-height:1.5}h1{color:#79c98a}" ++
  "h2{color:#e8c46a;border-bottom:1px solid #2b3a31;padding-bottom:4px;margin-top:32px}" ++
  "a{color:#6fb7e8}code{color:#cfe6d6}li{margin:6px 0}</style>\n" ++
  "</head><body>\n<h1>LifeTrac &middot; in the voxel viewer</h1>\n" ++
  "<p>Each link opens <a href=\"voxel.html\">the voxel viewer</a> on a grid computed by " ++
  "<code>lake exe voxelview</code> straight from the occupancy functions of the Lean " ++
  "development.  One block is four voxels &mdash; 20&nbsp;cm.  Drag to orbit, pinch to " ++
  "zoom; TEST walks around it.</p>\n" ++
  "<h2>The machine, at the keyframes of the lift</h2>\n<ul>\n" ++
  String.join (keyLifts.map row) ++
  "</ul>\n<h2>The campaign scene</h2>\n<ul>\n" ++
  "<li><a href=\"voxel.html#v=" ++ demoShare ++ "\">the yard at the end of the campaign" ++
  "</a></li>\n</ul>\n" ++
  "<p>What the viewer draws is what the functions say: <code>view_faithful</code> in " ++
  "<code>RequestProject/Voxel/View.lean</code> and <code>world_view_faithful</code> in " ++
  "<code>RequestProject/VoxelGame/View.lean</code>.</p>\n" ++
  "</body></html>\n"

/-- Write the links out. -/
def main (args : List String) : IO Unit := do
  let dir := args.headD "web"
  IO.FS.createDirAll dir
  IO.FS.writeFile (dir ++ "/voxel-lifetrac.md") linksMarkdown
  IO.println s!"wrote {dir}/voxel-lifetrac.md"
  IO.FS.writeFile (dir ++ "/voxel-lifetrac.html") linksPage
  IO.println s!"wrote {dir}/voxel-lifetrac.html"
  IO.FS.writeFile (dir ++ "/voxel-lifetrac.json") linksJson
  IO.println s!"wrote {dir}/voxel-lifetrac.json"
