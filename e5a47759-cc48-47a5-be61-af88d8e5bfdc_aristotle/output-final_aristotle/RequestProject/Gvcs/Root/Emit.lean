import RequestProject.Gvcs.Web.Standalone
import RequestProject.Gvcs.Web.Modular
import RequestProject.Gvcs.Water.Anim

/-!
# The extractor

`lake exe emit [dir]` writes the browser implementation of the game out of the
Lean development:

* `lifetrac.wasm` — the rule book, compiled from `Runtime.rstep` by
  `RequestProject/Wasm/Compile.lean` and encoded by
  `RequestProject/Wasm/Encode.lean`;
* `index.html` — the shell, generated by `RequestProject/Web/Html.lean` from
  the same tables the module was compiled from;
* `lifetrac.html` — the same game as a *single self-contained page*: the shell,
  the tables and the module itself, the module masked, base64'd and unsealed by
  a homomorphic computation, generated by `RequestProject/Web/Standalone.lean`;
* `trace.json` — the verified playthrough of `Tycoon.lean` as a list of clicks
  and the position the Lean runtime says each one leads to, which `test.mjs`
  replays through the emitted module.

It also writes the *modular* build of `RequestProject/Web/Modular.lean`:

* `lifetrac-tiny.html`, `lifetrac-core.html`, `lifetrac-workshop.html`,
  `lifetrac-farm.html` and `lifetrac-max.html` — the same engine with more and
  more content, each a single self-contained page;
* `packs/*.ltp` — the shipped packs as share codes, one line each, for pasting
  into any of those pages;
* `packs/packs.json` and `packs/demo-trace.json` — what `packs-test.mjs`
  checks the pages' JavaScript against.

The default directory is `web`.
-/

open LifeTrac Wasm Runtime Web

/-- A move, as the shell sends it: kind, index, quantity. -/
def actionCode : RAction → Int × Int × Int
  | .buy m q => (0, idxM m, q)
  | .order a => (1, idxP a, 0)
  | .sell m q => (2, idxM m, q)
  | .fabricate a => (3, idxP a, 0)
  | .refuel l => (4, 0, l)
  | .farm c a => (5, idxC c, a)

/-- The screen a kind of move is made on. -/
def homeScreen : RAction → Int
  | .buy _ _ | .order _ | .sell _ _ | .refuel _ => 2
  | .fabricate _ => 3
  | .farm _ _ => 4

/-- One line of the expected trace: the click, the screen it is made on, and
the position the Lean runtime lands on. -/
def traceLine (a : RAction) (s : RState) : String :=
  let (k, i, q) := actionCode a
  "{\"kind\":" ++ toString k ++ ",\"idx\":" ++ toString i ++ ",\"arg\":" ++ toString q ++
  ",\"screen\":" ++ toString (homeScreen a) ++
  ",\"cash\":" ++ toString s.cash ++ ",\"fuel\":" ++ toString s.fuel ++
  ",\"day\":" ++ toString s.day ++ ",\"hect\":" ++ toString s.hect ++
  ",\"stock\":[" ++ String.intercalate "," (allM.map (fun m => toString (s.stock m))) ++
  "],\"built\":[" ++
    String.intercalate "," (allP.map (fun p => toString (s.built.count p))) ++ "]}"

/-- The trace of a script through the Lean runtime. -/
def traceOf (s : RState) : List RAction → List String
  | [] => []
  | a :: as => match rstep s a with
      | some t => traceLine a t :: traceOf t as
      | none => []

/-- The expected trace of the verified playthrough, as JSON. -/
def traceJson : String :=
  "[\n  " ++ String.intercalate ",\n  " (traceOf rstart rFirstSeason) ++ "\n]\n"

/-! ## The modular build -/

open LifeTrac.Modular in
/-- A string as JSON. -/
def jsonStr (s : String) : String :=
  "\"" ++ ((s.replace "\\" "\\\\").replace "\"" "\\\"") ++ "\""

open LifeTrac.Modular in
/-- An item as JSON, with the integers as strings so that no precision is lost
on the way into JavaScript. -/
def itemJson (i : Item) : String :=
  "{\"id\":" ++ jsonStr i.id ++ ",\"name\":" ++ jsonStr i.name ++
  ",\"kind\":" ++ jsonStr (match i.kind with
    | .material => "material" | .part => "part" | .crop => "crop") ++
  ",\"unit\":" ++ jsonStr i.unit ++
  ",\"price\":" ++ jsonStr (toString i.price) ++
  ",\"salvage\":" ++ jsonStr (toString i.salvage) ++
  ",\"days\":" ++ jsonStr (toString i.days) ++
  ",\"revenue\":" ++ jsonStr (toString i.revenue) ++
  ",\"inputs\":[" ++ String.intercalate "," (i.inputs.map (fun q =>
    "[" ++ jsonStr q.1 ++ "," ++ jsonStr (toString q.2) ++ "]")) ++ "]}"

open LifeTrac.Modular in
/-- A pack as JSON, next to the share code Lean makes of it. -/
def packJson (p : Pack) : String :=
  "{\"code\":" ++ jsonStr (encodeShare p) ++ ",\"pack\":{\"id\":" ++ jsonStr p.id ++
  ",\"title\":" ++ jsonStr p.title ++ ",\"version\":" ++ toString p.version ++
  ",\"goalItem\":" ++ jsonStr p.goalItem ++
  ",\"goalCash\":" ++ jsonStr (toString p.goalCash) ++
  ",\"items\":[" ++ String.intercalate "," (p.items.map itemJson) ++ "]}}"

open LifeTrac.Modular in
/-- Every shipped pack. -/
def packsJson : String :=
  "[\n" ++ String.intercalate ",\n"
    (([tinyPack] ++ maxPacks ++ [bigPack]).map packJson) ++ "\n]\n"

open LifeTrac.Modular in
/-- A position as JSON. -/
def stJson (s : St) : String :=
  "{\"cash\":" ++ jsonStr (toString s.cash) ++ ",\"day\":" ++ jsonStr (toString s.day) ++
  ",\"stock\":[" ++ String.intercalate "," (s.stock.map (fun q =>
    "[" ++ jsonStr q.1 ++ "," ++ jsonStr (toString q.2) ++ "]")) ++ "]}"

open LifeTrac.Modular in
/-- A move as JSON. -/
def actJson : Act → String
  | .buy id q => "[\"buy\"," ++ jsonStr id ++ "," ++ toString q ++ "]"
  | .sell id q => "[\"sell\"," ++ jsonStr id ++ "," ++ toString q ++ "]"
  | .make id => "[\"make\"," ++ jsonStr id ++ ",0]"
  | .work id q => "[\"work\"," ++ jsonStr id ++ "," ++ toString q ++ "]"

open LifeTrac.Modular in
/-- The states the Lean engine passes through on the proved playthrough. -/
def demoStates : List Act → St → List St
  | [], _ => []
  | a :: as, s => match step bigWorld s a with
      | some t => t :: demoStates as t
      | none => []

open LifeTrac.Modular in
/-- The proved playthrough, move by move and position by position. -/
def demoTraceJson : String :=
  "{\"moves\":[" ++ String.intercalate "," (bigDemo.map actJson) ++
  "],\n \"states\":[" ++
  String.intercalate ",\n  " ((demoStates bigDemo start).map stJson) ++ "]}\n"

def main (args : List String) : IO Unit := do
  let out := args.headD "web"
  IO.FS.createDirAll out
  IO.FS.writeBinFile (out ++ "/lifetrac.wasm") (encodeModBytes gameMod)
  IO.FS.writeFile (out ++ "/index.html") indexHtml
  IO.FS.writeFile (out ++ "/lifetrac.html") standaloneHtml
  IO.FS.writeFile (out ++ "/trace.json") traceJson
  let packDir := out ++ "/packs"
  IO.FS.createDirAll packDir
  IO.FS.writeFile (out ++ "/lifetrac-tiny.html") LifeTrac.Modular.tinyPage
  IO.FS.writeFile (out ++ "/lifetrac-core.html") LifeTrac.Modular.corePage
  IO.FS.writeFile (out ++ "/lifetrac-workshop.html") LifeTrac.Modular.workshopPage
  IO.FS.writeFile (out ++ "/lifetrac-farm.html") LifeTrac.Modular.farmPage
  IO.FS.writeFile (out ++ "/lifetrac-water.html") LifeTrac.Modular.waterPage
  IO.FS.writeFile (out ++ "/water-computer.html") LifeTrac.Water.animPage
  IO.FS.writeFile (out ++ "/lifetrac-max.html") LifeTrac.Modular.maxPage
  for (name, p) in [("tiny", LifeTrac.Modular.tinyPack), ("core", LifeTrac.Modular.corePack),
      ("workshop", LifeTrac.Modular.workshopPack), ("farm", LifeTrac.Modular.farmPack),
      ("homestead", LifeTrac.Modular.homesteadPack), ("water", LifeTrac.Modular.waterPack),
      ("big", LifeTrac.Modular.bigPack)] do
    IO.FS.writeFile (packDir ++ "/" ++ name ++ ".ltp")
      (LifeTrac.Modular.encodeShare p ++ "\n")
  IO.FS.writeFile (packDir ++ "/packs.json") packsJson
  IO.FS.writeFile (packDir ++ "/demo-trace.json") demoTraceJson
  IO.println s!"wrote {out}/lifetrac.wasm, {out}/index.html, {out}/lifetrac.html, \
{out}/trace.json, {out}/lifetrac-\{tiny,core,workshop,farm,water,max}.html and {out}/packs/"
