import RequestProject.Gvcs.VoxelGame.Editor

/-!
# The voxel game extractor

`lake exe game [dir]` writes the game out of the Lean development as a voxel
world:

* `frame-N.svg` — the five frames of the verified playthrough of
  `RequestProject/Tycoon.lean`, each drawn as an isometric picture of the whole
  game state: the machine, the yard, the shed, the fuel gauge, the cash column,
  the field and the ground;
* `session.svg` — a session in the other modes: ground dug out, a puddle, a
  three-brick bucket tooth from the creative editor, and the machine driven
  forward with the loader up;
* `world.json` — the same session as plain data, one entry per occupied voxel,
  for a shell that builds the world out of its own parts;
* `index.html` — a page showing all of them;
* `README.md` — what the pictures are and which theorem says so.

Nothing here is drawn by hand.  Every picture is a function of the same worlds
`RequestProject/VoxelGame/*.lean` proves things about, so the counts a player
can make in the picture — 184 coin voxels, 8 fuel voxels, 160 crop voxels — are
the counts of `campaign_final_view`.

The default directory is `game`.
-/

open LifeTrac Voxel VoxelGame

/-- The windows the world is drawn in.  A world is a function on the whole
lattice and is nearly all air, so the picture is taken district by district:
the ground under everything, the machine, the yard, the shed, the two gauges,
the field, and the corner where the creative bricks are.  The cash column is a
hundred to the voxel and so is very tall; it gets a window of its own. -/
def gameBoxes : List (Vox × Vox) :=
  [ ((-4, -28, -1), (70, 48, -1))     -- the ground, one layer
  , ((0, -18, 0), (52, 18, 50))       -- the machine
  , ((-1, 24, 0), (48, 24, 24))       -- the yard
  , ((-1, -24, 0), (24, -24, 24))     -- the shed
  , ((0, 30, 0), (0, 30, 60))         -- the fuel gauge
  , ((0, 34, 0), (0, 34, 240))        -- the cash column
  , ((0, 40, 0), (24, 47, 0))         -- the field
  , ((58, -2, 0), (70, 6, 12)) ]      -- the creative bricks

/-- The caption of a campaign frame. -/
def frameCaption (i : Nat) (s : Build.GameState) : String :=
  "LifeTrac \u00b7 frame " ++ toString i ++ " of " ++ toString (campaignFrames.length - 1) ++
    " \u00b7 cash " ++ toString s.cash ++ " \u00b7 fuel " ++ toString s.fuel ++
    " L \u00b7 " ++ toString s.hectares ++ " ha"

/-- The gallery page. -/
def gameGallery : String :=
  let frame := fun (i : Nat) =>
    "<h2>Frame " ++ toString i ++ "</h2>\n" ++
      "<img src=\"frame-" ++ toString i ++ ".svg\" alt=\"the world at frame " ++
      toString i ++ "\">\n"
  "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">\n" ++
  "<title>LifeTrac \u00b7 the game, as voxels</title>\n" ++
  "<style>body{background:#0e1512;color:#e7f0e9;font-family:system-ui,sans-serif;" ++
  "margin:0 auto;max-width:1100px;padding:24px}h1{color:#79c98a}" ++
  "h2{color:#e8c46a;border-bottom:1px solid #2b3a31;padding-bottom:4px;margin-top:36px}" ++
  "img{max-width:100%;border:1px solid #2b3a31;border-radius:6px}" ++
  "p{color:#8fa697}a{color:#6fb7e8}code{color:#cfe6d6}li{color:#8fa697}</style>\n" ++
  "</head><body>\n<h1>LifeTrac \u00b7 the game, as voxels</h1>\n" ++
  "<p>Every picture here is drawn by <code>lake exe game</code> from the world " ++
  "functions of <code>RequestProject/VoxelGame/</code>. The whole game state is a " ++
  "world of typed voxels: the yard is a column per material, the fuel gauge is five " ++
  "litres to the voxel, the cash column a hundred to the voxel, the field eight " ++
  "voxels to the hectare, and the shed one column per machine the player owns.</p>\n" ++
  "<h2>A session</h2>\n" ++
  "<p>Ground dug out and a puddle filled in, a three-brick bucket tooth from the " ++
  "creative editor, and the machine driven four voxels forward with the loader all " ++
  "the way up. Proved legal move by move (<code>demoSite_legal</code>), and the " ++
  "picture is proved to be the session world of the specification " ++
  "(<code>demoWorld_eq</code>).</p>\n" ++
  "<img src=\"session.svg\" alt=\"a session: digging, bricks and the machine\">\n" ++
  "<h2>The verified playthrough</h2>\n" ++
  "<p>The five frames of <code>RequestProject/Tycoon.lean</code>: order the bill of " ++
  "materials, weld the tractor, fill the tank, farm twenty hectares of wheat. In the " ++
  "last frame the cash column is 184 voxels tall, the fuel gauge 8, and the field " ++
  "holds 160 crop voxels \u2014 that is <code>campaign_final_view</code>.</p>\n" ++
  String.join ((List.range campaignFrames.length).map frame) ++
  "</body></html>\n"

/-- The note that goes with the generated pictures. -/
def gameReadme : String :=
  "# LifeTrac, as a voxel game\n\n" ++
  "Everything in this directory is generated by `lake exe game` from the Lean\n" ++
  "development.  Do not edit it by hand.\n\n" ++
  "## What you are looking at\n\n" ++
  "The game state is a *world*: a function from the integer lattice to a typed\n" ++
  "cell (`RequestProject/VoxelGame/World.lean`).  One voxel is 5 cm, the same\n" ++
  "lattice the machine itself is modelled on.  Each part of the state has its own\n" ++
  "district of the world (`Scene.lean`):\n\n" ++
  "| District | Where | What it shows |\n" ++
  "| --- | --- | --- |\n" ++
  "| machine | `y` in [-17, 17] | the tractor, from `Voxel/Parts.lean` |\n" ++
  "| yard | `y = 24` | one column per catalogue material, one voxel per lot |\n" ++
  "| shed | `y = -24` | one column per subassembly the player has fabricated |\n" ++
  "| fuel gauge | `(0, 30)` | one voxel per five litres |\n" ++
  "| cash column | `(0, 34)` | one voxel per hundred |\n" ++
  "| field | `y` in [40, 47] | eight crop voxels per whole hectare worked |\n" ++
  "| ground | `z < 0` | topsoil and subsoil, as dug |\n" ++
  "| bricks | anywhere | what the creative editor has placed |\n\n" ++
  "## Why the picture is trustworthy\n\n" ++
  "The districts are proved not to shadow one another, so counting voxels in the\n" ++
  "picture reads the game state back exactly: `tally_scene_stock`,\n" ++
  "`tally_scene_fuel`, `tally_scene_cash`, `tally_scene_crop` and\n" ++
  "`scene_shed_iff`.  For the playthrough of `Tycoon.lean` those counts are\n" ++
  "settled numbers — 184 coin voxels, 8 fuel voxels, 160 crop voxels and a shed\n" ++
  "voxel reading `LifeTrac` (`campaign_final_view`).\n\n" ++
  "The moves are the game elements of `GAMEPLAN.md`: `SiteAction` is dig, fill,\n" ++
  "place a brick, remove a brick, drive, lift; `Mode` is campaign, sandbox,\n" ++
  "creative and co-op, and a mode can only forbid moves, never invent them\n" ++
  "(`stepIn_eq_step`).  Digging removes exactly one voxel from the count\n" ++
  "(`dig_removes_one`), filling puts exactly one back (`fill_adds_one`), digs in\n" ++
  "different places commute (`dig_comm`), and two players who have seen the same\n" ++
  "moves see the same world (`site_converges`).\n\n" ++
  "## Files\n\n" ++
  "* `frame-N.svg` — the frames of the verified playthrough;\n" ++
  "* `session.svg` — digging, bricks and the machine in one session;\n" ++
  "* `world.json` — that session as plain data, `[x, y, z, kind]` per voxel;\n" ++
  "* `index.html` — a page showing all of it.\n"

/-- Write the game out. -/
def main (args : List String) : IO Unit := do
  let dir := args.headD "game"
  IO.FS.createDirAll dir
  for (s, i) in campaignFrames.zipIdx do
    let name := dir ++ "/frame-" ++ toString i ++ ".svg"
    IO.FS.writeFile name (worldSvgIn (frameCaption i s) (scene s nominal) gameBoxes)
    IO.println s!"wrote {name}"
  IO.FS.writeFile (dir ++ "/session.svg")
    (worldSvgIn "LifeTrac \u00b7 a session \u00b7 dug ground, a puddle, a bucket tooth, loader up"
      demoWorld gameBoxes)
  IO.println s!"wrote {dir}/session.svg"
  IO.FS.writeFile (dir ++ "/world.json") (worldJsonIn demoWorld gameBoxes)
  IO.println s!"wrote {dir}/world.json"
  IO.FS.writeFile (dir ++ "/index.html") gameGallery
  IO.println s!"wrote {dir}/index.html"
  IO.FS.writeFile (dir ++ "/README.md") gameReadme
  IO.println s!"wrote {dir}/README.md"
