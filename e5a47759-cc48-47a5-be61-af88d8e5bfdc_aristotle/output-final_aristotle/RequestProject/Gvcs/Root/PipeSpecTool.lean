import RequestProject.Gvcs.PipeSpec.Manifold
import RequestProject.Gvcs.PipeSpec.SelfHost

/-!
# The `PipeSpec` writer

`lake exe pipespec [dir]` writes the machine-consumable side of
`RequestProject/PipeSpec/` out of the Lean development:

* `manifold.gcode`, `manifold-deposited.json` — the print job for the printed
  parts of the milestone valve manifold, and the cells the Lean interpreter says
  it leaves on the bed;
* `manifold-manifest.json`, `manifold-bosm.txt` — the loader arm's
  pick-and-place manifest and the bill of sourced materials for the same
  circuit;
* `rig.gcode`, `rig-deposited.json`, `rig-manifest.json`, `rig-bosm.txt` — the
  same four files for the rig's own circuit, the spec the generator produces
  from the rig's self-description;
* `bootstrap.md` — the enumerated human steps, the calibration checkpoints and
  the stated assumptions;
* `README.md` — the dry-run report.

The default directory is `pipespec`.  `tools/check_gcode.py` re-simulates either
G-code file and compares the result with the matching `*-deposited.json`.
-/

open LifeTrac
open LifeTrac.PipeSpec
open LifeTrac.Printer
open LifeTrac.Voxel

/-- The milestone job: the printed parts of the valve manifold. -/
def manifoldJob : List Instr := toolpath d3d 205 valveManifoldSpec

/-- The rig's own job: the printed parts of its own hydraulic circuit. -/
def rigJob : List Instr := toolpath rigPrinter 205 rigSpec

/-- A numbered list as Markdown. -/
def bullets (l : List String) : String := String.join (l.map fun s => "- " ++ s ++ "\n")

/-- The bootstrap note. -/
def bootstrapDoc : String :=
  "# Bootstrap: every human action, enumerated\n\n" ++
  "Generated by `lake exe pipespec` from `RequestProject/PipeSpec/SelfHost.lean`.\n" ++
  "Do not edit by hand.\n\n" ++
  "## From an empty workshop to a first working copy\n\n" ++
  bullets bootstrapSteps ++
  "\nTwelve steps (`bootstrapSteps_count`).\n\n" ++
  "## Calibration checkpoints\n\n" ++
  bullets calibrationCheckpoints ++
  "\nEight checkpoints (`calibrationCheckpoints_count`).\n\n" ++
  "## One generation's bill of sourced materials\n\n" ++
  bullets bosmSteps ++
  "\n## What is assumed rather than proved\n\n" ++
  bullets statedAssumptions

/-- The dry-run report. -/
def pipespecReadme : String :=
  "# PipeSpec: generated artefacts\n\n" ++
  "Everything in this directory is generated by `lake exe pipespec` from the\n" ++
  "Lean development in `RequestProject/PipeSpec/`.  Do not edit it by hand.\n\n" ++
  "## The milestone circuit: one valve manifold\n\n" ++
  "A pump feeding a three-way manifold that serves a valve to the sump, a\n" ++
  "pressure gauge and a straight return, plumbed at 10 mm bore in printed PETG.\n\n" ++
  "| quantity | value |\n| --- | --- |\n" ++
  "| components | " ++ toString valveManifoldSpec.nodes.length ++ " |\n" ++
  "| pipe segments | " ++ toString valveManifoldSpec.edges.length ++ " |\n" ++
  "| ports | " ++ toString valveManifoldSpec.allPorts.length ++ " |\n" ++
  "| bill lines | " ++ toString (allParts valveManifoldSpec).length ++ " |\n" ++
  "| printed items | " ++ toString (partCount (printedParts valveManifoldSpec)) ++ " |\n" ++
  "| sourced items | " ++ toString (partCount (bosm valveManifoldSpec)) ++ " |\n" ++
  "| plate, cells of plastic | " ++ toString (enum d3d.env (plate valveManifoldSpec)).length ++ " |\n" ++
  "| G-code instructions | " ++ toString manifoldJob.length ++ " |\n" ++
  "| pick-and-place rows | " ++ toString (manifest valveManifoldSpec).picks.length ++ " |\n" ++
  "| fastening operations | " ++ toString (manifest valveManifoldSpec).joints.length ++ " |\n\n" ++
  "## The rig's own circuit\n\n" ++
  "The spec the generator produces from the rig's self-description: a pump\n" ++
  "feeding a four-way manifold serving three arm axes through valves, plus a\n" ++
  "gauge, at 8 mm bore in printed nylon.\n\n" ++
  "| quantity | value |\n| --- | --- |\n" ++
  "| components | " ++ toString rigSpec.nodes.length ++ " |\n" ++
  "| pipe segments | " ++ toString rigSpec.edges.length ++ " |\n" ++
  "| ports | " ++ toString rigSpec.allPorts.length ++ " |\n" ++
  "| bill lines | " ++ toString (allParts rigSpec).length ++ " |\n" ++
  "| printed items | " ++ toString (partCount (printedParts rigSpec)) ++ " |\n" ++
  "| sourced items | " ++ toString (partCount (bosm rigSpec)) ++ " |\n" ++
  "| plate, cells of plastic | " ++ toString (enum rigPrinter.env (plate rigSpec)).length ++ " |\n" ++
  "| G-code instructions | " ++ toString rigJob.length ++ " |\n" ++
  "| pick-and-place rows | " ++ toString (manifest rigSpec).picks.length ++ " |\n" ++
  "| fastening operations | " ++ toString (manifest rigSpec).joints.length ++ " |\n\n" ++
  "## Checking the G-code\n\n" ++
  "```\n" ++
  "python3 tools/check_gcode.py pipespec/manifold.gcode pipespec/manifold-deposited.json \\\n" ++
  "    --envelope 22,24,8 --clock 644\n" ++
  "python3 tools/check_gcode.py pipespec/rig.gcode pipespec/rig-deposited.json \\\n" ++
  "    --envelope 22,32,3 --clock 909\n" ++
  "```\n\n" ++
  "The script simulates each G-code file independently, under the same rules the\n" ++
  "Lean machine enforces, and checks that the material it ends up with is exactly\n" ++
  "the set the Lean interpreter reports, and that the clock agrees with the tick\n" ++
  "count proved in Lean (`valveManifold_prints`, `rig_prints`).\n\n" ++
  "## The theorems behind the numbers\n\n" ++
  "- `emit_wf` — every generated spec is well-formed.\n" ++
  "- `wf_ends_perm`, `wf_two_mul_edges` — no dangling ports; two ports per segment.\n" ++
  "- `toolpath_prints`, `valveManifold_prints`, `rig_prints` — the job prints\n" ++
  "  exactly the plate the specification calls for, without a fault.\n" ++
  "- `picks_faithful` — the manifest carries every line of the bill.\n" ++
  "- `joints_ports_perm` — one fastening operation at each port, exactly once.\n" ++
  "- `parts_partition` — printed plus sourced is the whole bill.\n" ++
  "- `rig_buildable`, `selfHosting` — the spec from the rig's own self-description\n" ++
  "  is buildable on that rig.\n" ++
  "- `generations_buildable` — with the realization and fresh-BOSM assumptions\n" ++
  "  stated as hypotheses, every generation can build the next.\n\n" ++
  "See `bootstrap.md` for the twelve human steps and the five stated assumptions.\n"

/-- Write the files out. -/
def main (args : List String) : IO Unit := do
  let dir := args.headD "pipespec"
  IO.FS.createDirAll dir
  IO.FS.writeFile (dir ++ "/manifold.gcode")
    (gcode "the valve manifold's printed parts" manifoldJob)
  IO.println s!"wrote {dir}/manifold.gcode"
  IO.FS.writeFile (dir ++ "/manifold-deposited.json")
    (depositedJson (enum d3d.env (plate valveManifoldSpec)))
  IO.println s!"wrote {dir}/manifold-deposited.json"
  IO.FS.writeFile (dir ++ "/manifold-manifest.json") (manifestJson valveManifoldSpec)
  IO.println s!"wrote {dir}/manifold-manifest.json"
  IO.FS.writeFile (dir ++ "/manifold-bosm.txt") (bosmText valveManifoldSpec)
  IO.println s!"wrote {dir}/manifold-bosm.txt"
  IO.FS.writeFile (dir ++ "/rig.gcode") (gcode "the rig's own printed parts" rigJob)
  IO.println s!"wrote {dir}/rig.gcode"
  IO.FS.writeFile (dir ++ "/rig-deposited.json")
    (depositedJson (enum rigPrinter.env (plate rigSpec)))
  IO.println s!"wrote {dir}/rig-deposited.json"
  IO.FS.writeFile (dir ++ "/rig-manifest.json") (manifestJson rigSpec)
  IO.println s!"wrote {dir}/rig-manifest.json"
  IO.FS.writeFile (dir ++ "/rig-bosm.txt") (bosmText rigSpec)
  IO.println s!"wrote {dir}/rig-bosm.txt"
  IO.FS.writeFile (dir ++ "/bootstrap.md") bootstrapDoc
  IO.println s!"wrote {dir}/bootstrap.md"
  IO.FS.writeFile (dir ++ "/README.md") pipespecReadme
  IO.println s!"wrote {dir}/README.md"
