import Mathlib

/-!
# Skid-steer kinematics of the LifeTrac tractor

The LifeTrac (Open Source Ecology, Global Village Construction Set) is a
four-wheel, hydraulically driven tractor.  All wheels on one side are driven by
the same hydraulic circuit, so as far as steering is concerned the machine is a
*skid-steer* (differential drive) vehicle: it is completely described by the
ground speeds `vL`, `vR` of its left and right wheel pairs and by the track
width `W` (lateral distance between the two wheel pairs).

This file formalises

* the forward kinematics `(vL, vR) ↦ (v, ω)` (body linear and angular speed),
* the inverse kinematics `(v, ω) ↦ (vL, vR)` and the fact that the two are
  mutually inverse,
* the characterisations of straight driving and of a zero-radius ("spin in
  place") turn,
* the instantaneous turning radius,
* the exact trajectory generated by constant wheel speeds, together with a
  proof that it solves the unicycle differential equation and that it is a
  circular arc (resp. a straight line when `ω = 0`).
-/

namespace LifeTrac

/-- Geometry of the drive train of a skid-steer machine: the track width `W`,
i.e. the lateral distance between the left and right wheel pairs. -/
structure Chassis where
  /-- Track width (lateral distance between the left and right wheel pairs). -/
  track : ℝ
  track_pos : 0 < track

namespace Chassis

noncomputable section

/-- Forward speed of the chassis produced by wheel ground speeds `vL`, `vR`. -/
def linVel (_c : Chassis) (vL vR : ℝ) : ℝ := (vL + vR) / 2

/-- Yaw rate of the chassis produced by wheel ground speeds `vL`, `vR`
(counterclockwise positive). -/
def angVel (c : Chassis) (vL vR : ℝ) : ℝ := (vR - vL) / c.track

/-- Left wheel speed needed to realise body velocity `(v, ω)`. -/
def wheelL (c : Chassis) (v ω : ℝ) : ℝ := v - ω * c.track / 2

/-- Right wheel speed needed to realise body velocity `(v, ω)`. -/
def wheelR (c : Chassis) (v ω : ℝ) : ℝ := v + ω * c.track / 2

variable (c : Chassis) (vL vR v ω : ℝ)

@[simp] theorem linVel_wheels : c.linVel (c.wheelL v ω) (c.wheelR v ω) = v := by
  simp only [linVel, wheelL, wheelR]; ring

@[simp] theorem angVel_wheels : c.angVel (c.wheelL v ω) (c.wheelR v ω) = ω := by
  have h := c.track_pos.ne'
  simp only [angVel, wheelL, wheelR]
  field_simp
  ring

@[simp] theorem wheelL_velocities :
    c.wheelL (c.linVel vL vR) (c.angVel vL vR) = vL := by
  have h := c.track_pos.ne'
  simp only [linVel, angVel, wheelL]
  field_simp
  ring

@[simp] theorem wheelR_velocities :
    c.wheelR (c.linVel vL vR) (c.angVel vL vR) = vR := by
  have h := c.track_pos.ne'
  simp only [linVel, angVel, wheelR]
  field_simp
  ring

/-- Forward and inverse kinematics are mutually inverse bijections. -/
def kinematics : ℝ × ℝ ≃ ℝ × ℝ where
  toFun p := (c.linVel p.1 p.2, c.angVel p.1 p.2)
  invFun q := (c.wheelL q.1 q.2, c.wheelR q.1 q.2)
  left_inv p := by simp
  right_inv q := by simp

/-- The machine drives on a straight line exactly when both sides run at the
same speed. -/
theorem angVel_eq_zero_iff : c.angVel vL vR = 0 ↔ vL = vR := by
  rw [angVel, div_eq_zero_iff]
  constructor
  · rintro (h | h)
    · linarith
    · exact absurd h c.track_pos.ne'
  · intro h; left; linarith

/-- The machine turns on the spot (zero-radius turn) exactly when the two sides
run at opposite speeds. -/
theorem linVel_eq_zero_iff : c.linVel vL vR = 0 ↔ vL = -vR := by
  rw [linVel, div_eq_zero_iff]
  constructor
  · rintro (h | h)
    · linarith
    · norm_num at h
  · intro h; left; linarith

/-- A genuine spin in place: no translation but a nonzero yaw rate. -/
theorem spin_in_place (h : vR ≠ 0) :
    c.linVel (-vR) vR = 0 ∧ c.angVel (-vR) vR ≠ 0 := by
  refine ⟨by simp [linVel], ?_⟩
  simp only [angVel, ne_eq, div_eq_zero_iff, not_or]
  exact ⟨by intro hc; apply h; linarith, c.track_pos.ne'⟩

/-- Instantaneous turning radius (signed): the distance from the chassis centre
to the instantaneous centre of rotation. -/
def turnRadius : ℝ := c.linVel vL vR / c.angVel vL vR

theorem turnRadius_eq (h : vL ≠ vR) :
    c.turnRadius vL vR = c.track * (vR + vL) / (2 * (vR - vL)) := by
  have h' : vR - vL ≠ 0 := sub_ne_zero.mpr (Ne.symm h)
  have ht := c.track_pos.ne'
  simp only [turnRadius, linVel, angVel]
  field_simp
  ring

/-- Speed and yaw rate determine the turning radius as `v / ω`. -/
theorem turnRadius_wheels :
    c.turnRadius (c.wheelL v ω) (c.wheelR v ω) = v / ω := by
  simp [turnRadius]

/-- Driving one side only (`vL = 0`) pivots the machine about that side's
wheels: the turning radius is exactly half the track width. -/
theorem turnRadius_pivot (h : vR ≠ 0) : c.turnRadius 0 vR = c.track / 2 := by
  rw [turnRadius_eq c 0 vR (by simpa using h.symm), add_zero, sub_zero]
  field_simp

/-- With both wheel speeds bounded by `vmax`, the achievable body velocities
satisfy `|v| + |ω| * W / 2 ≤ vmax`; in particular the forward speed is at most
`vmax` and the yaw rate at most `2 * vmax / W`. -/
theorem velocity_envelope {vmax : ℝ} (hL : |c.wheelL v ω| ≤ vmax)
    (hR : |c.wheelR v ω| ≤ vmax) :
    |v| + |ω| * c.track / 2 ≤ vmax := by
  have hL' := abs_le.mp hL
  have hR' := abs_le.mp hR
  simp only [wheelL, wheelR] at hL' hR'
  rcases abs_cases v with ⟨hv, _⟩ | ⟨hv, _⟩ <;>
    rcases abs_cases ω with ⟨hw, _⟩ | ⟨hw, _⟩ <;>
      rw [hv, hw] <;> linarith [hL'.1, hL'.2, hR'.1, hR'.2]

/-! ### Trajectory generated by constant wheel speeds -/

/-- Heading of the machine at time `t`, starting from heading `θ₀` and turning
at constant yaw rate `ω`. -/
def heading (θ₀ ω t : ℝ) : ℝ := θ₀ + ω * t

/-- Planar position at time `t` for constant body velocity `(v, ω)`, starting
at the origin with heading `θ₀`.  For `ω = 0` this degenerates to the straight
line `t ↦ t * v * (cos θ₀, sin θ₀)` (see `pose_of_angVel_zero`). -/
def pose (θ₀ v ω t : ℝ) : ℝ × ℝ :=
  if ω = 0 then (t * v * Real.cos θ₀, t * v * Real.sin θ₀)
  else ((v / ω) * (Real.sin (θ₀ + ω * t) - Real.sin θ₀),
        (v / ω) * (Real.cos θ₀ - Real.cos (θ₀ + ω * t)))

@[simp] theorem pose_zero (θ₀ v ω : ℝ) : pose θ₀ v ω 0 = (0, 0) := by
  unfold pose; split <;> simp

theorem pose_of_angVel_zero (θ₀ v t : ℝ) :
    pose θ₀ v 0 t = (t * v * Real.cos θ₀, t * v * Real.sin θ₀) := by
  simp [pose]

/-- The trajectory solves the unicycle equation `ẋ = v cos θ(t)`. -/
theorem hasDerivAt_pose_fst (θ₀ v ω t : ℝ) :
    HasDerivAt (fun s => (pose θ₀ v ω s).1)
      (v * Real.cos (heading θ₀ ω t)) t := by
  unfold pose heading
  by_cases hω : ω = 0
  · subst hω
    simpa using ((hasDerivAt_id t).mul_const v).mul_const (Real.cos θ₀)
  · simp only [hω, if_neg, not_false_iff]
    have hs : HasDerivAt (fun s => Real.sin (θ₀ + ω * s))
        (Real.cos (θ₀ + ω * t) * ω) t := by
      have h1 : HasDerivAt (fun s : ℝ => θ₀ + ω * s) ω t := by
        simpa using ((hasDerivAt_id t).const_mul ω).const_add θ₀
      exact (Real.hasDerivAt_sin _).comp t h1
    have h2 := ((hs.sub_const (Real.sin θ₀)).const_mul (v / ω))
    convert h2 using 1
    field_simp

/-- The trajectory solves the unicycle equation `ẏ = v sin θ(t)`. -/
theorem hasDerivAt_pose_snd (θ₀ v ω t : ℝ) :
    HasDerivAt (fun s => (pose θ₀ v ω s).2)
      (v * Real.sin (heading θ₀ ω t)) t := by
  unfold pose heading
  by_cases hω : ω = 0
  · subst hω
    simpa using ((hasDerivAt_id t).mul_const v).mul_const (Real.sin θ₀)
  · simp only [hω, if_neg, not_false_iff]
    have hc : HasDerivAt (fun s => Real.cos (θ₀ + ω * s))
        (-Real.sin (θ₀ + ω * t) * ω) t := by
      have h1 : HasDerivAt (fun s : ℝ => θ₀ + ω * s) ω t := by
        simpa using ((hasDerivAt_id t).const_mul ω).const_add θ₀
      exact (Real.hasDerivAt_cos _).comp t h1
    have h2 := ((hc.const_sub (Real.cos θ₀)).const_mul (v / ω))
    convert h2 using 1
    field_simp

/-- The heading solves `θ̇ = ω`. -/
theorem hasDerivAt_heading (θ₀ ω t : ℝ) :
    HasDerivAt (fun s => heading θ₀ ω s) ω t := by
  simpa [heading] using ((hasDerivAt_id t).const_mul ω).const_add θ₀

/-- Instantaneous centre of rotation of a turn with body velocity `(v, ω)`,
`ω ≠ 0`, starting at the origin with heading `θ₀`. -/
def icc (θ₀ v ω : ℝ) : ℝ × ℝ :=
  (-(v / ω) * Real.sin θ₀, (v / ω) * Real.cos θ₀)

/-- For `ω ≠ 0` the trajectory is a circle of radius `|v / ω|` (the turning
radius) about the instantaneous centre of rotation. -/
theorem pose_dist_icc (θ₀ v ω t : ℝ) (hω : ω ≠ 0) :
    ((pose θ₀ v ω t).1 - (icc θ₀ v ω).1) ^ 2
      + ((pose θ₀ v ω t).2 - (icc θ₀ v ω).2) ^ 2 = (v / ω) ^ 2 := by
  simp only [pose, icc, if_neg hω]
  have h := Real.sin_sq_add_cos_sq (θ₀ + ω * t)
  nlinarith [h]

end

end Chassis

end LifeTrac
