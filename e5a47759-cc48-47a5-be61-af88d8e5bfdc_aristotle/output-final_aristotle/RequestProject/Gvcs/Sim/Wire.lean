import RequestProject.Gvcs.Sim.Auto

/-!
# The wire: the game side of the interface, written out of Lean

`Sim/Interface.lean` defines the protocol and proves its properties; a game
running somewhere else needs an implementation of the same protocol in its own
language, and some way of being sure that implementation agrees with the one
the proofs are about.  This file provides both.

* `controlJs` and `controlLua` — the encoder and decoder for a browser game and
  for Roblox, written in the same two-byte-per-axis, checksummed format;
* `vectorsJson` — conformance vectors: a set of commands, together with the
  bytes **Lean's own `Interface.encode` produces for them**, so the game-side
  implementation can be checked byte for byte against the specification rather
  than against a second reading of the prose;
* `missionJson` — the autopilot run of `Sim/Auto.lean`, tick by tick, as the
  commands that went down the wire and the state of the machine that came
  back, so a game can replay the verified mission and compare.

`lake exe control` (see `Control.lean`) writes the three files out;
`tools/check_control.mjs` runs the emitted JavaScript against the emitted
vectors.
-/

namespace LifeTrac
namespace Wire

open Interface Auto

/-! ## Small printing helpers -/

/-- One hexadecimal digit. -/
def hexDigit (n : ℕ) : Char :=
  if n < 10 then Char.ofNat (48 + n) else Char.ofNat (87 + n)

/-- A byte in hexadecimal. -/
def hexByte (b : UInt8) : String :=
  String.ofList [hexDigit (b.toNat / 16), hexDigit (b.toNat % 16)]

/-- A frame in hexadecimal. -/
def hexBytes (bs : List UInt8) : String := String.join (bs.map hexByte)

/-- A JSON array of the bytes of a frame. -/
def byteArray (bs : List UInt8) : String :=
  "[" ++ String.intercalate ", " (bs.map (fun b => toString b.toNat)) ++ "]"

/-- A rational of the simulation as a whole number of thousandths — every
quantity the game keeps is on that grid. -/
def milli (q : ℚ) : ℤ := (q * 1000).num

/-- A command as JSON. -/
def jsonCommand (c : Command) : String :=
  "{\"throttle\": " ++ toString c.throttle ++ ", \"steer\": " ++ toString c.steer ++
    ", \"lift\": " ++ toString c.lift ++ ", \"tilt\": " ++ toString c.tilt ++
    ", \"ignition\": " ++ (if c.ignition then "true" else "false") ++
    ", \"lights\": " ++ (if c.lights then "true" else "false") ++ "}"

/-! ## Conformance vectors -/

/-- The commands the vectors cover: neutral, the worked example, both stops,
and two that ask for more than full scale and so must come back clamped. -/
def sampleCommands : List Command :=
  [ Command.neutral,
    sampleCommand,
    ⟨1000, 1000, 1000, 1000, true, false⟩,
    ⟨-1000, -1000, -1000, -1000, false, true⟩,
    ⟨5000, -7000, 1, -1, true, true⟩,
    ⟨0, 0, -1000, 1000, false, false⟩ ]

/-- One vector: a command, the command as the machine will read it, and the
bytes Lean puts on the wire for it. -/
def vectorJson (c : Command) : String :=
  "  {\"command\": " ++ jsonCommand c ++ ",\n   \"sanitized\": " ++ jsonCommand c.sanitize ++
    ",\n   \"frame\": " ++ byteArray (encode c.sanitize) ++
    ",\n   \"hex\": \"" ++ hexBytes (encode c.sanitize) ++ "\"}"

/-- The conformance vectors, as JSON. -/
def vectorsJson : String :=
  "{\n \"protocol\": \"LifeTrac control v1\",\n \"frameLength\": 13,\n \"vectors\": [\n" ++
    String.intercalate ",\n" (sampleCommands.map vectorJson) ++ "\n ]\n}\n"

/-! ## The mission, as the game would see it -/

/-- One tick of the autopilot run: the tick number, the phase, the command that
went out (in bytes) and the state that came back, all in thousandths. -/
def missionRow (n : ℕ) : String :=
  let w := run demoSim demoMission n start
  let c := command demoSim demoMission w
  let phase : String :=
    match w.phase with
    | .drive => "drive"
    | .raise => "raise"
    | .turn => "turn"
    | .done => "done"
  "  {\"tick\": " ++ toString n ++ ", \"phase\": \"" ++ phase ++
    "\", \"passes\": " ++ toString w.passDone ++
    ", \"speed_mmps\": " ++ toString (milli w.plant.speed) ++
    ", \"travel_mm\": " ++ toString (milli w.plant.travel) ++
    ", \"lift_mm\": " ++ toString (milli w.plant.lift) ++
    ", \"frame\": " ++ byteArray (encode c.sanitize) ++ "}"

/-- The ticks the mission file reports: every fifth tick of the job. -/
def missionTicks : List ℕ := (List.range 108).map (fun i => 5 * i)

/-- The autopilot run, as JSON. -/
def missionJson : String :=
  "{\n \"mission\": {\"passLength_mm\": " ++ toString (milli demoMission.passLength) ++
    ", \"passes\": " ++ toString demoMission.passes ++
    ", \"cruise_mmps\": " ++ toString (milli demoMission.cruise) ++
    "},\n \"tick_ms\": " ++ toString (milli demoSim.dt) ++
    ",\n \"states\": [\n" ++
    String.intercalate ",\n" (missionTicks.map missionRow) ++ "\n ]\n}\n"

/-! ## The game-side implementations -/

/-- The browser implementation of the protocol. -/
def controlJs : String :=
"// LifeTrac control protocol, version 1.
// Generated by `lake exe control` from RequestProject/Sim/Interface.lean.
// The format is proved round-tripping there; `tools/check_control.mjs` checks
// this implementation against the vectors Lean emits.

export const HEADER = [0x4C, 0x54, 0x01];
export const TELEMETRY_HEADER = [0x4C, 0x54, 0x02];
export const FRAME_LENGTH = 13;

export function clampAxis(x) {
  const n = Math.trunc(x);
  return Math.max(-1000, Math.min(1000, n));
}

export function sanitize(c) {
  return { throttle: clampAxis(c.throttle), steer: clampAxis(c.steer),
           lift: clampAxis(c.lift), tilt: clampAxis(c.tilt),
           ignition: !!c.ignition, lights: !!c.lights };
}

export function checksum(bytes) {
  let a = 0;
  for (const b of bytes) a = (a + b) % 256;
  return a;
}

function encAxis(x) {
  const n = clampAxis(x) + 1000;
  return [Math.floor(n / 256), n % 256];
}

export function encode(cmd) {
  const c = sanitize(cmd);
  const payload = [].concat(encAxis(c.throttle), encAxis(c.steer), encAxis(c.lift),
                            encAxis(c.tilt),
                            [(c.ignition ? 1 : 0) + (c.lights ? 2 : 0)]);
  return [].concat(HEADER, payload, [checksum(payload)]);
}

export function decode(bytes) {
  if (bytes.length !== FRAME_LENGTH) return null;
  if (bytes[0] !== HEADER[0] || bytes[1] !== HEADER[1] || bytes[2] !== HEADER[2]) return null;
  const payload = bytes.slice(3, 12);
  if (bytes[12] !== checksum(payload)) return null;
  const axis = (i) => bytes[3 + 2 * i] * 256 + bytes[4 + 2 * i] - 1000;
  const flags = bytes[11];
  return { throttle: axis(0), steer: axis(1), lift: axis(2), tilt: axis(3),
           ignition: flags % 2 === 1, lights: Math.floor(flags / 2) % 2 === 1 };
}

export function encodeTelemetry(t) {
  const word = (x) => [Math.floor(x / 256) % 256, x % 256];
  const axis = (x) => { const n = clampAxis(x) + 1000; return [Math.floor(n / 256), n % 256]; };
  const payload = [].concat(word(t.batt_mV), word(t.press_kPa), word(t.rpm),
                            axis(t.speed_mmps));
  return [].concat(TELEMETRY_HEADER, payload, [checksum(payload)]);
}

export function decodeTelemetry(bytes) {
  if (bytes.length !== 12) return null;
  if (bytes[0] !== TELEMETRY_HEADER[0] || bytes[1] !== TELEMETRY_HEADER[1] ||
      bytes[2] !== TELEMETRY_HEADER[2]) return null;
  const payload = bytes.slice(3, 11);
  if (bytes[11] !== checksum(payload)) return null;
  const word = (i) => bytes[3 + 2 * i] * 256 + bytes[4 + 2 * i];
  return { batt_mV: word(0), press_kPa: word(1), rpm: word(2),
           speed_mmps: bytes[9] * 256 + bytes[10] - 1000 };
}

// The controls of the game, as a command: two sticks and two switches.
export function commandFromInput(input) {
  return sanitize({
    throttle: Math.round(1000 * (input.forward || 0)),
    steer: Math.round(1000 * (input.right || 0)),
    lift: Math.round(1000 * (input.lift || 0)),
    tilt: Math.round(1000 * (input.tilt || 0)),
    ignition: !!input.ignition,
    lights: !!input.lights,
  });
}
"

/-- The Roblox implementation of the protocol. -/
def controlLua : String :=
"-- LifeTrac control protocol, version 1.
-- Generated by `lake exe control` from RequestProject/Sim/Interface.lean.
-- Drop this ModuleScript into ReplicatedStorage and require it from both the
-- controls (which build command frames) and the machine (which reads them).

local M = {}

M.HEADER = {0x4C, 0x54, 0x01}
M.TELEMETRY_HEADER = {0x4C, 0x54, 0x02}
M.FRAME_LENGTH = 13

local function clampAxis(x)
  local n = math.floor(x)
  if n < -1000 then return -1000 end
  if n > 1000 then return 1000 end
  return n
end

M.clampAxis = clampAxis

function M.sanitize(c)
  return {
    throttle = clampAxis(c.throttle or 0),
    steer = clampAxis(c.steer or 0),
    lift = clampAxis(c.lift or 0),
    tilt = clampAxis(c.tilt or 0),
    ignition = c.ignition and true or false,
    lights = c.lights and true or false,
  }
end

function M.checksum(bytes)
  local a = 0
  for _, b in ipairs(bytes) do a = (a + b) % 256 end
  return a
end

local function encAxis(out, x)
  local n = clampAxis(x) + 1000
  out[#out + 1] = math.floor(n / 256)
  out[#out + 1] = n % 256
end

function M.encode(cmd)
  local c = M.sanitize(cmd)
  local payload = {}
  encAxis(payload, c.throttle)
  encAxis(payload, c.steer)
  encAxis(payload, c.lift)
  encAxis(payload, c.tilt)
  payload[#payload + 1] = (c.ignition and 1 or 0) + (c.lights and 2 or 0)
  local frame = {M.HEADER[1], M.HEADER[2], M.HEADER[3]}
  for _, b in ipairs(payload) do frame[#frame + 1] = b end
  frame[#frame + 1] = M.checksum(payload)
  return frame
end

function M.decode(frame)
  if #frame ~= M.FRAME_LENGTH then return nil end
  if frame[1] ~= M.HEADER[1] or frame[2] ~= M.HEADER[2] or frame[3] ~= M.HEADER[3] then
    return nil
  end
  local payload = {}
  for i = 4, 12 do payload[#payload + 1] = frame[i] end
  if frame[13] ~= M.checksum(payload) then return nil end
  local function axis(i)
    return frame[4 + 2 * i] * 256 + frame[5 + 2 * i] - 1000
  end
  local flags = frame[12]
  return {
    throttle = axis(0),
    steer = axis(1),
    lift = axis(2),
    tilt = axis(3),
    ignition = flags % 2 == 1,
    lights = math.floor(flags / 2) % 2 == 1,
  }
end

-- Turn the player's input into a command frame.
function M.commandFromInput(input)
  return M.sanitize({
    throttle = math.floor(1000 * (input.forward or 0) + 0.5),
    steer = math.floor(1000 * (input.right or 0) + 0.5),
    lift = math.floor(1000 * (input.lift or 0) + 0.5),
    tilt = math.floor(1000 * (input.tilt or 0) + 0.5),
    ignition = input.ignition,
    lights = input.lights,
  })
end

return M
"

end Wire
end LifeTrac
