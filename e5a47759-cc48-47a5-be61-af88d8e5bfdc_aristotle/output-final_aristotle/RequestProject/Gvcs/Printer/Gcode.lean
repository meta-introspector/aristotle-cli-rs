import RequestProject.Gvcs.Printer.SelfPrint

/-!
# Writing the job out as G-code

The instruction set of `RequestProject/Printer/Machine.lean` is the abstract
syntax of G-code; this file prints it.  `gcode` turns a job into the text a
printer eats — `G28`, `M109 S205`, `G0`/`G1` moves with a cumulative `E` axis,
`G4` dwells — at ten millimetres to the cell.

`lake exe printer` (see `Printer.lean` at the root) writes the self-print job
of `RequestProject/Printer/SelfPrint.lean` out as `printer/selfprint.gcode`,
together with `printer/deposited.json`, the voxels the Lean interpreter says
the job leaves on the bed.  `tools/check_gcode.py` re-simulates the emitted
text independently and checks it against that list, so the file on disk is
tied back to the theorems.

`gcode_length` is the only claim made here: one line of G-code per
instruction.
-/

namespace LifeTrac
namespace Printer

open Voxel

/-- Millimetres to the cell. -/
def cellMm : ℤ := 10

/-- How much filament an instruction pushes, in cells. -/
def extrusion : Instr → ℕ
  | .extrude _ => 1
  | _ => 0

/-- One instruction as one line of G-code, given the filament used so far. -/
def render (e : ℕ) : Instr → String
  | .home => "G28"
  | .setTemp t => "M109 S" ++ toString t
  | .travel p =>
      "G0 X" ++ toString (p.x * cellMm) ++ " Y" ++ toString (p.y * cellMm) ++
        " Z" ++ toString (p.z * cellMm)
  | .extrude p =>
      "G1 X" ++ toString (p.x * cellMm) ++ " Y" ++ toString (p.y * cellMm) ++
        " Z" ++ toString (p.z * cellMm) ++ " E" ++ toString (e + 1)
  | .dwell n => "G4 P" ++ toString n

/-- The whole job, line by line, with a cumulative extruder axis. -/
def gcodeLines (e : ℕ) : List Instr → List String
  | [] => []
  | i :: p => render e i :: gcodeLines (e + extrusion i) p

/-- One line of G-code per instruction. -/
theorem gcodeLines_length (e : ℕ) (p : List Instr) : (gcodeLines e p).length = p.length := by
  induction p generalizing e with
  | nil => rfl
  | cons i p ih => simp [gcodeLines, ih]

/-- The job as one string, with a header. -/
def gcode (name : String) (p : List Instr) : String :=
  "; " ++ name ++ "\n; generated by the Lean model in RequestProject/Printer\n" ++
    "; " ++ toString p.length ++ " instructions, " ++
    toString (p.filter fun i => decide (extrusion i = 1)).length ++ " cells of filament\n" ++
    "G21 ; millimetres\nG90 ; absolute\n" ++
    String.join ((gcodeLines 0 p).map fun l => l ++ "\n") ++
    "; end of job\nM104 S0 ; hot end off\nM84 ; motors off\n"

/-- The voxels the interpreter leaves on the bed, as JSON, for an outside
checker to compare the emitted G-code against. -/
def depositedJson (l : List Vox) : String :=
  let pt := fun (v : Vox) =>
    "[" ++ toString v.x ++ "," ++ toString v.y ++ "," ++ toString v.z ++ "]"
  "[" ++ String.intercalate "," (l.map pt) ++ "]\n"

end Printer
end LifeTrac
