partial def dec (acc : List Char) : List Char -> List Char
  | a :: b :: c :: r =>
      dec (Char.ofNat ((a.toNat - 48) * 100 + (b.toNat - 48) * 10 + (c.toNat - 48)) :: acc) r
  | _ => acc.reverse

partial def splitSep (acc : List Char) : List Char -> List (List Char)
  | [] => [acc.reverse]
  | c :: r => if c.toNat == 1 then acc.reverse :: splitSep [] r else splitSep (c :: acc) r

partial def chunk (n : Nat) : List Char -> List (List Char)
  | [] => []
  | l => l.take n :: chunk n (l.drop n)

def main : IO Unit := do
  let s := (String.join p).toList
  let d := s.filter (fun c => decide (48 <= c.toNat) && decide (c.toNat <= 57))
  let g := (splitSep [] (dec [] d)).map String.ofList
  let j := 21
  let body := String.intercalate (g.getD (5 * j + 3) "")
    ((chunk 4000 d).map String.ofList)
  IO.print (g.getD (5 * j) "" ++ "@" ++ g.getD (5 * j + 2) "" ++ body
    ++ g.getD (5 * j + 4) "" ++ "@" ++ g.getD (5 * j + 1) "")