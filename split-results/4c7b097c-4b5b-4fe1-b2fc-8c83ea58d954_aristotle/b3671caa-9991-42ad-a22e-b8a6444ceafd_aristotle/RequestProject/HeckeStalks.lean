/-
# Hecke Stalks: Spectral Sequences and Moonshine

Formalization of the spectral sequence structure connecting the Monster group's
primary grid to the j-function coefficients via moonshine. The key structures are:

- The 46×20 primary grid as a spectral page E₂
- The degeneration condition E₂ = E∞ (genus-zero property)
- The McKay observation: j(τ) = q⁻¹ + 196884q + ⋯ and 196884 = 196883 + 1
- The Borcherds product enumeration over primary grid cells

This file imports MonsterOrder for the grid definitions.
-/
import Mathlib
import RequestProject.MonsterOrder

/-! ## Spectral Pages -/

/-- A spectral page: a ℤ-valued function on the grid indices. -/
def SpectralPage := ℕ → ℕ → ℤ

instance : Inhabited SpectralPage := ⟨fun _ _ => 0⟩

/-- The zero spectral page. -/
def SpectralPage.zero : SpectralPage := fun _ _ => 0

/-! ## j-function coefficients -/

/-- The first few coefficients of the j-function:
    j(τ) = q⁻¹ + 744 + 196884q + 21493760q² + ⋯
    We index by n ≥ 0 so jFunctionCoeffs n is the coefficient of qⁿ. -/
def jFunctionCoeffs : ℕ → ℤ
  | 0 => 744
  | 1 => 196884
  | 2 => 21493760
  | 3 => 864299970
  | 4 => 20245856256
  | _ => 0  -- truncated for this formalization

/-- The dimension of the trivial representation of the Monster. -/
def monsterTrivialDim : ℕ := 1

/-- The dimension of the smallest nontrivial irreducible representation of the Monster. -/
def monsterFirstIrrepDim : ℕ := 196883

/-! ## McKay's Observation -/

/-- McKay's observation: the first nontrivial j-coefficient equals
    the dimension of the Monster's smallest nontrivial irrep plus 1. -/
theorem mckay_observation :
    jFunctionCoeffs 1 = ↑(monsterFirstIrrepDim + monsterTrivialDim) := by native_decide

/-- The coefficient 196884 factors as 196883 + 1. -/
theorem j1_decomposition : (196884 : ℤ) = 196883 + 1 := by norm_num

/-- The second coefficient decomposes as:
    21493760 = 21296876 + 196883 + 1
    where 21296876 is the dimension of the next Monster irrep. -/
theorem j2_decomposition : (21493760 : ℤ) = 21296876 + 196883 + 1 := by norm_num

/-! ## Moonshine Spectral Page -/

/-- The moonshine E₂ page: maps grid position (i,j) to the j-function
    coefficient at index 2^i · 3^j.
    This encodes the Hecke structure of moonshine on the primary grid. -/
def moonshineE2 (jCoeffs : ℕ → ℤ) : SpectralPage :=
  fun i j => jCoeffs (2 ^ i * 3 ^ j)

/-- Spectral degeneration: the spectral sequence collapses at E₂.
    This is the genus-zero property — no higher differentials contribute. -/
def spectralDegeneration (E2 Einf : SpectralPage) : Prop :=
  ∀ i j, E2 i j = Einf i j

/-- The trivial degeneration: any page degenerates to itself. -/
theorem spectralDegeneration_refl (E : SpectralPage) :
    spectralDegeneration E E :=
  fun _ _ => rfl

/-! ## Grid-indexed Borcherds terms -/

/-- A Borcherds term indexed by a primary grid cell.
    Each cell (a, b) contributes the factor (1 - q^(2^a · 3^b))^c(2^a · 3^b)
    to the Borcherds product, where c(n) is the n-th j-coefficient. -/
structure BorcherdsTerm where
  cell : PrimaryGridCell
  exponent : ℤ  -- the j-coefficient c(2^a · 3^b)

/-- Construct a Borcherds term from a grid cell and j-coefficients. -/
def mkBorcherdsTerm (cell : PrimaryGridCell) (jCoeffs : ℕ → ℤ) : BorcherdsTerm where
  cell := cell
  exponent := jCoeffs (2 ^ cell.row.val * 3 ^ cell.col.val)

/-- The number of primary Borcherds terms equals the primary grid dimension. -/
theorem borcherds_primary_terms :
    Fintype.card PrimaryGridCell = primary_grid_dim := card_primaryGridCell

/-! ## Replication Formulas -/

/-- The Hecke operator T_n on j-coefficients satisfies replication formulas.
    For prime p, T_p acts by: (T_p f)(τ) = f(pτ) + Σ_{k=0}^{p-1} f((τ+k)/p)
    This is the restriction map in the moonshine sheaf. -/
def heckeAction (p : ℕ) (jCoeffs : ℕ → ℤ) : ℕ → ℤ :=
  fun n => jCoeffs (p * n)  -- simplified: just the f(pτ) term

/-- The Hecke action at (2,3) matches the moonshine E₂ page. -/
theorem heckeAction_eq_moonshineE2 (jCoeffs : ℕ → ℤ) (i j : ℕ) :
    moonshineE2 jCoeffs i j = jCoeffs (2 ^ i * 3 ^ j) := rfl

/-! ## Genus-zero property -/

/-- A modular curve is genus-zero if its function field is generated by
    a single element (the Hauptmodul). For SSP primes, X₀(p)⁺ has genus zero. -/
def isGenusZero (_p : ℕ) : Prop :=
  _p ∈ sspPrimes

/-- All SSP primes give genus-zero modular curves. -/
theorem ssp_genus_zero : ∀ p ∈ sspPrimes, isGenusZero p :=
  fun _p hp => hp

/-! ## Grid Navigation -/

/-- Successor cell in row direction (if exists). -/
def PrimaryGridCell.succRow (cell : PrimaryGridCell) : Option PrimaryGridCell :=
  if h : cell.row.val + 1 < monster_v2
  then some ⟨⟨cell.row.val + 1, h⟩, cell.col⟩
  else none

/-- Successor cell in column direction (if exists). -/
def PrimaryGridCell.succCol (cell : PrimaryGridCell) : Option PrimaryGridCell :=
  if h : cell.col.val + 1 < monster_v3
  then some ⟨cell.row, ⟨cell.col.val + 1, h⟩⟩
  else none

/-- The origin cell (0, 0). -/
def PrimaryGridCell.origin : PrimaryGridCell :=
  ⟨⟨0, by unfold monster_v2; omega⟩, ⟨0, by unfold monster_v3; omega⟩⟩

/-- The 2^a · 3^b index of a grid cell. -/
def PrimaryGridCell.heckeIndex (cell : PrimaryGridCell) : ℕ :=
  2 ^ cell.row.val * 3 ^ cell.col.val

/-- The Hecke index at the origin is 1. -/
theorem PrimaryGridCell.heckeIndex_origin :
    PrimaryGridCell.origin.heckeIndex = 1 := by
  simp [PrimaryGridCell.origin, PrimaryGridCell.heckeIndex]

/-- The j-coefficient at the origin cell (0,0) is 196884 (the McKay coefficient),
    since heckeIndex(0,0) = 2⁰·3⁰ = 1. -/
theorem j_at_origin :
    jFunctionCoeffs PrimaryGridCell.origin.heckeIndex = 196884 := by
  native_decide
