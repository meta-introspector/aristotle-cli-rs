/-
  Monster group order and modular lattice of ℤ/|M|ℤ in Lean 4.

  We formalize:
  • The exact order of the Monster group |M|.
  • Subgroup "boxes" of ℤ/|M|ℤ indexed by divisors d ∣ |M|,
    defined as AddSubgroup.zmultiples (d : ZMod |M|).
  • The key lattice-theoretic fact: if d₁ ∣ d₂ ∣ |M| then the
    subgroup generated by d₂ is contained in the subgroup generated by d₁.
    (The divisor lattice maps contravariantly into the subgroup lattice.)
  • A "moonshine box" constructor for irreducible representation dimensions.
-/
import Mathlib

open ZMod Finset

/-! ## Monster group order -/

/-- The order of the Monster group (exact). -/
def MonsterOrder : ℕ := 808017424794512875886459904961710757005754368000000000

/-- MonsterOrder is positive. -/
theorem MonsterOrder_pos : 0 < MonsterOrder := by norm_num [MonsterOrder]

/-! ## Subgroup boxes -/

/-- The subgroup "box" of ℤ/nℤ generated by `d`.
    When `d ∣ n` this is the unique subgroup of order `n / d`. -/
def subgroupBox (n : ℕ) (d : ℕ) : AddSubgroup (ZMod n) :=
  AddSubgroup.zmultiples (d : ZMod n)

/-! ## Divisor chain ⟹ subgroup chain -/

/-
If `d₁ ∣ d₂` then the box of `d₂` is contained in the box of `d₁`.
    This is the contravariant embedding of the divisor lattice into
    the subgroup lattice of ℤ/nℤ.
-/
theorem subgroupBox_antitone (n : ℕ) {d₁ d₂ : ℕ} (h : d₁ ∣ d₂) :
    subgroupBox n d₂ ≤ subgroupBox n d₁ := by
  intro x;
  obtain ⟨ k, rfl ⟩ := h;
  rintro ⟨ y, rfl ⟩;
  exact ⟨ y * k, by simp +decide [mul_comm, mul_left_comm] ⟩

/-! ## Example divisor sets -/

/-- Sample divisors from the user's DS list. -/
def MonsterDivs : List ℕ :=
