/-! ## Moonshine box -/

/-- Construct the moonshine box for an irrep dimension `dim` that divides |M|. -/
def moonshineBox (dim : ℕ) : AddSubgroup (ZMod MonsterOrder) :=
  subgroupBox MonsterOrder dim

/-! ## Lattice interval surrounding a subset -/

/-- The "approximate subset in box": elements of the subgroup box of `d`
    that are translates of elements in `A` by multiples of `d`. -/
def approxSubsetInBox (n d : ℕ) (A : Set (ZMod n)) : Set (ZMod n) :=
  { x | x ∈ subgroupBox n d ∧ ∃ k : ℤ, (k * (d : ZMod n)) ∈ A }

/-! ## Subgroup box lattice is modular -/

/-
The subgroup lattice of any abelian group is modular.
    In particular, the lattice of boxes in ℤ/|M|ℤ is modular.
-/
theorem subgroupBox_lattice_modular (n : ℕ) :
    IsModularLattice (AddSubgroup (ZMod n)) := by
  infer_instance