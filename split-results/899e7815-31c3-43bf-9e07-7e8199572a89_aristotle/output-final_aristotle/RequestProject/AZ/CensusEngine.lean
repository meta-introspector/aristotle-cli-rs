import Mathlib
import RequestProject.AZ.TenfoldWay
import RequestProject.AZ.Patterns

/-!
# The dimension-advancing extension engine for the AZ table

`RequestProject.AZ.Patterns` proves that the Altland–Zirnbauer K-group **census** — the
multiset of classifying groups carried by the ten symmetry classes — is the *same in
every spatial dimension* (`AZ.Patterns.kgroup_multiset_const`).  This file turns that
static invariant into a *dynamical* statement: it builds a small **extension engine**
whose single-step "cart" operation is the dimensional shift `d ↦ d + 1` on the periodic
table, and proves three things.

1. **Census conservation law.**  The engine preserves the K-group census at every finite
   approximation step (`dim_census_conserved`, `run_census_conserved`): no matter how
   many dimensions the engine advances, the multiset of classifying groups is unchanged.

2. **Bott-clock periodicity (engine limit).**  The infinite stream of periodic-table
   *columns* generated by the engine is strictly `8`-periodic for the real series
   (`column_period8`, `column_minimal_period8`) and strictly `2`-periodic for the
   complex series (`complex_period2`, `complex_minimal_period2`).

3. **The clock itself.**  Every column depends on the dimension only through `d % 8`
   (`column_eq_mod8`), i.e. the engine runs on the `ℤ₈` Bott clock.

The engine is phrased generically (`Engine`, `Engine.Conserves`) so the conservation
law is a reusable lemma, then specialised to the AZ dimensional shift.
-/

namespace AZ
namespace CensusEngine

open Class

/-! ## 1. A generic discrete extension engine -/

/-- A discrete-time **extension engine** on a state space `S`: a single-step "cart"
advance.  Iterating `step` generates the engine's infinite stream of states. -/
structure Engine (S : Type*) where
  /-- The one-step advance ("cart"). -/
  step : S → S

namespace Engine

variable {S : Type*}

/-- Run the engine for `n` steps from a starting state — the `n`-th finite approximation
of the generated infinite stream. -/
def run (E : Engine S) (n : ℕ) (s : S) : S := E.step^[n] s

@[simp] theorem run_zero (E : Engine S) (s : S) : E.run 0 s = s := rfl

theorem run_succ (E : Engine S) (n : ℕ) (s : S) :
    E.run (n + 1) s = E.run n (E.step s) :=
  Function.iterate_succ_apply E.step n s

theorem run_succ' (E : Engine S) (n : ℕ) (s : S) :
    E.run (n + 1) s = E.step (E.run n s) :=
  Function.iterate_succ_apply' E.step n s

/-- An engine **conserves** a quantity `inv` if every step leaves it unchanged. -/
def Conserves {α : Type*} (E : Engine S) (inv : S → α) : Prop :=
  ∀ s, inv (E.step s) = inv s

/-- A conserved quantity is conserved across *any* finite number of engine steps. -/
theorem run_conserves {α : Type*} (E : Engine S) (inv : S → α)
    (h : E.Conserves inv) (n : ℕ) (s : S) : inv (E.run n s) = inv s := by
  induction n with
  | zero => rfl
  | succ n ih => rw [run_succ', h, ih]

end Engine

/-! ## 2. The AZ census and the dimensional-shift engine -/

/-- The K-group **census** in spatial dimension `d`: the multiset of classifying groups
carried by the ten Altland–Zirnbauer classes. -/
def dimCensus (d : ℕ) : Multiset KGroup :=
  Multiset.map (fun c : Class => classify c d) Finset.univ.val

/-- The **dimension-advancing engine**: its cart operation is the dimensional shift
`d ↦ d + 1` on the AZ periodic table. -/
def dimEngine : Engine ℕ := ⟨fun d => d + 1⟩

/-- Running the dimensional engine for `n` steps advances the dimension by `n`. -/
theorem dim_run_eq (n d : ℕ) : dimEngine.run n d = d + n := by
  induction n with
  | zero => simp
  | succ n ih => rw [dimEngine.run_succ', ih]; rfl

/-! ## 3. The census conservation law -/

/-- **Census conservation (one step).**  Advancing the dimension by one leaves the
K-group census unchanged: the engine conserves `dimCensus`. -/
theorem dim_census_conserved : dimEngine.Conserves dimCensus := by
  intro d
  show dimCensus (d + 1) = dimCensus d
  unfold dimCensus
  rw [Patterns.kgroup_multiset_const (d + 1), Patterns.kgroup_multiset_const d]

/-- **Census conservation law.**  At every finite approximation step the
dimension-advancing engine preserves the K-group census exactly. -/
theorem run_census_conserved (n d : ℕ) :
    dimCensus (dimEngine.run n d) = dimCensus d :=
  dimEngine.run_conserves dimCensus dim_census_conserved n d

/-- The census generated along the engine's stream from dimension `0` is constant. -/
theorem stream_census_const (n : ℕ) :
    dimCensus (dimEngine.run n 0) = dimCensus 0 :=
  run_census_conserved n 0

/-! ## 4. Bott-clock periodicity: the engine limit

The "infinite stream generated by the engine" is captured by the family of
periodic-table *columns* `column d : Class → KGroup`.  We show this stream lives on the
`ℤ₈` Bott clock and read off its exact (minimal) periods for the real and complex
series. -/

/-- The periodic-table **column** in dimension `d`: the classifying group of every class
at once.  `fun n => column n` is the infinite stream generated by `dimEngine`. -/
def column (d : ℕ) : Class → KGroup := fun c => classify c d

/-- The engine stream runs on the `ℤ₈` Bott clock: a column depends on the dimension
only through `d % 8`. -/
theorem column_eq_mod8 (d : ℕ) : column d = column (d % 8) := by
  funext c; exact classify_mod8 c d

/-- **Real series: 8-periodicity.**  The full column stream is `8`-periodic. -/
theorem column_period8 (d : ℕ) : column (d + 8) = column d := by
  funext c; exact classify_periodic8 c d

/-- **Real series: minimal period 8.**  No positive shift smaller than `8` is a period:
the class `AI` already distinguishes all of them, so `8` is the *exact* period of the
real series.  (Witnessed at base dimension `0`: `classify AI p ≠ classify AI 0` for
`0 < p < 8`.) -/
theorem column_minimal_period8 (p : ℕ) (hp : 0 < p) (hp8 : p < 8) :
    column p Class.AI ≠ column 0 Class.AI := by
  show classify Class.AI p ≠ classify Class.AI 0
  interval_cases p <;> decide

/-- **Complex series: 2-periodicity.**  For the two complex classes the engine stream is
already `2`-periodic. -/
theorem complex_period2 (c : Class) (hc : c.isComplex = true) (d : ℕ) :
    column (d + 2) c = column d c :=
  classify_periodic2_complex c hc d

/-- **Complex series: minimal period 2.**  A single step is not a period of the complex
series: `classify A 1 ≠ classify A 0`, so `2` is the *exact* complex period. -/
theorem complex_minimal_period2 :
    column 1 Class.A ≠ column 0 Class.A := by
  decide

/-! ## 5. Summary

| Object       | Operation                | Invariant / law                         |
|--------------|--------------------------|-----------------------------------------|
| `Engine`     | `step` ("cart")          | `Conserves` ⇒ `run_conserves`           |
| `dimEngine`  | `d ↦ d + 1`              | `dim_census_conserved` (census fixed)   |
| `column`     | engine stream `fun n =>` | `column_period8` (real, exact 8)        |
| `column`     | engine stream `fun n =>` | `complex_period2` (complex, exact 2)    |

The static census invariant of `Patterns.lean` is thus realised as a conservation law of
an explicit dimensional engine, whose generated stream is the Bott clock. -/

end CensusEngine
end AZ
