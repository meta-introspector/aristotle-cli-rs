/-
# CliffordProjection — the content-addressed projection  Cl(0,15) ↠ Cl(0,2)

This is the Lean backing for the Graphviz picture in `graphs/cl15_to_cl2_projection.dot`
(generated by `scripts/clifford_projection_dot.py`).

Using the content-addressed model of `CliffordDAG` — where every blade (monomial)
of `Cl(0,n)` is named by a `BitVec n` recording which generators occur — the natural
projection that *forgets the generators e₃ … e₁₅* and keeps only `{e₁, e₂}` is the
bit-mask map on content IDs

  `projCID : CliffordCID 15 → CliffordCID 2`,   `c ↦ c.index.setWidth 2`.

We prove the three structural facts drawn in the graph:

* `projCID_mul`        — it is a homomorphism for the XOR / symmetric-difference
                         multiplication of content IDs (`mulCID`);
* `projCID_surjective` — it is onto, so `Cl(0,2)` really is a quotient (4 blades);
* `projCID_fiber_card` — every fiber has exactly `2 ^ 13 = 8192` blades,
                         so the `2¹⁵ = 32768` source blades split as `4 × 8192`.
-/

import Mathlib
import RequestProject.Math.Clifford.CliffordDAG

namespace MonsterSlice.CliffordProjection

/-- The projection on content IDs: keep only the two low bits, i.e. the
occurrence of the generators `e₁, e₂`, dropping `e₃ … e₁₅`. -/
def projCID (c : CliffordCID 15) : CliffordCID 2 := ⟨c.index.setWidth 2⟩

/-- `projCID` is a homomorphism for the symmetric-difference multiplication of
content IDs: projecting a product equals the product of the projections. -/
@[simp] theorem projCID_mul (a b : CliffordCID 15) :
    projCID (mulCID a b) = mulCID (projCID a) (projCID b) := by
  simp [projCID, mulCID, BitVec.setWidth_xor]

/-- `projCID` is surjective: every blade of `Cl(0,2)` is hit, so `Cl(0,2)` (its
4 blades) is a genuine quotient of `Cl(0,15)`. -/
theorem projCID_surjective : Function.Surjective projCID := by
  intro t
  refine ⟨⟨t.index.setWidth 15⟩, ?_⟩
  cases t with
  | mk i => simp [projCID, BitVec.setWidth_setWidth_of_le]

/-
Each fiber of the projection has exactly `2 ^ 13 = 8192` blades.
Together with `projCID_surjective` this exhibits the `2¹⁵ = 32768` blades of
`Cl(0,15)` as `4` fibers of size `2¹³`.
-/
theorem projCID_fiber_card (t : CliffordCID 2) :
    (Finset.univ.filter (fun c : CliffordCID 15 => projCID c = t)).card = 2 ^ 13 := by
  native_decide +revert

end MonsterSlice.CliffordProjection