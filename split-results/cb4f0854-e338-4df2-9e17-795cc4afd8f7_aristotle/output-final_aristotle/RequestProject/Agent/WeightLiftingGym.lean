/-
# WeightLiftingGym — Gino, Arni and Jocko as skill generators of a group action

This module instantiates the abstract skill calculus of
`RequestProject.Agent.SkillSystem` at the *weight-lifting gym* and introduces
three trainers as concrete skill generators.

## The gym

The gym state `GymState` carries two integer coordinates:

* `weight` — the (signed) moonshine **weight sector** index of the task, made an
  integer torsor so that weight translations are invertible;
* `form` — the **Clifford form quality** the metric engines read off.

Skills are endomorphisms of `GymState` (the skill monoid `Skill GymState`).

## The three trainers

* **Arni — the weight-stacking titan.**  `arniEquiv k` translates the weight
  sector by `k` and leaves the form untouched (`arni_preserves_form`).  The
  family is a group homomorphism `arniHom : Multiplicative ℤ →* Equiv.Perm`
  (`arniEquiv_zero`, `arniEquiv_add`), i.e. the **weight-translation action**.

* **Gino — the strict form enforcer.**  `ginoEquiv` is the form sign-flip
  involution (`gino_involutive`); it fixes the weight grading
  (`gino_preserves_weight`) and preserves the squared form magnitude — the metric
  invariant (`gino_preserves_formSq`).

* **Jocko — the discipline operator.**  `jocko` is the idempotent normalization
  that zeroes the form (`jocko_idempotent`), preserving the grading
  (`jocko_preserves_weight`).  Being a non-identity idempotent it is **not** a
  unit of the skill monoid (`jocko_not_unit`) — only Gino and Arni are invertible
  trainers, so only they generate the group action.

## The trainer group action

`TrainerGroup` is the subgroup of `Equiv.Perm GymState` generated by Gino and
Arni's unit increment.  It contains every Arni translation (`arni_mem`) and Gino
(`gino_mem`), and acts on the gym (`MulAction TrainerGroup GymState`,
`trainer_smul_assoc`).
-/

import Mathlib
import RequestProject.Agent.SkillSystem

namespace RequestProject.Agent.Gym

open RequestProject.Agent.SkillSystem

/-! ## §1. The weight-lifting gym -/

/-- The semantic state of the weight-lifting gym: a (signed) moonshine weight
    sector index together with a Clifford form quality. -/
structure GymState where
  /-- The signed moonshine weight sector index. -/
  weight : ℤ
  /-- The Clifford form quality (metric data). -/
  form : ℤ
deriving DecidableEq, Repr

/-! ## §2. Arni — the weight-stacking titan (weight translation) -/

/-- Arni's underlying state map: translate the weight by `k`. -/
def arniMap (k : ℤ) : GymState → GymState := fun s => ⟨s.weight + k, s.form⟩

/-- Arni's weight translation as a permutation of the gym. -/
def arniEquiv (k : ℤ) : Equiv.Perm GymState where
  toFun := arniMap k
  invFun := arniMap (-k)
  left_inv := by intro s; simp [arniMap]
  right_inv := by intro s; simp [arniMap]

@[simp] theorem arniEquiv_apply (k : ℤ) (s : GymState) :
    arniEquiv k s = ⟨s.weight + k, s.form⟩ := rfl

/-- The trivial increment is the identity skill. -/
theorem arniEquiv_zero : arniEquiv 0 = 1 := by ext s; simp

/-- Weight increments add: Arni's stacking is additive. -/
theorem arniEquiv_add (k j : ℤ) : arniEquiv (k + j) = arniEquiv k * arniEquiv j := by
  ext s
  simp [Equiv.Perm.mul_apply]
  ring

/-- Arni as a group homomorphism from the additive group of weight increments. -/
def arniHom : Multiplicative ℤ →* Equiv.Perm GymState where
  toFun k := arniEquiv (Multiplicative.toAdd k)
  map_one' := arniEquiv_zero
  map_mul' k j := arniEquiv_add (Multiplicative.toAdd k) (Multiplicative.toAdd j)

@[simp] theorem arniHom_ofAdd (k : ℤ) :
    arniHom (Multiplicative.ofAdd k) = arniEquiv k := rfl

/-- **Arni leaves the metric (form) untouched** — a pure weight skill. -/
theorem arni_preserves_form (k : ℤ) (s : GymState) : (arniEquiv k s).form = s.form := rfl

/-! ## §3. Gino — the strict form enforcer (form involution) -/

/-- Gino's underlying state map: flip the sign of the form (strict
    normalization of the generator family). -/
def ginoMap : GymState → GymState := fun s => ⟨s.weight, -s.form⟩

/-- Gino's form enforcement as a permutation of the gym (an involution). -/
def ginoEquiv : Equiv.Perm GymState where
  toFun := ginoMap
  invFun := ginoMap
  left_inv := by intro s; simp [ginoMap]
  right_inv := by intro s; simp [ginoMap]

@[simp] theorem ginoEquiv_apply (s : GymState) :
    ginoEquiv s = ⟨s.weight, -s.form⟩ := rfl

/-- **Gino is an involution**: applying the form enforcer twice is the identity. -/
theorem gino_involutive : ginoEquiv * ginoEquiv = 1 := by
  ext s; simp [Equiv.Perm.mul_apply]

/-- **Gino preserves the weight grading.** -/
theorem gino_preserves_weight (s : GymState) : (ginoEquiv s).weight = s.weight := rfl

/-- **Gino preserves the metric invariant** (the squared form magnitude). -/
theorem gino_preserves_formSq (s : GymState) : (ginoEquiv s).form ^ 2 = s.form ^ 2 := by
  simp

/-! ## §4. Jocko — the discipline operator (idempotent normalization) -/

/-- Jocko's discipline normalization: project onto the clean subspace by zeroing
    the form.  This is a skill but not an invertible one. -/
def jocko : Skill GymState := fun s => ⟨s.weight, 0⟩

@[simp] theorem jocko_apply (s : GymState) : jocko s = ⟨s.weight, 0⟩ := rfl

/-- **Jocko is idempotent**: discipline normalization is a projection. -/
theorem jocko_idempotent : IsIdempotentElem jocko := by
  unfold IsIdempotentElem; funext s; rfl

/-- **Jocko preserves the grading.** -/
theorem jocko_preserves_weight (s : GymState) : (jocko s).weight = s.weight := rfl

theorem jocko_not_one : jocko ≠ 1 := by
  intro h
  have h2 : (⟨0, 0⟩ : GymState) = ⟨0, 1⟩ := congrFun h ⟨0, 1⟩
  exact absurd h2 (by decide)

/-- A general fact: an idempotent that is a unit must be the identity. -/
theorem idempotent_isUnit_eq_one {M : Type*} [Monoid M] {e : M}
    (hi : IsIdempotentElem e) (hu : IsUnit e) : e = 1 := by
  obtain ⟨u, rfl⟩ := hu
  have key : ((u⁻¹ : Mˣ) : M) * (↑u * ↑u) = ((u⁻¹ : Mˣ) : M) * ↑u := by rw [hi]
  rw [← mul_assoc, Units.inv_mul, one_mul] at key
  exact key

/-- **Jocko is not an invertible skill.**  As a non-identity idempotent, the
    discipline operator is not a unit of the skill monoid; hence it generates no
    part of the trainer group — only Gino and Arni do. -/
theorem jocko_not_unit : ¬ IsUnit jocko := fun hu =>
  jocko_not_one (idempotent_isUnit_eq_one jocko_idempotent hu)

/-! ## §5. The trainer-generated group action on the gym -/

/-- The **trainer group**: the subgroup of gym permutations generated by Gino and
    Arni's unit weight increment. -/
def TrainerGroup : Subgroup (Equiv.Perm GymState) :=
  Subgroup.closure {ginoEquiv, arniEquiv 1}

/-- Gino is a trainer. -/
theorem gino_mem : ginoEquiv ∈ TrainerGroup :=
  Subgroup.subset_closure (by left; rfl)

/-- Arni's unit increment is a trainer. -/
theorem arni_one_mem : arniEquiv 1 ∈ TrainerGroup :=
  Subgroup.subset_closure (by right; rfl)

/-- Every Arni weight increment is a power of the unit increment. -/
theorem arniEquiv_zpow (k : ℤ) : arniEquiv k = arniEquiv 1 ^ k := by
  have h1 : (Multiplicative.ofAdd (1 : ℤ)) ^ k = Multiplicative.ofAdd k := by
    rw [← ofAdd_zsmul]; simp
  calc arniEquiv k = arniHom (Multiplicative.ofAdd k) := rfl
    _ = arniHom ((Multiplicative.ofAdd (1 : ℤ)) ^ k) := by rw [h1]
    _ = (arniHom (Multiplicative.ofAdd 1)) ^ k := by rw [map_zpow]
    _ = arniEquiv 1 ^ k := rfl

/-- **Every Arni weight translation is a trainer.** -/
theorem arni_mem (k : ℤ) : arniEquiv k ∈ TrainerGroup := by
  rw [arniEquiv_zpow]; exact zpow_mem arni_one_mem k

/-- The trainer group acts on the gym. -/
example : MulAction TrainerGroup GymState := inferInstance

/-- **The trainer group action is associative**: composing trainers before
    acting equals acting in sequence. -/
theorem trainer_smul_assoc (g h : TrainerGroup) (s : GymState) :
    g • h • s = (g * h) • s := smul_smul g h s

/-- The identity trainer acts trivially. -/
theorem trainer_smul_one (s : GymState) : (1 : TrainerGroup) • s = s := one_smul _ s

end RequestProject.Agent.Gym
