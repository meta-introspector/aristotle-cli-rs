/-- The list of degrees (dimensions) of the `194` irreducibles. -/
def irrepDegrees : List Nat := irrepRows.map (fun r => degOf r.exps)

/-- There are exactly `194` irreducible representations. -/
theorem num_irreps : irrepRows.length = 194 := by native_decide

/-- This matches the number of conjugacy classes / irreducibles recorded elsewhere. -/
theorem num_irreps_eq : irrepRows.length = 194 := num_irreps

/-- The indices are pairwise distinct. -/
theorem indices_nodup : (irrepRows.map (fun r => r.idx)).Nodup := by native_decide

/-- The indices are exactly `{0, 1, …, 193}`. -/
theorem indices_eq_range :
    (irrepRows.map (fun r => r.idx)).toFinset = Finset.range 194 := by native_decide

/-- Every recorded exponent sum equals the actual sum of that row's exponents. -/
theorem rowSum_correct : ∀ r ∈ irrepRows, r.exps.sum = r.rowSum := by native_decide

/-- Every row lists exactly `15` exponents (one per Monster prime). -/
theorem exps_length : ∀ r ∈ irrepRows, r.exps.length = 15 := by native_decide

/-- **Each irreducible degree divides the Monster order.** This is the classical theorem
that the degree of an irreducible representation divides the order of the group; here it is
verified directly for all `194` degrees. -/
theorem degrees_divide_order : ∀ r ∈ irrepRows, degOf r.exps ∣ monsterOrder := by
  native_decide

/-- The trivial representation (`idx = 0`) has degree `1`. -/
theorem degree_trivial :
    ∀ r ∈ irrepRows, r.idx = 0 → degOf r.exps = 1 := by native_decide

/-- The smallest nontrivial irreducible (`idx = 1`) has degree `196883 = 47·59·71`. -/
theorem smallest_nontrivial_degree :
    ∀ r ∈ irrepRows, r.idx = 1 → degOf r.exps = 196883 := by native_decide

/-- The largest irreducible degree is `258823477531055064045234375` (attained at
`idx = 193`). -/
theorem largest_degree :
    irrepDegrees.max? = some 258823477531055064045234375 := by native_decide

/-- **Sum of squares of the degrees equals the group order:** `∑ dᵢ² = |𝕄|`.
This is the fundamental identity of (complex) character theory, and certifies that the
table lists exactly the complete set of irreducible degrees. -/
theorem sum_of_squares_eq_order :
    (irrepRows.map (fun r => (degOf r.exps) ^ 2)).sum = monsterOrder := by native_decide

end MonsterIrreps
