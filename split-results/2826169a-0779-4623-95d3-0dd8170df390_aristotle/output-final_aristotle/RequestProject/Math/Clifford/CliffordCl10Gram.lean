set_option maxHeartbeats 1600000

theorem gramBlock10_spec {start count : Nat} (h : gramBlock10 start count = true)
    (i j : Nat) (hi : start ≤ i) (hi' : i < start + count) (hj : j < 1024) :
    traceProd64 (monomialN10 i) (monomialN10 j) = if i == j then 64 else 0 := by
  have hdi : i - start < count := by omega
  have : start + (i - start) = i := by omega
  unfold gramBlock10 at h
  have h1 : (List.range count).all (fun di =>
    (List.range 1024).all fun j =>
      let mi := monomialN10 (start + di)
      let mj := monomialN10 j
      let tr := traceProd64 mi mj
      if start + di == j then tr == 64 else tr == 0) = true := h
  rw [List.all_eq_true] at h1
  have h2 := h1 (i - start) (List.mem_range.mpr hdi)
  rw [List.all_eq_true] at h2
  have h3 := h2 j (List.mem_range.mpr hj)
  rw [this] at h3
  split_ifs at h3 ⊢ with heq1 heq2 <;> simp_all [BEq.beq, beq_iff_eq]

/-- The 1024 CL10 monomial matrices satisfy trace(Mᵢᵀ·Mⱼ) = 64·δᵢⱼ. -/
theorem gram10_orthogonality (i j : Fin 1024) :
    traceProd64 (monomialN10 i.val) (monomialN10 j.val) =
      if i.val == j.val then 64 else 0 := by
  obtain ⟨start, count, h_block⟩ : ∃ start count : Nat,
      start ≤ i.val ∧ i.val < start + count ∧ count = 2 ∧
      gramBlock10 start count = true := by
    grind +suggestions
  exact gramBlock10_spec h_block.2.2.2 _ _ h_block.1 h_block.2.1
    (by linarith [Fin.is_lt j])
