/-
# The 2–3 Sieve: Higher Layers of the Complexity Tower
Building on `SieveCore`, we formalize the higher layers of the tower of complexity
arising from the sieve generated by the primes 2 and 3.
## Layer 5: Closure Properties of the 2×3 Core
The 3-smooth numbers form a multiplicative submonoid of ℕ — closed under
multiplication, with 1 as identity. This captures the algebraic flatness of S₀.
## Layer 6: Curvature — Pairwise Prime Coupling
Numbers with multiple large prime factors (p, q ≥ 5) are the first place where
the sieve boundary develops curvature. They cannot be reduced to S₀ or to a single
obstruction.
## Layer 7: The Shadow Semigroup
The set of positive integers coprime to 6 forms a multiplicative submonoid —
the "shadow world" where entropy first appears.
## Layer 8: Valuation Independence
Each prime p ≥ 5 introduces a genuinely independent direction — its valuation is
orthogonal to all other prime valuations, including v₂ and v₃.
## Layer 9: Dimensional Explosion and the Full Orthant
The valuation map n ↦ (v₂(n), v₃(n), v₅(n), v₇(n), …) embeds ℕ⁺ into an
infinite-dimensional orthant, with S₀ sitting in the 2-dimensional face.
-/
import Mathlib
import RequestProject.SieveCore
open Nat Finset
/-! ## Layer 5: The 2×3 Core Is a Multiplicative Submonoid -/
/-- 1 is 3-smooth (the identity element). -/
theorem isSmooth23_one : IsSmooth23 1 := by
  exact ⟨Nat.one_pos, fun p hp hd => absurd (Nat.le_of_dvd Nat.one_pos hd) (not_le.mpr (Nat.Prime.one_lt hp))⟩
/-- The product of two 3-smooth numbers is 3-smooth. -/
theorem isSmooth23_mul {m n : ℕ} (hm : IsSmooth23 m) (hn : IsSmooth23 n) :
    IsSmooth23 (m * n) := by
  constructor
  · exact Nat.mul_pos hm.1 hn.1
  · intro p hp hd
    rcases hp.dvd_mul.mp hd with h | h
    · exact hm.2 p hp h
    · exact hn.2 p hp h
/-- The 3-smooth numbers form a multiplicative submonoid of ℕ. -/
theorem smooth23_mul (a₁ b₁ a₂ b₂ : ℕ) :
    smooth23 a₁ b₁ * smooth23 a₂ b₂ = smooth23 (a₁ + a₂) (b₁ + b₂) := by
  simp [smooth23, pow_add, mul_assoc, mul_left_comm]
/-
GCD of 3-smooth numbers is 3-smooth.
-/
theorem isSmooth23_gcd {m n : ℕ} (hm : IsSmooth23 m) (_hn : IsSmooth23 n) :
    IsSmooth23 (m.gcd n) := by
  exact ⟨ Nat.gcd_pos_of_pos_left _ hm.1, fun p pp dp => hm.2 p pp ( dvd_trans dp ( Nat.gcd_dvd_left _ _ ) ) ⟩
/-
LCM of 3-smooth numbers is 3-smooth.
-/
theorem isSmooth23_lcm {m n : ℕ} (hm : IsSmooth23 m) (hn : IsSmooth23 n) :
    IsSmooth23 (m.lcm n) := by
  refine' ⟨ Nat.lcm_pos hm.1 hn.1, fun p pp d => _ ⟩;
  have := pp.dvd_mul.mp ( d.trans ( Nat.lcm_dvd_mul m n ) );
  cases this <;> [ exact hm.2 p pp ‹_›; exact hn.2 p pp ‹_› ]
/-! ## Layer 6: Curvature — Composites with Multiple Large Primes -/
/-- A natural number has **curvature** if it has at least two distinct prime
    factors ≥ 5. These are the first numbers where the sieve boundary bends. -/
def HasCurvature (n : ℕ) : Prop :=
  ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ 5 ≤ p ∧ 5 ≤ q ∧ p ≠ q ∧ p ∣ n ∧ q ∣ n
/-- The product of two distinct primes ≥ 5 has curvature. -/
theorem hasCurvature_of_two_large_primes {p q : ℕ}
    (hp : p.Prime) (hq : q.Prime) (hp5 : 5 ≤ p) (hq5 : 5 ≤ q) (hpq : p ≠ q) :
    HasCurvature (p * q) :=
  ⟨p, q, hp, hq, hp5, hq5, hpq, dvd_mul_right p q, dvd_mul_left q p⟩
/-- A number with curvature is not 3-smooth. -/
theorem not_smooth23_of_curvature {n : ℕ} (hc : HasCurvature n) : ¬IsSmooth23 n := by
  obtain ⟨p, _, hp, _, hp5, _, _, hpd, _⟩ := hc
  intro ⟨_, hn⟩
  have := hn p hp hpd
  rcases this with rfl | rfl <;> omega
/-
A number with curvature cannot be explained by a single shadow direction:
    it has at least two distinct prime factors ≥ 5 with positive valuation.
-/
theorem curvature_needs_two_shadows {n : ℕ} (hn : 0 < n) (hc : HasCurvature n) :
    ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ 5 ≤ p ∧ 5 ≤ q ∧ p ≠ q ∧
    0 < n.factorization p ∧ 0 < n.factorization q := by
  obtain ⟨ p, q, hp, hq, hp5, hq5, hpq, hpn, hqn ⟩ := hc;
  exact ⟨ p, q, hp, hq, hp5, hq5, hpq, Nat.pos_of_ne_zero ( Finsupp.mem_support_iff.mp ( by aesop ) ), Nat.pos_of_ne_zero ( Finsupp.mem_support_iff.mp ( by aesop ) ) ⟩
/-! ## Layer 7: The Shadow Semigroup Is Closed -/
/-- The shadow set (positive integers coprime to 6) is closed under multiplication. -/
theorem shadow_mul_closed {m n : ℕ} (hm : m.Coprime 6) (hn : n.Coprime 6) :
    (m * n).Coprime 6 :=
  Nat.Coprime.mul_left hm hn
/-- 1 is in the shadow set. -/
theorem shadow_one : (1 : ℕ).Coprime 6 := by decide
/-
Every prime ≥ 5 is in the shadow set.
-/
theorem shadow_of_large_prime {p : ℕ} (hp : p.Prime) (hp5 : 5 ≤ p) :
    p.Coprime 6 := by
  exact hp.coprime_iff_not_dvd.mpr fun h => by have := Nat.le_of_dvd ( by decide ) h; interval_cases p <;> trivial;
/-! ## Layer 8: Valuation Independence -/
/-
For distinct primes p ≠ q, the prime p has v_p(p) > 0 and v_q(p) = 0.
    This shows the valuations are independent directions.
-/
theorem valuation_independence {p q : ℕ} (hp : p.Prime) (_hq : q.Prime) (hpq : p ≠ q) :
    p.factorization p > 0 ∧ p.factorization q = 0 := by
  simp_all +decide
/-
The 2×3 core is exactly the kernel of all shadow valuations:
    n is 3-smooth iff v_p(n) = 0 for all primes p ≥ 5.
-/
theorem smooth23_iff_all_large_valuations_zero {n : ℕ} (hn : 0 < n) :
    IsSmooth23 n ↔ ∀ p : ℕ, p.Prime → 5 ≤ p → n.factorization p = 0 := by
  constructor;
  · exact?;
  · intro h; refine' ⟨ hn, _ ⟩ ; intro p pp dp; specialize h p pp; contrapose! h; simp_all +decide [ Nat.factorization_eq_zero_iff ] ;
    exact ⟨ le_of_not_gt fun h' => by interval_cases p <;> trivial, hn.ne' ⟩
/-! ## Layer 9: Dimensional Explosion — Factorization as Embedding -/
/-
The factorization map is injective on positive naturals: distinct positive
    naturals have distinct valuation vectors. This is the foundation of the
    infinite-dimensional orthant embedding.
-/
theorem factorization_injective {m n : ℕ} (hm : 0 < m) (hn : 0 < n)
    (h : m.factorization = n.factorization) : m = n := by
  rw [ ← Nat.factorization_prod_pow_eq_self hm.ne', ← Nat.factorization_prod_pow_eq_self hn.ne', h ]
/-
The 2×3 plane sits inside the full orthant as the 2-dimensional face
    where all coordinates beyond v₂ and v₃ are zero.
-/
theorem smooth23_is_face {n : ℕ} (hn : 0 < n) :
    IsSmooth23 n ↔
    (∀ p : ℕ, p.Prime → p ≠ 2 → p ≠ 3 → n.factorization p = 0) := by
  constructor;
  · intro h p hp hp2 hp3; rw [ Nat.factorization_eq_zero_iff ] ; contrapose! hp3; contrapose! hp2; simp_all +decide [ IsSmooth23 ] ;
    cases h p hp3.1 hp3.2.1 <;> tauto;
  · grind +suggestions
/-
Every positive integer decomposes uniquely as a product of a 3-smooth
    part and a shadow part (coprime to 6). This is the canonical projection
    onto the 2×3 plane and its orthogonal complement.
-/
theorem smooth_shadow_decomposition (n : ℕ) (hn : 0 < n) :
    ∃ s r : ℕ, IsSmooth23 s ∧ r.Coprime 6 ∧ n = s * r ∧
    ∀ s' r' : ℕ, IsSmooth23 s' → r'.Coprime 6 → n = s' * r' → s' = s ∧ r' = r := by
  -- Define s = 2^(v₂(n)) * 3^(v₃(n)) and r = n / s.
  set s := 2 ^ (n.factorization 2) * 3 ^ (n.factorization 3)
  set r := n / s;
  refine' ⟨ s, r, _, _, Eq.symm ( Nat.mul_div_cancel' _ ), _ ⟩;
  · exact smooth23_isSmooth _ _;
  · -- By definition of $r$, we know that $r$ is coprime to 6.
    have hr_coprime : Nat.Coprime r 2 ∧ Nat.Coprime r 3 := by
      constructor <;> refine' Nat.Coprime.symm ( Nat.Prime.coprime_iff_not_dvd ( by decide ) |>.2 _ );
      · rw [ Nat.Prime.dvd_iff_one_le_factorization ] <;> norm_num;
        · rw [ Nat.factorization_div ] <;> norm_num;
          · rw [ Nat.factorization_mul ] <;> norm_num;
          · exact Nat.Coprime.mul_dvd_of_dvd_of_dvd ( by { exact Nat.Coprime.pow _ _ <| by decide } ) ( Nat.ordProj_dvd _ _ ) ( Nat.ordProj_dvd _ _ );
        · exact Nat.ne_of_gt ( Nat.div_pos ( Nat.le_of_dvd hn ( Nat.Coprime.mul_dvd_of_dvd_of_dvd ( by { exact Nat.Coprime.pow _ _ <| by decide } ) ( Nat.ordProj_dvd _ _ ) ( Nat.ordProj_dvd _ _ ) ) ) ( Nat.mul_pos ( pow_pos ( by decide ) _ ) ( pow_pos ( by decide ) _ ) ) );
      · rw [ Nat.Prime.dvd_iff_one_le_factorization ] <;> norm_num;
        · rw [ Nat.factorization_div ] <;> norm_num;
          · rw [ Nat.factorization_mul ] <;> norm_num;
          · exact Nat.Coprime.mul_dvd_of_dvd_of_dvd ( by { exact Nat.Coprime.pow _ _ <| by decide } ) ( Nat.ordProj_dvd _ _ ) ( Nat.ordProj_dvd _ _ );
        · exact Nat.ne_of_gt ( Nat.div_pos ( Nat.le_of_dvd hn ( Nat.Coprime.mul_dvd_of_dvd_of_dvd ( by { exact Nat.Coprime.pow _ _ <| by decide } ) ( Nat.ordProj_dvd _ _ ) ( Nat.ordProj_dvd _ _ ) ) ) ( Nat.mul_pos ( pow_pos ( by decide ) _ ) ( pow_pos ( by decide ) _ ) ) );
    exact Nat.Coprime.mul_right hr_coprime.1 hr_coprime.2;
  · exact Nat.Coprime.mul_dvd_of_dvd_of_dvd ( by { exact Nat.Coprime.pow _ _ <| by decide } ) ( Nat.ordProj_dvd _ _ ) ( Nat.ordProj_dvd _ _ );
  · intro s' r' hs' hr' hn'
    have hs'_eq_s : s' = s := by
      have hs'_eq : s'.factorization 2 = n.factorization 2 ∧ s'.factorization 3 = n.factorization 3 := by
        rw [ hn', Nat.factorization_mul ] <;> norm_num;
        · exact ⟨ Nat.factorization_eq_zero_of_not_dvd fun h => by have := Nat.dvd_gcd h ( by decide : 2 ∣ 6 ) ; simp_all +singlePass, Nat.factorization_eq_zero_of_not_dvd fun h => by have := Nat.dvd_gcd h ( by decide : 3 ∣ 6 ) ; simp_all +singlePass ⟩;
        · exact hs'.1.ne';
        · rintro rfl; simp_all +singlePass;
      apply smooth23_determined_by_valuations hs';
      · exact smooth23_isSmooth _ _;
      · rw [ hs'_eq.1, Nat.factorization_mul ] <;> norm_num;
      · rw [ hs'_eq.2, Nat.factorization_mul ] <;> norm_num
    have hr'_eq_r : r' = r := by
      exact Eq.symm ( Nat.div_eq_of_eq_mul_left ( Nat.mul_pos ( pow_pos ( by decide ) _ ) ( pow_pos ( by decide ) _ ) ) ( by subst hs'_eq_s; linarith ) )
    exact ⟨hs'_eq_s, hr'_eq_r⟩
