/-
# The 2–3 Sieve: Tower of Complexity
A formalization of the "tower of complexity" arising from the sieve generated
by the primes 2 and 3.
## Layer 0: The Base — 3-Smooth Numbers
The set S₀ = {2^a · 3^b : a, b ≥ 0} of **3-smooth numbers** (positive integers
whose only prime factors are 2 and 3) forms the "flat" Cartesian core of the
arithmetic universe.
## Layer 1: No Internal Resonance
The map (a, b) ↦ 2^a · 3^b is injective — the 2–3 lattice is a faithful
embedding of ℤ≥0² into ℕ.
## Layer 2: The Sieve Boundary
Every positive integer outside S₀ has a prime factor ≥ 5. These primes are
the "shadow directions" — axes orthogonal to the 2×3 plane.
## Layer 3: Dimensional Explosion
Each prime p ≥ 5 introduces a new independent valuation v_p, lifting the
2-dimensional lattice into an infinite-dimensional orthant.
-/
import Mathlib
open Nat Finset
/-! ## Definition of 3-smooth numbers -/
/-- A positive natural number is **3-smooth** if all its prime factors are ≤ 3.
    Equivalently, it belongs to the multiplicative semigroup ⟨2, 3⟩. -/
def IsSmooth23 (n : ℕ) : Prop :=
  0 < n ∧ ∀ p : ℕ, p.Prime → p ∣ n → p = 2 ∨ p = 3
/-- The canonical embedding of the 2×3 lattice into ℕ. -/
def smooth23 (a b : ℕ) : ℕ := 2 ^ a * 3 ^ b
/-! ## Layer 0: Basic properties of the 2×3 lattice -/
theorem smooth23_pos (a b : ℕ) : 0 < smooth23 a b := by
  unfold smooth23
  positivity
theorem smooth23_isSmooth (a b : ℕ) : IsSmooth23 (smooth23 a b) := by
  constructor <;> norm_num [ smooth23 ];
  intro p pp dp; have := pp.dvd_mul.mp dp; simp_all +decide [ Nat.Prime.dvd_iff_one_le_factorization ] ;
  rw [ Finsupp.single_apply, Finsupp.single_apply ] at this ; aesop
/-! ## Layer 1: No Internal Resonance
The 2×3 lattice is a free abelian monoid — the map (a, b) ↦ 2^a · 3^b is
injective. This is the "flat Earth" property: no nontrivial relations. -/
theorem smooth23_injective :
    Function.Injective (fun p : ℕ × ℕ => smooth23 p.1 p.2) := by
  intro p q; simp +decide [ smooth23 ] ;
  intro h; have := congr_arg ( fun x => x.factorization 2 ) h; have := congr_arg ( fun x => x.factorization 3 ) h; norm_num at * ; aesop;
/-! ## Layer 2: The Sieve Boundary
The complement of S₀ is precisely the set of positive integers that have
at least one prime factor ≥ 5. These primes are the "shadow directions." -/
/-
A positive integer is outside S₀ iff it has a prime factor ≥ 5.
-/
theorem not_smooth23_iff_exists_large_prime {n : ℕ} (hn : 0 < n) :
    ¬IsSmooth23 n ↔ ∃ p : ℕ, p.Prime ∧ p ∣ n ∧ 5 ≤ p := by
  constructor;
  · intro h_not_smooth
    obtain ⟨p, hp_prime, hp_div⟩ : ∃ p : ℕ, Nat.Prime p ∧ p ∣ n ∧ p ≠ 2 ∧ p ≠ 3 := by
      unfold IsSmooth23 at h_not_smooth; aesop;
    exact ⟨ p, hp_prime, hp_div.1, le_of_not_gt fun h => by interval_cases p <;> simp_all +decide ⟩;
  · rintro ⟨ p, hp₁, hp₂, hp₃ ⟩ ⟨ hn₁, hn₂ ⟩ ; have := hn₂ p hp₁ hp₂ ; rcases this with ( rfl | rfl ) <;> linarith;
/-! ## Layer 1 continued: Characterization via valuations
Every 3-smooth number is of the form 2^a · 3^b. -/
/-
Every 3-smooth number can be written as 2^a · 3^b. This is the converse
    of `smooth23_isSmooth` and completes the lattice characterization.
-/
theorem isSmooth23_iff_exists (n : ℕ) :
    IsSmooth23 n ↔ ∃ a b : ℕ, n = smooth23 a b := by
  constructor <;> intro H;
  · unfold IsSmooth23 at H;
    rw [ ← Nat.factorization_prod_pow_eq_self H.1.ne' ];
    rw [ Finsupp.prod_of_support_subset ];
    case s => exact { 2, 3 };
    · exact ⟨ n.factorization 2, n.factorization 3, by simp +decide [ smooth23 ] ⟩;
    · intro p hp; specialize H; aesop;
    · norm_num;
  · exact H.elim fun a ha => ha.elim fun b hb => hb ▸ smooth23_isSmooth a b
/-! ## Layer 3: Shadow Valuations
Each prime p ≥ 5 defines a valuation v_p that is identically zero on S₀
but nonzero on the sieve boundary. These are the "shadow axes." -/
/-
The p-adic valuation of a 3-smooth number is zero for any prime p ≥ 5.
-/
theorem smooth23_valuation_zero {p : ℕ} (hp : p.Prime) (hp5 : 5 ≤ p)
    {n : ℕ} (hn : IsSmooth23 n) : n.factorization p = 0 := by
  rw [ Nat.factorization_eq_zero_iff ];
  exact Or.inr <| Or.inl <| fun h => by have := hn.2 p hp h; rcases this with ( rfl | rfl ) <;> contradiction;
/-
The 2-adic and 3-adic valuations completely determine a 3-smooth number.
-/
theorem smooth23_determined_by_valuations {m n : ℕ}
    (hm : IsSmooth23 m) (hn : IsSmooth23 n)
    (h2 : m.factorization 2 = n.factorization 2)
    (h3 : m.factorization 3 = n.factorization 3) : m = n := by
  rw [ isSmooth23_iff_exists ] at hm hn;
  obtain ⟨ a, b, rfl ⟩ := hm; obtain ⟨ c, d, rfl ⟩ := hn; simp_all +decide [ smooth23 ] ;
/-! ## Layer 4: The Shadow Semigroup
The set of positive integers with v₂ = v₃ = 0 — the "shadow" of the 2×3 plane —
is the semigroup generated by primes ≥ 5. This is where entropy first appears. -/
/-
A positive integer has v₂ = v₃ = 0 iff it is coprime to 6.
-/
theorem shadow_iff_coprime_six {n : ℕ} (hn : 0 < n) :
    (n.factorization 2 = 0 ∧ n.factorization 3 = 0) ↔ n.Coprime 6 := by
  constructor <;> intro h <;> rw [ Nat.factorization_eq_zero_iff ] at *;
  · simp_all +decide [ Nat.factorization_eq_zero_iff ];
    exact Nat.Coprime.mul_right ( Nat.Coprime.symm <| Nat.prime_two.coprime_iff_not_dvd.mpr <| by omega ) ( Nat.Coprime.symm <| Nat.prime_three.coprime_iff_not_dvd.mpr <| by omega );
  · exact ⟨ Or.inr <| Or.inl <| fun h' => by have := Nat.dvd_gcd h' ( by decide : 2 ∣ 6 ) ; simp_all +decide, Nat.factorization_eq_zero_of_not_dvd fun h' => by have := Nat.dvd_gcd h' ( by decide : 3 ∣ 6 ) ; simp_all +decide ⟩
