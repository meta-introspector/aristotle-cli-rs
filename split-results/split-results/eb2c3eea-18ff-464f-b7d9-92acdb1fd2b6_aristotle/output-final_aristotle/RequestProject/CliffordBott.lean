import Mathlib

/-!
# Clifford Algebras: a verified algebraic foundation

This file formalises the *algebraically precise and verifiable* claims contained in the
informal note "A Lean4 Proof Architecture: Clifford Algebras and Bott Periodicity".

The note ranges over a great deal of material (Clifford algebras, spinors, Bott
periodicity, the tenfold way, ...).  Many of the higher-level topological statements
(genuine Bott periodicity of the homotopy groups of `O`/`U`/`Sp`, the periodic table of
topological insulators, triality of `Spin(8)`, ...) are research-level formalisations that
do not yet exist in Mathlib and are out of scope for a faithful short development.

What *is* verifiable, and is proved here against `Mathlib`'s `CliffordAlgebra` library, is
the precise algebraic core the note rests on:

* the **defining relation** `a² = g(a,a)·1`;
* the **1882 multiplication rules** `eᵢeⱼ = -eⱼeᵢ` (for orthogonal generators) and, for a
  negative-definite signature, `eᵢ² = -1`;
* **inversion** of vectors: `a⁻¹ = g(a,a)⁻¹ a` when `g(a,a)` is invertible;
* the existence of **zero divisors** (non-zero non-invertible multivectors);
* the fact that the algebra is **generated by `V`** (not by any proper subspace);
* the historical low-dimensional identifications
  `Cl₀,₁(ℝ) ≅ ℂ` (Argand) and `Cl₀,₂(ℝ) ≅ ℍ` (Hamilton, 1843).
-/

noncomputable section

open CliffordAlgebra QuadraticMap
open scoped Quaternion

namespace CliffordBott

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]

/-! ## 1. The algebraic foundation -/

/-
**Defining relation.** For any vector `a ∈ V`, `a² = g(a,a)·1` inside `Cl(V, g)`.
-/
theorem clifford_defining_relation (Q : QuadraticForm R M) (a : M) :
    ι Q a * ι Q a = algebraMap R (CliffordAlgebra Q) (Q a) := by
  convert CliffordAlgebra.ι_sq_scalar Q a using 1

/-
**Anticommutation of orthogonal generators (1882 rule `eᵢeⱼ = -eⱼeᵢ`).**
If two vectors are orthogonal for the form (their polar form vanishes) then the
corresponding generators anticommute.
-/
theorem clifford_anticommute {Q : QuadraticForm R M} {a b : M}
    (h : QuadraticMap.polar Q a b = 0) :
    ι Q a * ι Q b = -(ι Q b * ι Q a) := by
  grind +suggestions

/-
**A negative-definite generator squares to `-1` (1882 rule `eᵢ² = -1`).**
We realise this in `Cl₀,₁(ℝ)`, whose quadratic form is `Q r = -(r·r)`, so that the
single generator `e = ι 1` satisfies `e² = -1`.
-/
theorem clifford_generator_sq_neg_one :
    (ι CliffordAlgebraComplex.Q 1) * (ι CliffordAlgebraComplex.Q 1)
      = (-1 : CliffordAlgebra CliffordAlgebraComplex.Q) := by
  rw [CliffordAlgebra.ι_sq_scalar]
  simp [CliffordAlgebraComplex.Q_apply]

/-
**Inversion of a vector with invertible square.**
If `g(a,a)` is invertible then `a⁻¹ = g(a,a)⁻¹ a`, i.e. `a · (g(a,a)⁻¹ a) = 1`.
-/
theorem clifford_vector_inverse (Q : QuadraticForm R M) (a : M) [Invertible (Q a)] :
    ι Q a * ι Q (⅟ (Q a) • a) = 1 := by
  convert ( CliffordAlgebra.invertibleιOfInvertible Q a ).mul_invOf_self

/-
A vector whose square is a unit is itself a unit in the Clifford algebra.
-/
theorem clifford_isUnit_of_isUnit {Q : QuadraticForm R M} {a : M} (h : IsUnit (Q a)) :
    IsUnit (ι Q a) := by
  convert CliffordAlgebra.isUnit_ι_of_isUnit Q h

/-
**Existence of zero divisors.** Unlike a division algebra, a Clifford algebra can
contain non-zero elements without a multiplicative inverse.  In the split algebra
`Cl₁,₁(ℝ)` (here `CliffordAlgebraQuaternion.Q 1 1`) the generator `e = ι (1,0)` squares to
`+1`, so `(1 + e)` and `(1 - e)` are non-zero yet multiply to `0`.
-/
theorem clifford_has_zero_divisors :
    ∃ a b : CliffordAlgebra (CliffordAlgebraQuaternion.Q (1 : ℝ) 1),
      a ≠ 0 ∧ b ≠ 0 ∧ a * b = 0 := by
  -- Let $e$ be the generator of the algebra.
  set e : CliffordAlgebra (CliffordAlgebraQuaternion.Q (1 : ℝ) 1) := ι (CliffordAlgebraQuaternion.Q (1 : ℝ) 1) (1, 0);
  refine' ⟨ 1 + e, 1 - e, _, _, _ ⟩ <;> norm_num [ e, mul_add, add_mul, sub_eq_zero ];
  · intro h;
    apply_fun CliffordAlgebraQuaternion.toQuaternion at h ; norm_num [ CliffordAlgebraQuaternion.toQuaternion_ι ] at h;
    injection h with h ; norm_num at h;
  · intro h;
    apply_fun CliffordAlgebraQuaternion.toQuaternion at h ; norm_num [ CliffordAlgebraQuaternion.toQuaternion_ι ] at h;
    injection h;
    norm_num at *;
  · simp +decide [ mul_sub, sub_add ]

/-
**The algebra is generated by `V`.** `Cl(V, g)` is generated (as an `R`-algebra) by the
image of `V` under `ι`; it is not generated by any proper subalgebra excluding the vectors.
-/
theorem clifford_generated_by_vectors (Q : QuadraticForm R M) :
    Algebra.adjoin R (Set.range (ι Q)) = ⊤ :=
  CliffordAlgebra.adjoin_range_ι

/-! ## 5. Historical low-dimensional identifications -/

/-- **Argand / Wessel.** The complex numbers are `Cl₀,₁(ℝ)`. -/
theorem complex_iso_clifford :
    Nonempty (CliffordAlgebra CliffordAlgebraComplex.Q ≃ₐ[ℝ] ℂ) :=
  ⟨CliffordAlgebraComplex.equiv⟩

/-- **Hamilton, 1843.** The quaternions are `Cl₀,₂(ℝ)` (the quadratic form with
`c₁ = c₂ = -1`). -/
theorem quaternion_iso_clifford :
    Nonempty (CliffordAlgebra (CliffordAlgebraQuaternion.Q (-1 : ℝ) (-1)) ≃ₐ[ℝ] ℍ[ℝ]) :=
  ⟨CliffordAlgebraQuaternion.equiv⟩

end CliffordBott