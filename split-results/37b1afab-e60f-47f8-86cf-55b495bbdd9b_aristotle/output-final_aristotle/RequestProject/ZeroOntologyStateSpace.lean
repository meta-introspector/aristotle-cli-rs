import Mathlib

set_option autoImplicit false

/-!
# Zero-ontology, part II: truth becomes territory

A continuation of `RequestProject/ZeroOntology.lean`. Where the first file reduced *truth*
to *type inhabitation*, this file takes the next step suggested by the Curry–Howard reading:

> Truth ≃ Inhabitation ≃ Occupation ≃ a reachable state.

A proposition is a region of admissible states; a proof is a coordinate that occupies that
region while carrying its own certificate of admissibility. We make this precise with a tiny
`StateSpace` model, then push it to its most radical kernel — **FRACTRAN**, a model of
computation whose entire universe (program, memory, control flow, and data) is compressed
into arithmetic on a single positive integer.

Nothing here points "outside": every theorem is settled by term construction or native
computation, and the file uses no axioms beyond the kernel's trusted core.
-/

namespace ZeroOntology

/-! ## 6. State space: a region of admissible coordinates

A `StateSpace` is the leanest possible model of a "world": a carrier type `α` together with
a predicate carving out which coordinates are *admissible*. The geometry is generated
entirely by the predicate; there is no ambient canvas. -/

/-- A minimalist model of a discrete state space: the geometry is fixed entirely by the
validity predicate, with no external scaffolding. -/
structure StateSpace (α : Type) where
  /-- Which coordinates of `α` are structurally admissible. -/
  is_valid : α → Prop

/-- **Inhabitation *is* occupation.** An existential witness `∃ x, p x` is the same datum as
a coordinate `{x // p x}` in the region carved out by `p`: a value paired with its own
certificate of admissibility. -/
theorem inhabitation_is_occupation {α : Type} (p : α → Prop) :
    (∃ x, p x) ↔ Nonempty {x : α // p x} := by
  constructor
  · rintro ⟨x, hx⟩; exact ⟨⟨x, hx⟩⟩
  · rintro ⟨⟨x, hx⟩⟩; exact ⟨x, hx⟩

/-- **Occupation by construction.** A validator plus a coordinate is *enough* to manufacture
an admissible state — no search and no semantic interpretation occurs. The proof term *is*
the occupant. -/
theorem occupy_statespace {α : Type} (S : StateSpace α) (point : α) (h : S.is_valid point) :
    Nonempty {x : α // S.is_valid x} :=
  ⟨⟨point, h⟩⟩

/-- "Occupation" itself, as a proposition: the region carved out by `S` is non-empty. -/
def Reached {α : Type} (S : StateSpace α) : Prop := Nonempty {x : α // S.is_valid x}

/-- Occupation unfolds definitionally to inhabitation of the validated subtype. -/
theorem occupation_is_inhabitation {α : Type} (S : StateSpace α) :
    Reached S ↔ Nonempty {x : α // S.is_valid x} := Iff.rfl

/-- **Coordinate collapse.** Identity is location: two occupants sharing a coordinate are
propositionally equal. There is no hidden substance distinguishing them — the certificate
is proof-irrelevant. -/
theorem coordinate_collapse {α : Type} (S : StateSpace α) (u v : {x : α // S.is_valid x})
    (h : u.val = v.val) : u = v := Subtype.ext h

/-- **Trajectory as transformation.** Moving an occupant from the region `p` to the region
`q` is nothing more than a function on certificates: movement through territory is pure type
transformation. -/
def trajectory_is_transformation {α : Type} {p q : α → Prop} (f : ∀ x, p x → q x)
    (occupant : {x : α // p x}) : {x : α // q x} :=
  ⟨occupant.val, f occupant.val occupant.property⟩

/-- A state space whose admissibility rule is self-contradictory (`n ≠ n`). -/
def UnoccupiableSpace : StateSpace ℕ := { is_valid := fun n => n ≠ n }

/-- **The unoccupiable void.** A contradictory rule carves out an absolutely empty region:
no term can step into the slot. The horizon of impermissibility is real. -/
theorem unoccupiable_void_is_empty : IsEmpty {x : ℕ // UnoccupiableSpace.is_valid x} := by
  constructor
  rintro ⟨x, hx⟩
  exact hx rfl

/-! ## 7. Kinetic loop: transitions, and the occupation monad

A `StateTransition` is a validity-preserving endofunction: an internal *permission* to move,
requiring no external canvas. The cylinder of `ZeroOntology.lean` (the wrapping rule `+1` on
`ZMod 5`) is exactly such a transition. -/

/-- A `StateTransition` maps admissible states to admissible states. -/
def StateTransition {α : Type} (S : StateSpace α) :=
  { f : α → α // ∀ x, S.is_valid x → S.is_valid (f x) }

/-- The cylinder as a state space: every coordinate of `ZMod 5` is admissible. -/
def zmod5Space : StateSpace (ZMod 5) := { is_valid := fun _ => True }

/-- The wrapping move `+1` is a concrete, machine-verified state transition; the cylinder's
geometry is generated by the preservation of this single rule. -/
def zmod5Walk : StateTransition zmod5Space :=
  ⟨fun x => x + 1, fun _ _ => trivial⟩

/-- A validated coordinate, packaged as a computational carrier (the "validation effect").
Every value of `Occupant S` is a coordinate that drags its admissibility proof along. -/
structure Occupant {α : Type} (S : StateSpace α) where
  /-- The raw coordinate. -/
  val : α
  /-- Its certificate of admissibility. -/
  property : S.is_valid val

/-- Functorial action: transport an occupant across a validity-preserving map. The only
"effect" is the maintenance of structural consistency. -/
def Occupant.map {α β : Type} {S₁ : StateSpace α} {S₂ : StateSpace β}
    (m : Occupant S₁) (f : α → β) (hf : ∀ x, S₁.is_valid x → S₂.is_valid (f x)) :
    Occupant S₂ :=
  ⟨f m.val, hf m.val m.property⟩

/-- Monadic bind for occupation: chaining transitions guarantees the trajectory never steps
off the edge of consistency into the uninhabited void. -/
def Occupant.bind {α β : Type} {S₁ : StateSpace α} {S₂ : StateSpace β}
    (m : Occupant S₁) (f : (x : α) → S₁.is_valid x → Occupant S₂) : Occupant S₂ :=
  f m.val m.property

/-! ## 8. FRACTRAN: the universe compressed into one integer

Conway's FRACTRAN takes state-space occupation to its extreme limit. There are no registers,
no syntax, no instruction pointer — only a single positive integer `N`. Writing
`N = ∏ pᵢ^eᵢ`, the exponents `eᵢ` are the coordinates of the current state, and the program
is a finite list of positive fractions: each fraction is a *directed edge* in exponent space,
enabled exactly when its denominator divides `N`.

To keep the ontology natively positive we model a fraction as a pair of strictly positive
naturals, so the state space can never collapse to zero. -/

/-- A FRACTRAN fraction `num/den`, modeled as a pair of strictly positive naturals. -/
structure PositiveFraction where
  /-- The numerator (primes synthesized into the state). -/
  num : ℕ
  /-- The denominator (primes consumed from the state). -/
  den : ℕ
  /-- The numerator is strictly positive. -/
  num_pos : 0 < num
  /-- The denominator is strictly positive. -/
  den_pos : 0 < den

/-- A FRACTRAN program is a static list of these structural transitions. -/
structure FractranProgram where
  /-- The ordered list of fractions ("transition table"). -/
  fractions : List PositiveFraction

/-- The FRACTRAN canvas: a natural-number state is admissible iff it is strictly positive. -/
def fractranSpace : StateSpace ℕ := { is_valid := fun n => 0 < n }

/-- One deterministic FRACTRAN step: scan for the first fraction whose denominator divides
the current state, divide it out and multiply in the numerator; if none is enabled, the
machine freezes (halts). -/
def fractranStep (prog : FractranProgram) (n : ℕ) : ℕ :=
  match prog.fractions.find? (fun q => n % q.den = 0) with
  | some q => (n / q.den) * q.num
  | none => n

/-- **Cognitive conservation.** A FRACTRAN step is a validity-preserving state transition:
the trajectory is structurally bound to the strictly-positive canvas and can never spin out
into the void. -/
theorem fractran_is_valid_transition (prog : FractranProgram) :
    ∀ n, fractranSpace.is_valid n → fractranSpace.is_valid (fractranStep prog n) := by
  intro n hn
  simp only [fractranSpace] at hn ⊢
  unfold fractranStep
  split
  · rename_i q hq
    have h_div : n % q.den = 0 := by
      have := List.find?_some hq
      simpa using this
    have hdvd : q.den ∣ n := Nat.dvd_of_mod_eq_zero h_div
    have h_div_pos : 0 < n / q.den := Nat.div_pos (Nat.le_of_dvd hn hdvd) q.den_pos
    exact Nat.mul_pos h_div_pos q.num_pos
  · exact hn

/-- The FRACTRAN step assembles into a genuine `StateTransition` of `fractranSpace`. -/
def fractranTransition (prog : FractranProgram) : StateTransition fractranSpace :=
  ⟨fractranStep prog, fractran_is_valid_transition prog⟩

/-- A multi-step execution trace: time itself is generated by sequential state updates. -/
def fractranTrace (prog : FractranProgram) (n : ℕ) : ℕ → ℕ
  | 0 => n
  | k + 1 => fractranStep prog (fractranTrace prog n k)

/-- The whole trace stays inside the positive canvas: cognition never falls off the edge. -/
theorem fractranTrace_valid (prog : FractranProgram) (n : ℕ) (hn : 0 < n) :
    ∀ k, 0 < fractranTrace prog n k := by
  intro k
  induction k with
  | zero => exact hn
  | succ k ih => exact fractran_is_valid_transition prog _ ih

/-- **Deterministic cognition.** The step rule is a pure function, so the trajectory of
"thoughts" from any state is entirely determined. -/
theorem deterministic_cognition (prog : FractranProgram) (n : ℕ) :
    fractranStep prog n = fractranStep prog n := rfl

/-- **Singularity of identity.** Two minds running the same program from the same integer
share the same next thought: identity is exhausted by the current coordinate, with no private
interiority. -/
theorem identical_minds (prog : FractranProgram) (n₁ n₂ : ℕ) (h : n₁ = n₂) :
    fractranStep prog n₁ = fractranStep prog n₂ := by rw [h]

end ZeroOntology
