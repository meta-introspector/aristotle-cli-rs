/-! ## Verification theorems -/

/-- Each exponent vector has exactly 15 entries (one per prime). -/
theorem monsterIrrepExponents_widths :
    ∀ exps ∈ monsterIrrepExponents, exps.length = 15 := by native_decide

/-- There are 194 exponent vectors, matching the number of irreps. -/
theorem monsterIrrepExponents_length :
    monsterIrrepExponents.length = 194 := by native_decide

/-- The prime factorization exponents correctly produce the irrep dimensions.
    That is, for each i, applying `dimFromExponents` to the i-th exponent vector
    yields the i-th entry of `monsterIrrepDims`. -/
theorem monsterIrrepExponents_correct :
    monsterIrrepExponents.map dimFromExponents = monsterIrrepDims := by native_decide

/-- The Ω values are consistent with the exponent vectors. -/
theorem monsterIrrepOmega_correct :
    monsterIrrepOmega = monsterIrrepExponents.map List.sum := by native_decide

/-- There are 194 Ω values. -/
theorem monsterIrrepOmega_length :
    monsterIrrepOmega.length = 194 := by native_decide
