/-
# Monster Group Order and Modular Lattice in Lean 4

This module formalizes the divisor-lattice-box structure associated with the Monster group order.

For each divisor d | n, the additive subgroup d·(ℤ/nℤ) = AddSubgroup.zmultiples (d : ZMod n)
forms a sublattice of ℤ/nℤ. These subgroups are indexed by the divisor poset: if d₁ | d₂,
then the subgroup for d₂ is contained in the subgroup for d₁, giving an order-reversing
(contravariant) map from divisors to subgroups.

Key results:
- `subgroupBox`: construction of the canonical subgroup for each divisor
- `subgroupBox_antitone`: divisibility implies reverse inclusion of subgroups
- `subgroupBox_chain_antitone`: divisor chains map to reverse subgroup chains
-/

import Mathlib

open ZMod

/-! ## Monster group order -/

/-- The order of the Monster group (exact value). -/
def MonsterOrder : ℕ :=
  808017424794512875886459904961710757005754368000000000

/-! ## Subgroup boxes indexed by divisors -/

/-- For a divisor `d` of `n`, the "box" is the additive subgroup of `ZMod n`
    generated by `d`, i.e., `{d·k mod n : k ∈ ℤ}`. When `d ∣ n`, this subgroup
    has order `n/d`. -/
def subgroupBox (n : ℕ) (d : ℕ) : AddSubgroup (ZMod n) :=
  AddSubgroup.zmultiples (d : ZMod n)

/-
Divisibility of generators implies reverse inclusion of subgroup boxes.
    If `d₁ | d₂` then `d₂·(ℤ/nℤ) ⊆ d₁·(ℤ/nℤ)`, because `d₂` is a multiple of `d₁`.
-/
theorem subgroupBox_antitone (n : ℕ) (d₁ d₂ : ℕ) (h : d₁ ∣ d₂) :
    subgroupBox n d₂ ≤ subgroupBox n d₁ := by
  obtain ⟨ k, hk ⟩ := h;
  simp +decide [ hk, subgroupBox, AddSubgroup.zmultiples_le ];
  exact ⟨ k, by simp +decide [ mul_comm ] ⟩

/-
A chain of divisors `d₁ | d₂ | ⋯ | dₖ` maps to a reverse chain of subgroups:
    `subgroupBox n dₖ ≤ ⋯ ≤ subgroupBox n d₁`.
    This is the correct "boxes partition the lattice" statement — the boxes are **nested**,
    not disjoint.
-/
theorem subgroupBox_chain_antitone (n : ℕ) (ds : List ℕ) (hchain : ds.IsChain (· ∣ ·)) :
    (ds.map (subgroupBox n)).IsChain (· ≥ ·) := by
  rw [ List.isChain_iff_pairwise ] at *;
  rw [ List.pairwise_map ];
  exact hchain.imp fun h => subgroupBox_antitone n _ _ h

