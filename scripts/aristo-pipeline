#!/usr/bin/env bash
# scripts/aristo-pipeline — generic idempotent Aristotle Harmonic pipeline
# (prep → ask → receive), portable version of the tracker's
# scripts/aristo-pipeline.sh. No repo-specific dependencies.
#
# Backend: the Rust CLI aristotle-manager (${ARISTO_MANAGER}) — NO curl, NO
# python in this script; every network call goes through the tool, which
# resolves API keys from its own account config:
#   check <project> --account A           -> project status (2 = IDLE)
#   ask <project> <prompt> --account A --attach [--file F]...
#       attachment mode: prompt file + text files (auto-batches of 5, waits
#       IDLE between batches); binaries cannot ride on ask
#   download-result <project> --account A --output-dir D
#
# Phases (all idempotent, state keyed by git HEAD when in a git repo):
#   P1 backend executable + live auth probe per account (check)
#   P2 git tree clean (git repos only; skipped otherwise)
#   P3 optional pre-submit test command (ARISTO_PREP_TEST_CMD)
#   P4 artifacts: prompt file + optional git bundle (record/push artifact)
#   A  submit to every account in ARISTO_ACCOUNTS, in PARALLEL; each job polls
#      `check` until its project is IDLE (status 2), then runs `ask --attach`.
#      A busy account never blocks the others; response recorded in state.
#   R  poll until the project returns to IDLE (task done), then
#      `download-result` + extract; ARISTO_INTEGRATE_CMD hook optional
#
# Configuration (env):
#   ARISTO_ACCOUNTS      comma list            (default "main,twitterstorm")
#   ARISTO_PROJECTS      "acct=uuid,acct=uuid" (defaults to the two known projects)
#   ARISTO_MANAGER       aristotle-manager binary (release -> debug -> cargo run)
#   ARISTO_WORK_DIR      outputs + state       (default /tmp/aristo-pipeline)
#   ARISTO_PREP_TEST_CMD optional shell command run in P3
#   ARISTO_INTEGRATE_CMD optional shell command run after receive (gets result dir as $1)
#   ARISTO_BUNDLE        "off" disables git bundle creation (default on, git repos)
#   ARISTO_IDLE_TIMEOUT  seconds waiting for IDLE   (default 2400)
#   ARISTO_TASK_TIMEOUT  seconds waiting for task completion (default 14400)
#
# Usage:
#   scripts/aristo-pipeline --prompt FILE [options]
#   options: --bundle F --file F --account a,b --fresh --skip-tests
#            --integrate --dry-run --status --receive-only
#
# Examples:
#   ARISTO_WORK_DIR=/tmp/r1 scripts/aristo-pipeline --prompt ask.txt --dry-run
#   ARISTO_ACCOUNTS=main ARISTO_WORK_DIR=/tmp/r1 scripts/aristo-pipeline --prompt ask.txt
set -euo pipefail

# backend selection mirrors scripts/submit-to-aristotle.sh convention
if [[ -n "${ARISTO_MANAGER:-}" ]]; then
  AM="$ARISTO_MANAGER"
elif [[ -x /home/mdupont/projects/arist/target/release/aristotle-manager ]]; then
  AM=/home/mdupont/projects/arist/target/release/aristotle-manager
elif [[ -x /home/mdupont/projects/arist/target/debug/aristotle-manager ]]; then
  AM=/home/mdupont/projects/arist/target/debug/aristotle-manager
else
  AM="cargo --manifest-path /home/mdupont/projects/arist/Cargo.toml run --release --"
fi
WORK_DIR="${ARISTO_WORK_DIR:-/tmp/aristo-pipeline}"
STATE_DIR="$WORK_DIR/state"
IDLE_TIMEOUT="${ARISTO_IDLE_TIMEOUT:-2400}"
TASK_TIMEOUT="${ARISTO_TASK_TIMEOUT:-14400}"
POLL_IDLE=15
POLL_TASK=60

PROMPT_FILE="" BUNDLE="" ACCOUNTS_OPT="" FRESH=0 SKIP_TESTS=0
INTEGRATE=0 DRY_RUN=0 STATUS_ONLY=0 RECEIVE_ONLY=0
EXTRA_FILES=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --prompt)       PROMPT_FILE="$2"; shift 2 ;;
    --bundle)       BUNDLE="$2"; shift 2 ;;
    --file)         EXTRA_FILES+=("$2"); shift 2 ;;
    --account)      ACCOUNTS_OPT="$2"; shift 2 ;;
    --fresh)        FRESH=1; shift ;;
    --skip-tests)   SKIP_TESTS=1; shift ;;
    --integrate)    INTEGRATE=1; shift ;;
    --dry-run)      DRY_RUN=1; shift ;;
    --status)       STATUS_ONLY=1; shift ;;
    --receive-only) RECEIVE_ONLY=1; shift ;;
    -h|--help)      grep '^#' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 1 ;;
  esac
done

STAMP() { date -u +%Y-%m-%dT%H:%M:%SZ; }
log()   { echo "[$(STAMP)] $*"; }
die()   { echo "[$(STAMP)] ERROR: $*" >&2; exit 1; }

# ------------------------------------------------------------- accounts ----
declare -A PROJECTS=()
if [[ -n "${ARISTO_PROJECTS:-}" ]]; then
  IFS=',' read -ra _pairs <<< "$ARISTO_PROJECTS"
  for p in "${_pairs[@]}"; do
    [[ "$p" == *=* ]] || die "ARISTO_PROJECTS entry '$p' must be acct=uuid"
    PROJECTS["${p%%=*}"]="${p#*=}"
  done
else
  PROJECTS[main]="10671d9f-c85c-4dc2-a84e-f7d6f7e168d5"
  PROJECTS[twitterstorm]="3a8443b1-0e97-4fd4-ada9-b2b02e0335a4"
fi

ACCOUNTS=()
if [[ -n "$ACCOUNTS_OPT" ]]; then
  IFS=',' read -ra ACCOUNTS <<< "$ACCOUNTS_OPT"
elif [[ -n "${ARISTO_ACCOUNTS:-}" ]]; then
  IFS=',' read -ra ACCOUNTS <<< "$ARISTO_ACCOUNTS"
else
  ACCOUNTS=(main twitterstorm)
fi
for a in "${ACCOUNTS[@]}"; do
  [[ -n "${PROJECTS[$a]:-}" ]] || die "no project id configured for account '$a' (set ARISTO_PROJECTS)"
done

# ------------------------------------------------------------------ git ----
IN_GIT=0; HEAD_SHA=""; HEAD8="nogit"
if git rev-parse --show-toplevel >/dev/null 2>&1; then
  IN_GIT=1
  HEAD_SHA=$(git rev-parse HEAD)
  HEAD8="${HEAD_SHA:0:8}"
fi

# ----------------------------------------------------------------- state ----
mkdir -p "$STATE_DIR"
STATE_FILE="$STATE_DIR/state-$HEAD8.env"
state_get() { grep -E "^$1=" "$STATE_FILE" 2>/dev/null | tail -1 | cut -d= -f2- ; }
state_set() {
  touch "$STATE_FILE"
  grep -vE "^$1=" "$STATE_FILE" > "$STATE_FILE.tmp" 2>/dev/null || true
  echo "$1=$2" >> "$STATE_FILE.tmp"
  mv "$STATE_FILE.tmp" "$STATE_FILE"
}

sk_for() {  # account -> state key (upper, non-alnum -> _)
  echo "$1" | tr '[:lower:]-.' '[:upper:]__'
}

if (( STATUS_ONLY )); then
  echo "== aristo-pipeline (generic) =="
  echo "backend: $AM ($([[ -x $AM || $AM == cargo* ]] && echo ok || echo MISSING))"
  echo "work:   $WORK_DIR"
  echo "git:    $([[ $IN_GIT == 1 ]] && echo "$HEAD_SHA ($HEAD8)" || echo 'not a git repo')"
  echo "state:  $STATE_FILE"
  [[ -f "$STATE_FILE" ]] && cat "$STATE_FILE" || echo "(no state yet)"
  exit 0
fi

# ---------------------------------------------------------- backend calls ----
# The ONLY network operations — all delegated to aristotle-manager, which
# resolves API keys from its own account configuration.
am() { $AM "$@"; }   # unquoted: supports the `cargo run --` fallback form
proj_status() { # acct project -> "N" (0 q / 1 run / 2 idle) or ""
  am check "$2" --account "$1" 2>/dev/null | grep -m1 'Status:' | grep -oE '[0-9]+' || true
}
ask_attach() { # acct project [files...] -> files become --file F; prompt file via global PROMPT_FILE
  local a="$1" p="$2"; shift 2
  local args=( ask "$p" "$PROMPT_FILE" --account "$a" --attach )
  local f
  for f in "$@"; do [[ -n "$f" ]] && args+=( --file "$f" ); done
  am "${args[@]}"
}
download_result() { # acct project outdir
  am download-result "$2" --account "$1" --output-dir "$3"
}

# ------------------------------------------------------------------ prep ----
log "=== P0 preflight: work=$WORK_DIR git=$HEAD8 accounts=[${ACCOUNTS[*]}]"
(( FRESH )) && rm -f "$STATE_FILE"

[[ -x "$AM" || "$AM" == cargo* ]] || die "P1 backend not executable: $AM"
for a in "${ACCOUNTS[@]}"; do
  st=$(proj_status "$a" "${PROJECTS[$a]}")
  [[ -n "$st" ]] || die "P1 backend probe failed for $a (auth/network?)"
  log "P1 $a reachable, project status=$st"
done

if (( IN_GIT == 1 )); then
  [[ -z "$(git status --porcelain | grep -v '^??')" ]] || die "P2 tracked changes dirty — commit or stash first (untracked files are tolerated)"
  log "P2 tree clean"
else
  log "P2 not a git repo — clean-tree gate skipped"
fi

if (( SKIP_TESTS )) || [[ -z "${ARISTO_PREP_TEST_CMD:-}" ]]; then
  log "P3 pre-submit test command: skipped"
elif [[ "$(state_get TESTS_OK || true)" == "1" ]]; then
  log "P3 pre-submit test command: cached green (skip)"
else
  log "P3 running: $ARISTO_PREP_TEST_CMD"
  (( DRY_RUN )) || bash -c "$ARISTO_PREP_TEST_CMD" > "$STATE_DIR/prep-tests-$HEAD8.log" 2>&1 \
    || { tail -20 "$STATE_DIR/prep-tests-$HEAD8.log" >&2; die "P3 test command failed"; }
  (( DRY_RUN )) || state_set TESTS_OK 1
  log "P3 test command green"
fi

[[ -n "$PROMPT_FILE" ]] || die "P4 --prompt FILE required"
[[ -f "$PROMPT_FILE" ]] || die "P4 prompt file missing: $PROMPT_FILE"
PROMPT_SHA=$(sha256sum "$PROMPT_FILE" | cut -c1-16)

if [[ -z "$BUNDLE" && $IN_GIT == 1 && -n "${ARISTO_BUNDLE:-on}" ]]; then
  BUNDLE="$WORK_DIR/repo-$HEAD8.bundle"
  [[ -f "$BUNDLE" ]] || { log "P4 creating git bundle from HEAD"; (( DRY_RUN )) || git bundle create "$BUNDLE" --all; }
fi
if [[ -n "$BUNDLE" ]]; then
  [[ -f "$BUNDLE" ]] || (( DRY_RUN )) || die "P4 bundle missing: $BUNDLE"
  log "P4 bundle: $BUNDLE"
fi
log "P4 prompt sha $PROMPT_SHA"

if (( DRY_RUN )); then
  log "DRY-RUN: would submit to [${ACCOUNTS[*]}] (parallel, independent IDLE waits)"
  for a in "${ACCOUNTS[@]}"; do
    log "DRY-RUN:   $a -> project ${PROJECTS[$a]}"
  done
  log "DRY-RUN: then receive results into $WORK_DIR"
  exit 0
fi

# ------------------------------------------------------------------- ask ----
# One submit job per account, run in PARALLEL: poll `check` until that project
# is IDLE, then `ask --attach`. Busy account blocks only itself.

submit_account() {
  local a="$1" project="$2" sk; sk=$(sk_for "$a")
  local have_task have_head have_prompt
  have_task=$(state_get "${sk}_TASK" || true)
  have_head=$(state_get "${sk}_HEAD" || true)
  have_prompt=$(state_get "${sk}_PROMPT_SHA" || true)
  if [[ -n "$have_task" && "$have_head" == "$HEAD8" && "$have_prompt" == "$PROMPT_SHA" ]]; then
    log "A[$a] already submitted for $HEAD8/prompt-$PROMPT_SHA: task $have_task (skip)"
    return 0
  fi

  # A1 wait for IDLE (status 2) via `check`
  local st waited=0
  while :; do
    st=$(proj_status "$a" "$project")
    [[ "$st" == "2" ]] && break
    (( waited >= IDLE_TIMEOUT )) && { log "A[$a] not IDLE after ${IDLE_TIMEOUT}s (status=${st:-?})"; return 1; }
    (( waited % (POLL_IDLE*4) == 0 )) && log "A[$a] status=${st:-?} waiting for IDLE (${waited}s/${IDLE_TIMEOUT}s)"
    sleep "$POLL_IDLE"; waited=$((waited + POLL_IDLE))
  done
  log "A[$a] project IDLE — asking with attachments"

  # A2 ask --attach (prompt file + text attachments; tool auto-batches >5,
  #    waiting for IDLE between batches; binaries cannot ride on ask)
  local alog="$WORK_DIR/ask-$a-$HEAD8.log"
  if ! ask_attach "$a" "$project" "${EXTRA_FILES[@]:-}" > "$alog" 2>&1; then
    log "A[$a] ask FAILED — log: $alog"; tail -8 "$alog"; return 1
  fi

  # A3 record (response head; uuid extracted if the API returned one)
  local resp
  resp=$(grep -A3 'Aristotle' "$alog" | tail -1 | cut -c1-200)
  state_set "${sk}_TASK" "$(grep -oE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' "$alog" | tail -1 || echo "resp:$(date -u +%s)")"
  state_set "${sk}_HEAD" "$HEAD8"
  state_set "${sk}_PROMPT_SHA" "$PROMPT_SHA"
  state_set "${sk}_RESPONSE" "$resp"
  state_set "${sk}_SUBMITTED_AT" "$(STAMP)"
  log "A[$a] asked OK (log: $alog) — response head: $resp"
}

if (( ! RECEIVE_ONLY )); then
  pids=()
  for a in "${ACCOUNTS[@]}"; do
    submit_account "$a" "${PROJECTS[$a]}" & pids+=($!)
  done
  rc=0
  for p in "${pids[@]}"; do wait "$p" || rc=1; done
  (( rc )) && die "ask phase failed for at least one account (re-run to resume)"
fi

# -------------------------------------------------------------- receive ----
# The project returns to IDLE (status 2) when the current task is done —
# then `download-result` fetches the artifacts.
receive_account() {
  local a="$1" project="$2" sk tid st out rdir waited=0
  sk=$(sk_for "$a"); tid=$(state_get "${sk}_TASK" || true)
  [[ -n "$tid" ]] || { log "R[$a] no ask recorded — run ask phase first"; return 0; }
  [[ "$(state_get "${sk}_RECEIVED" || true)" == "1" ]] && { log "R[$a] already received: $(state_get "${sk}_RESULT_FILE")"; return 0; }

  while :; do
    st=$(proj_status "$a" "$project")
    if [[ "$st" == "2" ]]; then
      log "R[$a] project IDLE — downloading result"
      rdir="$WORK_DIR/results/$a-${tid:0:8}"
      download_result "$a" "$project" "$rdir" \
        || { log "R[$a] download-result failed — re-run to retry"; return 1; }
      state_set "${sk}_RECEIVED" "1"
      state_set "${sk}_RESULT_DIR" "$rdir"
      state_set "${sk}_RECEIVED_AT" "$(STAMP)"
      log "R[$a] result extracted: $rdir"
      if (( INTEGRATE )) && [[ -n "${ARISTO_INTEGRATE_CMD:-}" ]]; then
        log "R[$a] integrating: $ARISTO_INTEGRATE_CMD"
        bash -c "$ARISTO_INTEGRATE_CMD" "$rdir" || log "R[$a] integration needs manual attention"
      fi
      return 0
    elif [[ "$st" == "0" ]]; then
      log "R[$a] status=0 (queued/idle-no-work?) — re-probe"
      sleep "$POLL_TASK"; waited=$((waited + POLL_TASK))
    else
      (( waited >= TASK_TIMEOUT )) && { log "R[$a] timeout after ${TASK_TIMEOUT}s (status=${st:-?}) — re-run to resume"; return 1; }
      log "R[$a] status=${st:-?} (${waited}s/${TASK_TIMEOUT}s)"
      sleep "$POLL_TASK"; waited=$((waited + POLL_TASK))
    fi
  done
}

rrc=0
for a in "${ACCOUNTS[@]}"; do
  receive_account "$a" "${PROJECTS[$a]}" || rrc=1
done

log "=== pipeline done (git=$HEAD8, state: $STATE_FILE) ==="
exit $rrc


